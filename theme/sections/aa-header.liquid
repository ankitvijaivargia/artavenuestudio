{%- comment -%}
  Art Avenue — site header + mega menu (parts.jsx Header/MegaMenu)
  Nav from a Shopify menu (default 'main-menu'). Each top-level item with child
  links renders a mega-menu panel. Wordmark logo, search / account / cart icons.
{%- endcomment -%}
{%- assign menu = linklists[section.settings.menu] -%}
<header class="aa-header" data-aa-header>
  <div class="aa-header__bar">
    <nav class="aa-nav">
      {%- for link in menu.links -%}
        <div class="aa-nav__item" data-aa-nav-item>
          <a class="aa-nav__link" href="{{ link.url }}" {% if link.links.size > 0 %}aria-haspopup="true" aria-expanded="false" data-aa-nav-trigger{% endif %}>{{ link.title }}</a>
          {%- if link.links.size > 0 -%}
            <div class="aa-mega" data-aa-mega hidden>
              <div class="aa-mega__inner">
                {%- for child in link.links limit: 4 -%}
                  <div class="aa-mega__col">
                    <h4>{{ child.title }}</h4>
                    <ul>
                      {%- if child.links.size > 0 -%}
                        {%- for g in child.links -%}<li><a href="{{ g.url }}">{{ g.title }}</a></li>{%- endfor -%}
                      {%- else -%}
                        <li><a href="{{ child.url }}">Shop {{ child.title }}</a></li>
                      {%- endif -%}
                    </ul>
                  </div>
                {%- endfor -%}
                <a class="aa-mega__feature aa-fig aa-fig--espresso" href="{{ link.url }}">
                  <span class="aa-eyebrow">{{ section.settings.feature_eyebrow | default: 'Featured' }}</span>
                  <h3>{{ link.title }}</h3>
                </a>
              </div>
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </nav>

    <a class="aa-header__brand" href="{{ routes.root_url }}">
      {%- if section.settings.logo != blank -%}
        <img src="{{ section.settings.logo | image_url: width: 320 }}" alt="{{ shop.name }}" width="160" height="30">
      {%- else -%}
        <img src="{{ 'aa-logo-wordmark.svg' | asset_url }}" alt="{{ shop.name }}" width="130" height="30">
      {%- endif -%}
    </a>

    <div class="aa-header__actions">
      <a class="aa-header__icon" href="{{ routes.search_url }}" aria-label="Search"><i class="ph ph-magnifying-glass" style="font-size:20px"></i></a>
      <a class="aa-header__icon" href="{{ routes.account_url }}" aria-label="Account"><i class="ph ph-user" style="font-size:20px"></i></a>
      <a class="aa-header__icon" href="{{ routes.cart_url }}" aria-label="Cart">
        <i class="ph ph-shopping-bag" style="font-size:20px"></i>
        {%- if cart.item_count > 0 -%}<span class="aa-badge aa-badge--solid" style="margin-left:4px;padding:2px 7px">{{ cart.item_count }}</span>{%- endif -%}
      </a>
    </div>
  </div>
</header>
<script>
  (function () {
    var header = document.querySelector('[data-aa-header]');
    if (!header) return;
    header.querySelectorAll('[data-aa-nav-item]').forEach(function (item) {
      var mega = item.querySelector('[data-aa-mega]');
      var trig = item.querySelector('[data-aa-nav-trigger]');
      if (!mega) return;
      var show = function () { mega.hidden = false; if (trig) trig.setAttribute('aria-expanded', 'true'); };
      var hide = function () { mega.hidden = true; if (trig) trig.setAttribute('aria-expanded', 'false'); };
      item.addEventListener('mouseenter', show);
      item.addEventListener('mouseleave', hide);
    });
  })();
</script>
{% schema %}
{
  "name": "AA Header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo (optional — defaults to wordmark)" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "text", "id": "feature_eyebrow", "label": "Mega-menu feature eyebrow", "default": "Featured" }
  ]
}
{% endschema %}
