{%- comment -%}
  Art Avenue — sections/aa-collection-grid.liquid
  Product cards carry the commerce badge (aa.commerce_badge / collection force_badge)
  so shoppers see In Stock · Made to Order · Customizable · Made for Projects
  without entering the PDP. Sort + filter toolbar.
{%- endcomment -%}
{%- assign force_badge = collection.metafields.ava.force_badge.value -%}
<div class="aa-container aa-section--tight">
  <header class="aa-collection__head">
    <p class="aa-eyebrow">{{ collection.metafields.ava.collection_type.value | default: 'Collection' | capitalize }}</p>
    <h1 class="aa-h1">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}<div class="aa-lead aa-measure rte">{{ collection.description }}</div>{%- endif -%}
  </header>

  <div class="aa-collection__toolbar">
    <span class="aa-muted">{{ collection.products_count }} {{ collection.products_count | pluralize: 'piece', 'pieces' }}</span>
    <form method="get" class="aa-sort">
      <label class="aa-muted" for="aa-sort-by">Sort</label>
      <select name="sort_by" id="aa-sort-by" onchange="this.form.submit()">
        {%- assign current = collection.sort_by | default: collection.default_sort_by -%}
        {%- for option in collection.sort_options -%}
          <option value="{{ option.value }}" {% if option.value == current %}selected{% endif %}>{{ option.name }}</option>
        {%- endfor -%}
      </select>
    </form>
  </div>

  {%- if collection.filters.size > 0 -%}
    <details class="aa-filters">
      <summary class="aa-link-underline">Filter</summary>
      <form method="get" class="aa-filters__form">
        {%- for filter in collection.filters -%}
          <div class="aa-filters__group">
            <h4>{{ filter.label }}</h4>
            {%- for value in filter.values -%}
              <label class="aa-filters__opt">
                <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} onchange="this.form.submit()">
                <span>{{ value.label }} ({{ value.count }})</span>
              </label>
            {%- endfor -%}
          </div>
        {%- endfor -%}
      </form>
    </details>
  {%- endif -%}

  {%- paginate collection.products by 24 -%}
    <div class="aa-tiles aa-tiles--4 aa-collection__grid">
      {%- for product in collection.products -%}
        {%- render 'aa-product-card', product: product, force_badge: force_badge -%}
      {%- else -%}
        <p class="aa-body aa-muted">No pieces here yet. Speak with a consultant about what you're looking for.</p>
      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      <nav class="aa-pagination">
        {%- if paginate.previous -%}<a class="aa-link-underline" href="{{ paginate.previous.url }}">Previous</a>{%- endif -%}
        <span class="aa-muted">Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
        {%- if paginate.next -%}<a class="aa-link-underline" href="{{ paginate.next.url }}">Next</a>{%- endif -%}
      </nav>
    {%- endif -%}
  {%- endpaginate -%}
</div>
{% schema %}
{
  "name": "AA Collection Grid",
  "settings": [
    { "type": "range", "id": "per_row", "min": 2, "max": 4, "step": 1, "label": "Cards per row (desktop)", "default": 4 }
  ]
}
{% endschema %}
