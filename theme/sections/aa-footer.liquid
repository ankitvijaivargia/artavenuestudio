{%- comment -%} Art Avenue — footer (parts.jsx Footer). Dark, editorial, newsletter. {%- endcomment -%}
<footer class="aa-footer">
  <div class="aa-footer__inner">
    <div class="aa-footer__grid">
      <div class="aa-footer__brand">
        <img src="{{ 'aa-logo-wordmark.svg' | asset_url }}" alt="{{ shop.name }}" width="143" height="34">
        <p class="aa-footer__tagline">{{ section.settings.tagline | default: 'A design house for considered living — handcrafted furniture, rugs and objects, made in India.' }}</p>
        {%- if section.settings.show_newsletter -%}
          {%- form 'customer' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="aa-newsletter">
              <input type="email" name="contact[email]" placeholder="Email for the journal" required>
              <button type="submit" class="aa-btn aa-btn--on-dark">Join</button>
            </div>
            {%- if form.posted_successfully? -%}<p class="aa-footer__tagline">Thank you — welcome to Art Avenue.</p>{%- endif -%}
          {%- endform -%}
        {%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'menu' -%}
          {%- assign m = linklists[block.settings.menu] -%}
          <div {{ block.shopify_attributes }}>
            <h4>{{ block.settings.heading | default: m.title }}</h4>
            <ul>
              {%- for link in m.links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="aa-footer__bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</span>
      <span>{{ section.settings.legal | default: 'Crafted with care.' }}</span>
    </div>
  </div>
</footer>
{% schema %}
{
  "name": "AA Footer",
  "settings": [
    { "type": "textarea", "id": "tagline", "label": "Brand tagline" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show newsletter signup", "default": true },
    { "type": "text", "id": "legal", "label": "Legal line" }
  ],
  "blocks": [
    { "type": "menu", "name": "Menu column", "settings": [
      { "type": "text", "id": "heading", "label": "Heading" },
      { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
    ]}
  ],
  "presets": [{ "name": "AA Footer", "blocks": [
    { "type": "menu", "settings": { "heading": "Shop" } },
    { "type": "menu", "settings": { "heading": "Discover" } },
    { "type": "menu", "settings": { "heading": "Trade" } },
    { "type": "menu", "settings": { "heading": "Help" } }
  ]}]
}
{% endschema %}
