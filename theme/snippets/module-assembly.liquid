{%- comment -%} Art Avenue — Assembly / installation {%- endcomment -%}
<section class="module module--assembly">
  <p class="aa-eyebrow module__eyebrow">Delivery & assembly</p>
  <h2 class="aa-h2">White-glove from door to room</h2>
  <div class="aa-tiles aa-tiles--3" style="margin-top:var(--space-lg)">
    <div><i class="ph ph-package" style="font-size:26px;color:var(--accent)"></i><h3 class="aa-h4" style="margin:.5rem 0">Considered packing</h3><p class="aa-body aa-muted">Protected in transit, minimal waste.</p></div>
    <div><i class="ph ph-truck" style="font-size:26px;color:var(--accent)"></i><h3 class="aa-h4" style="margin:.5rem 0">Room of choice</h3><p class="aa-body aa-muted">Delivered, placed and unpacked for you.</p></div>
    <div><i class="ph ph-wrench" style="font-size:26px;color:var(--accent)"></i><h3 class="aa-h4" style="margin:.5rem 0">Assembled on site</h3><p class="aa-body aa-muted">Set up and finished, packaging taken away.</p></div>
  </div>
</section>
