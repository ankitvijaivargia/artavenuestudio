{%- comment -%}
  Art Avenue — snippets/aa-lead-form.liquid  (the unified lead payload)
  Every CTA origin (consult / pricing / samples / custom / project / notify) posts
  the SAME payload to Shopify's native /contact endpoint. Shopify Flow then routes
  by contact[lead_type] to the right CRM queue (see scripts + README §Flow).

  Payload (mirrors BLUEPRINT §7):
    { lead_type, product, sku, page_url, name, email, phone, body }

  Pre-fills lead_type / product / sku / a friendly heading from the query string
  produced by snippets/aa-lead-url.liquid.

  Optional params when rendered inline on a PDP:
    product (object), default_type (string)
{%- endcomment -%}
{%- liquid
  assign default_type = default_type | default: 'consultation'
  assign uid = 'aa-lead-' | append: section.id | default: 'aa-lead'
-%}
<div class="aa-leadform" data-aa-leadform>
  <p class="aa-eyebrow" data-aa-lead-eyebrow>Enquiry</p>
  <h2 class="aa-h2" data-aa-lead-heading>Speak with a design consultant</h2>
  <p class="aa-lead" data-aa-lead-sub>Tell us about your space and we'll be in touch within one business day.</p>

  {%- form 'contact', class: 'aa-lead', id: uid -%}
    {%- if form.posted_successfully? -%}
      <p class="aa-badge aa-badge--accent">Thank you — your enquiry has been received.</p>
    {%- endif -%}
    {%- if form.errors -%}
      <p class="aa-badge aa-badge--solid">{{ form.errors | default_errors }}</p>
    {%- endif -%}

    <input type="hidden" name="contact[lead_type]" value="{{ default_type }}" data-aa-lead-type>
    <input type="hidden" name="contact[product]"   value="{% if product %}{{ product.title }}{% endif %}" data-aa-lead-product>
    <input type="hidden" name="contact[sku]"        value="{% if product %}{{ product.selected_or_first_available_variant.sku }}{% endif %}" data-aa-lead-sku>
    <input type="hidden" name="contact[page_url]"   value="{{ canonical_url }}" data-aa-lead-url>

    <div class="aa-leadform__grid">
      <label class="aa-field">
        <span>Name</span>
        <input type="text" name="contact[name]" value="{% if customer %}{{ customer.name }}{% endif %}" required>
      </label>
      <label class="aa-field">
        <span>Email</span>
        <input type="email" name="contact[email]" value="{% if customer %}{{ customer.email }}{% endif %}" required>
      </label>
      <label class="aa-field">
        <span>Phone</span>
        <input type="tel" name="contact[phone]">
      </label>
      <label class="aa-field aa-field--full">
        <span>How can we help?</span>
        <textarea name="contact[body]" rows="4"></textarea>
      </label>
    </div>
    <button type="submit" class="aa-btn aa-btn--primary aa-btn--lg">Send enquiry</button>
  {%- endform -%}
</div>

<script>
  (function () {
    var root = document.querySelector('[data-aa-leadform]');
    if (!root) return;
    var params = new URLSearchParams(window.location.search);
    var type = params.get('type');
    var product = params.get('product');
    var sku = params.get('sku');
    var msg = params.get('msg');
    var HEAD = {
      consultation: ['Design Consultation', 'Speak with a design consultant', "Tell us about your space and we'll be in touch within one business day."],
      pricing:      ['Request Pricing', 'Request pricing', 'Share a few details and we will send pricing for this piece.'],
      samples:      ['Material Samples', 'Request a sample', 'Feel the material in your own light before you commit.'],
      custom:       ['Bespoke', 'Customize this piece', 'Tell us what you have in mind — dimensions, materials, finishes.'],
      project:      ['Trade & Projects', 'Start a project enquiry', 'Tell us about your project and timeline; our trade team will follow up.'],
      trade:        ['Trade Program', 'Apply to the trade program', 'Share your studio details to access trade pricing and services.']
    };
    function set(sel, val) { var el = root.querySelector(sel); if (el && val) el.value = val; }
    if (type) {
      set('[data-aa-lead-type]', type);
      var h = HEAD[type];
      if (h) {
        var eb = root.querySelector('[data-aa-lead-eyebrow]'); if (eb) eb.textContent = h[0];
        var hd = root.querySelector('[data-aa-lead-heading]'); if (hd) hd.textContent = h[1];
        var sb = root.querySelector('[data-aa-lead-sub]'); if (sb) sb.textContent = h[2];
      }
    }
    if (product) set('[data-aa-lead-product]', product);
    if (sku) set('[data-aa-lead-sku]', sku);
    if (msg) {
      var ta = root.querySelector('textarea[name="contact[body]"]');
      if (ta && !ta.value) ta.value = 'I would like to request: ' + msg;
    }
  })();
</script>
