{%- comment -%} Art Avenue — Complete the room {%- endcomment -%}
{%- assign coll = product.collections.first -%}
<section class="module module--complete aa-surface-alt module--feature">
  <div>
    <p class="aa-eyebrow module__eyebrow">Styled together</p>
    <h2 class="aa-h2">Complete the room</h2>
    {%- if coll -%}
    <div class="aa-tiles aa-tiles--4" style="margin-top:var(--space-lg)">
      {%- assign shown = 0 -%}
      {%- for pr in coll.products -%}
        {%- if pr.id != product.id and shown < 4 -%}
          {%- render 'aa-product-card', product: pr -%}
          {%- assign shown = shown | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- endif -%}
  </div>
</section>
