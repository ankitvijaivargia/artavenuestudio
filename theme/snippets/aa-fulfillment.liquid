{%- comment -%}
  Art Avenue — snippets/aa-fulfillment.liquid  (fulfillment resolver, no parse_json)
  Echoes ONE scalar. Mirror of enums.json#/labels/fulfillment.
  Params: key (fulfillment), attr = label | lead | icon
{%- endcomment -%}
{%- liquid
  assign k = key | default: 'made-to-order'
  assign a = attr | default: 'label'
-%}
{%- case k -%}
{%- when 'in-stock' -%}
  {%- case a -%}{%- when 'label' -%}In Stock{%- when 'lead' -%}Ships in 3–5 days{%- when 'icon' -%}package{%- endcase -%}
{%- when 'made-to-order' -%}
  {%- case a -%}{%- when 'label' -%}Made to Order{%- when 'lead' -%}Crafted in 3–4 weeks{%- when 'icon' -%}hammer{%- endcase -%}
{%- when 'custom' -%}
  {%- case a -%}{%- when 'label' -%}Custom Order{%- when 'lead' -%}Timeline set at consultation{%- when 'icon' -%}pencil-ruler{%- endcase -%}
{%- when 'project' -%}
  {%- case a -%}{%- when 'label' -%}Project Enquiry{%- when 'lead' -%}Planned to your project schedule{%- when 'icon' -%}buildings{%- endcase -%}
{%- endcase -%}
