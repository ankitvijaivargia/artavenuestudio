{%- comment -%} Art Avenue — Upholstery options. inline=true renders swatch row in buy box. {%- endcomment -%}
{%- assign ups = product.metafields.ava.upholstery.value -%}
{%- if ups and ups.size > 0 -%}
  {%- if inline -%}
    <div class="aa-option">
      <div class="aa-option__label"><span>Upholstery</span></div>
      <div class="aa-swatches">
        {%- for u in ups -%}
          <span class="aa-swatch" title="{{ u.name }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}">
            {%- if u.swatch %}<img src="{{ u.swatch | image_url: width: 92 }}" alt="{{ u.name }}" width="92" height="92">{% endif -%}
          </span>
        {%- endfor -%}
      </div>
    </div>
  {%- else -%}
    <section class="module module--upholstery">
      <p class="aa-eyebrow module__eyebrow">Upholstery</p>
      <h2 class="aa-h2">Upholstery & textiles</h2>
      <div class="grid">
        {%- for u in ups -%}
          <article class="aa-card">
            <div class="aa-card__media aa-fig aa-fig--sand">{% if u.swatch %}<img src="{{ u.swatch | image_url: width: 400 }}" alt="{{ u.name }}" width="400" height="400">{% endif %}</div>
            <h3 class="aa-card__title">{{ u.name }}</h3>
            <p class="aa-body aa-muted">{% if u.composition %}{{ u.composition }}{% endif %}{% if u.performance %} · Performance fabric{% endif %}{% if u.com_accepted %} · COM accepted{% endif %}</p>
          </article>
        {%- endfor -%}
      </div>
    </section>
  {%- endif -%}
{%- endif -%}
