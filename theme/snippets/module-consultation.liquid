{%- comment -%} Art Avenue — Consultation band {%- endcomment -%}
<section class="module module--consult module--feature aa-surface-dark">
  <div class="aa-split">
    <div>
      <p class="aa-eyebrow module__eyebrow" style="color:var(--accent-soft)">Consultation</p>
      <h2 class="aa-h2" style="color:var(--text-on-dark)">Speak with a design consultant</h2>
      <p class="aa-lead" style="color:var(--text-on-dark-muted);max-width:46ch">Complimentary, no obligation. We'll help you specify materials, sizes and finishes for your space.</p>
      <a class="aa-btn aa-btn--on-dark" style="margin-top:var(--space-md)" href="{%- render 'aa-lead-url', type: 'consultation', product: product -%}"><i class="ph ph-chat-teardrop-dots"></i> Book a consultation</a>
    </div>
    <div></div>
  </div>
</section>
