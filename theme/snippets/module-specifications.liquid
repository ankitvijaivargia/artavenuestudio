{%- comment -%} Art Avenue — Specifications (graceful from available data) {%- endcomment -%}
<section class="module module--specs">
  <p class="aa-eyebrow module__eyebrow">Specifications</p>
  <h2 class="aa-h2">The details</h2>
  <div class="aa-measure">
    <table class="aa-specs">
      {% if product.type != blank %}<tr><th>Type</th><td>{{ product.type }}</td></tr>{% endif %}
      {% if product.vendor != blank %}<tr><th>Maker</th><td>{{ product.vendor }}</td></tr>{% endif %}
      {%- assign mats = product.metafields.ava.materials.value -%}
      {% if mats and mats.size > 0 %}<tr><th>Materials</th><td>{% for m in mats %}{{ m.name }}{% unless forloop.last %}, {% endunless %}{% endfor %}</td></tr>{% endif %}
      {%- assign fins = product.metafields.ava.finishes.value -%}
      {% if fins and fins.size > 0 %}<tr><th>Finishes</th><td>{% for f in fins %}{{ f.name }}{% unless forloop.last %}, {% endunless %}{% endfor %}</td></tr>{% endif %}
      {%- assign ct = product.metafields.ava.craft_technique.value -%}
      {% if ct.name %}<tr><th>Technique</th><td>{{ ct.name }}</td></tr>{% endif %}
      {% if product.metafields.ava.fixed_size.value %}<tr><th>Size</th><td>{{ product.metafields.ava.fixed_size.value | split: '|' | first | strip }}</td></tr>{% endif %}
    </table>
  </div>
</section>
