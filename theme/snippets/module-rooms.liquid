{%- comment -%} Art Avenue — Room by room {%- endcomment -%}
<section class="module module--rooms">
  <p class="aa-eyebrow module__eyebrow">In the room</p>
  <h2 class="aa-h2">Room by room</h2>
  <div class="aa-tiles aa-tiles--3" style="margin-top:var(--space-lg)">
    <a class="aa-tile aa-fig aa-fig--sand" href="{{ collections['living-room'].url | default: routes.all_products_collection_url }}"><h3>Living</h3></a>
    <a class="aa-tile aa-fig aa-fig--clay" href="{{ collections['dining'].url | default: routes.all_products_collection_url }}"><h3>Dining</h3></a>
    <a class="aa-tile aa-fig aa-fig--stone" href="{{ collections['bedroom'].url | default: routes.all_products_collection_url }}"><h3>Bedroom</h3></a>
  </div>
</section>
