{%- comment -%}
  Art Avenue — snippets/aa-size.liquid  (size module)
  modes:
    multi  = selector grid from product variants (updates cart variant id + price)
    fixed  = one size + "Need another size? -> consult"
    single = read-only "One size"
    custom = "Configured at consultation", no cart
    mto    = "Request a custom order", no cart
  Params: product, mode, show_cart
{%- endcomment -%}
{%- case mode -%}

{%- when 'multi' -%}
  {%- if product.variants.size > 1 -%}
    <div class="aa-option" data-aa-size>
      <div class="aa-option__label"><span>Size</span> <b data-aa-size-current>{{ product.selected_or_first_available_variant.title }}</b></div>
      <div class="aa-size-grid">
        {%- for v in product.variants -%}
          <button type="button" class="aa-size"
            data-variant-id="{{ v.id }}"
            data-price="{{ v.price | money }}"
            data-title="{{ v.title | escape }}"
            {% unless v.available %}disabled{% endunless %}
            aria-current="{% if v.id == product.selected_or_first_available_variant.id %}true{% else %}false{% endif %}">
            {{ v.title }}
          </button>
        {%- endfor -%}
      </div>
    </div>
    <script>
      (function () {
        var root = document.querySelector('[data-aa-size]');
        if (!root) return;
        root.querySelectorAll('.aa-size').forEach(function (b) {
          b.addEventListener('click', function () {
            root.querySelectorAll('.aa-size').forEach(function (x) { x.setAttribute('aria-current', 'false'); });
            b.setAttribute('aria-current', 'true');
            var cur = root.querySelector('[data-aa-size-current]'); if (cur) cur.textContent = b.dataset.title;
            var idInput = document.querySelector('form[action$="/cart/add"] [name="id"]');
            if (idInput) idInput.value = b.dataset.variantId;
            var priceEl = document.querySelector('.aa-price'); if (priceEl && b.dataset.price && priceEl.firstChild) priceEl.firstChild.textContent = b.dataset.price + ' ';
            var barPrice = document.querySelector('.aa-stickybar__price'); if (barPrice && b.dataset.price) barPrice.textContent = b.dataset.price;
          });
        });
      })();
    </script>
  {%- endif -%}

{%- when 'fixed' -%}
  {%- assign parts = product.metafields.ava.fixed_size.value | default: 'One size' | split: '|' -%}
  <div class="aa-option">
    <div class="aa-option__label"><span>Size</span></div>
    <div class="aa-size-grid">
      <span class="aa-size aa-size--read" aria-current="true">{{ parts[0] | strip }}</span>
    </div>
    <a class="aa-link-underline" href="{%- render 'aa-lead-url', type: 'custom', product: product -%}">Need another size? Speak with a consultant</a>
  </div>

{%- when 'single' -%}
  <div class="aa-option">
    <div class="aa-size-grid"><span class="aa-size aa-size--read" aria-current="true">One size</span></div>
  </div>

{%- when 'custom' -%}
  <div class="aa-option">
    <p class="aa-body aa-muted">Dimensions and specification are configured with you at consultation.</p>
  </div>

{%- when 'mto' -%}
  <div class="aa-option">
    <p class="aa-body aa-muted">Made to order to your specification.</p>
  </div>

{%- endcase -%}
