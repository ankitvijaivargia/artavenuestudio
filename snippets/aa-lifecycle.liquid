{%- comment -%}
  Art Avenue — snippets/aa-lifecycle.liquid  (lifecycle resolver, no parse_json)
  Echoes ONE scalar. Mirror of enums.json#/labels/lifecycle.
  Params: key (lifecycle), attr = label | shopable | primary | banner | hidden
  Booleans returned as 'true' / 'false'.
{%- endcomment -%}
{%- liquid
  assign k = key | default: 'active'
  assign a = attr | default: 'label'
-%}
{%- case k -%}
{%- when 'active' -%}
  {%- case a -%}{%- when 'label' -%}Active{%- when 'shopable' -%}true{%- when 'primary' -%}{%- when 'banner' -%}{%- when 'hidden' -%}false{%- endcase -%}
{%- when 'coming-soon' -%}
  {%- case a -%}{%- when 'label' -%}Coming Soon{%- when 'shopable' -%}false{%- when 'primary' -%}notify{%- when 'banner' -%}Arriving soon — register your interest and we'll tell you the moment it's available.{%- when 'hidden' -%}false{%- endcase -%}
{%- when 'seasonal' -%}
  {%- case a -%}{%- when 'label' -%}Seasonal{%- when 'shopable' -%}true{%- when 'primary' -%}{%- when 'banner' -%}A seasonal piece, available for a limited time.{%- when 'hidden' -%}false{%- endcase -%}
{%- when 'discontinued' -%}
  {%- case a -%}{%- when 'label' -%}Discontinued{%- when 'shopable' -%}false{%- when 'primary' -%}consult{%- when 'banner' -%}This piece has been discontinued. Speak with a consultant about current alternatives.{%- when 'hidden' -%}false{%- endcase -%}
{%- when 'archive' -%}
  {%- case a -%}{%- when 'label' -%}Archived{%- when 'shopable' -%}false{%- when 'primary' -%}{%- when 'banner' -%}This piece is archived and no longer available.{%- when 'hidden' -%}true{%- endcase -%}
{%- endcase -%}
