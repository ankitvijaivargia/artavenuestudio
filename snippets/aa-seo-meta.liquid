{%- comment -%}
  aa-seo-meta — Open Graph, Twitter card and schema.org JSON-LD.
  Rendered once in layout/theme.liquid <head>. Output only; no visual change.
  og:image is NOT emitted here — Shopify already injects it (social sharing image / product image).
{%- endcomment -%}
{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_desc = page_description | default: shop.description | strip_html | strip_newlines | truncate: 300
  assign og_type = 'website'
  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  endif
  assign money_fmt = cart.currency.iso_code | default: shop.currency
-%}
<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
{%- if og_desc != blank %}
<meta property="og:description" content="{{ og_desc | escape }}">
{%- endif %}
{%- if request.page_type == 'product' %}
<meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html | remove: ',' }}">
<meta property="og:price:currency" content="{{ money_fmt }}">
{%- endif %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
{%- if og_desc != blank %}
<meta name="twitter:description" content="{{ og_desc | escape }}">
{%- endif %}

{%- comment -%}
  Structured data, v3 (14 Nov 2026). Facts approved by Ankit:
  - head office and factory in Jaipur; showroom in New Delhi (Ghitorni, MG Road, open 11 am–8 pm daily);
  - free delivery within India at serviceable pin codes (remote-location charges quoted at delivery),
    usual transit 5–7 working days after dispatch; made-to-order handling time from aav.lead_time;
  - no returns or refunds (made to order); defective pieces repaired or replaced;
  - social profiles @artavenueindia; Ankit Vijaivargia named as founder.
  Entities: /#organization (on every page), /#showroom (department), /#website (home).
  Products with options are a ProductGroup with one Product per variant; single-variant products stay a Product.
{%- endcomment -%}
{%- liquid
  assign aa_site = shop.url
  assign aa_org_id = aa_site | append: '/#organization'
  assign aa_web_id = aa_site | append: '/#website'
-%}
{%- capture aa_returns -%}{
        "@type": "MerchantReturnPolicy",
        "applicableCountry": "IN",
        "returnPolicyCountry": "IN",
        "returnPolicyCategory": "https://schema.org/MerchantReturnNotPermitted",
        "merchantReturnLink": {{ aa_site | append: '/policies/refund-policy' | json }}
      }{%- endcapture -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": {{ aa_org_id | json }},
      "name": {{ shop.name | json }},
      "alternateName": "Art Avenue Design House",
      "url": {{ aa_site | json }},
      {%- if shop.brand.logo %}
      "logo": {{ shop.brand.logo | image_url: width: 600 | prepend: 'https:' | json }},
      {%- endif %}
      "description": "Art Avenue is an Indian design house that makes handcrafted furniture and hand-tufted and hand-knotted wool rugs to order in its own workshop in Jaipur, with a showroom in New Delhi and interior design for homes in Delhi NCR.",
      "founder": { "@type": "Person", "name": "Ankit Vijaivargia" },
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Jaipur",
        "addressRegion": "Rajasthan",
        "postalCode": "302029",
        "addressCountry": "IN"
      },
      "email": "shop@artavenue.com",
      "telephone": "+91-98280-80095",
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "customer service",
        "telephone": "+91-98280-80095",
        "email": "shop@artavenue.com",
        "areaServed": "IN"
      },
      "department": { "@id": {{ aa_site | append: '/#showroom' | json }} },
      "sameAs": [
        "https://www.instagram.com/artavenueindia/",
        "https://www.facebook.com/artavenueindia",
        "https://www.pinterest.com/artavenueindia/"
      ],
      "hasMerchantReturnPolicy": {{ aa_returns }}
    },
    {
      "@type": "FurnitureStore",
      "@id": {{ aa_site | append: '/#showroom' | json }},
      "name": "Art Avenue — New Delhi Showroom",
      "url": {{ aa_site | append: '/pages/contact' | json }},
      "parentOrganization": { "@id": {{ aa_org_id | json }} },
      "telephone": "+91-98280-80095",
      "email": "shop@artavenue.com",
      "priceRange": "₹₹₹",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "2nd Floor, Plot No. 844, opp. Metro Pillar 113, MG Road, Ghitorni",
        "addressLocality": "New Delhi",
        "addressRegion": "Delhi",
        "postalCode": "110030",
        "addressCountry": "IN"
      },
      "openingHoursSpecification": [{
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["https://schema.org/Monday","https://schema.org/Tuesday","https://schema.org/Wednesday","https://schema.org/Thursday","https://schema.org/Friday","https://schema.org/Saturday","https://schema.org/Sunday"],
        "opens": "11:00",
        "closes": "20:00"
      }]
    }
    {%- if request.page_type == 'index' %},
    {
      "@type": "WebSite",
      "@id": {{ aa_web_id | json }},
      "name": {{ shop.name | json }},
      "alternateName": "Art Avenue Design House",
      "url": {{ aa_site | json }},
      "publisher": { "@id": {{ aa_org_id | json }} },
      "inLanguage": "en-IN"
    }
    {%- elsif request.page_type == 'collection' %},
    {
      "@type": "CollectionPage",
      "@id": {{ canonical_url | append: '#webpage' | json }},
      "url": {{ canonical_url | json }},
      "name": {{ collection.title | json }},
      "isPartOf": { "@id": {{ aa_web_id | json }} },
      "publisher": { "@id": {{ aa_org_id | json }} },
      "mainEntity": {
        "@type": "ItemList",
        "numberOfItems": {{ collection.products_count }},
        "itemListElement": [
          {%- for p in collection.products limit: 24 -%}
          { "@type": "ListItem", "position": {{ forloop.index }}, "url": {{ shop.url | append: p.url | json }}, "name": {{ p.title | json }} }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      }
    }
    {%- elsif request.page_type == 'page' and page.handle == 'about' %},
    {
      "@type": "AboutPage",
      "@id": {{ canonical_url | append: '#webpage' | json }},
      "url": {{ canonical_url | json }},
      "name": {{ page.title | json }},
      "isPartOf": { "@id": {{ aa_web_id | json }} },
      "about": { "@id": {{ aa_org_id | json }} },
      "mainEntity": { "@id": {{ aa_org_id | json }} }
    }
    {%- elsif request.page_type == 'page' and page.handle == 'contact' %},
    {
      "@type": "ContactPage",
      "@id": {{ canonical_url | append: '#webpage' | json }},
      "url": {{ canonical_url | json }},
      "name": {{ page.title | json }},
      "isPartOf": { "@id": {{ aa_web_id | json }} },
      "about": { "@id": {{ aa_site | append: '/#showroom' | json }} }
    }
    {%- endif %}
  ]
}
</script>

{%- if request.page_type == 'product' %}
{%- liquid
  assign seo_desc = product.description | strip_html | strip_newlines | truncate: 5000
  comment
    Made-to-order window: the text after the last " in " of aav.lead_time ("Crafted in 6–8 weeks",
    "... Other sizes crafted in 4–6 weeks"), the same rule aa-pdp-details uses; converted to days.
    In-stock variants (tracked, quantity > 0) get handling 0–2 days.
  endcomment
  assign aa_lead = product.metafields.aav.lead_time.value | default: ''
  assign aa_hmin = 0
  assign aa_hmax = 0
  if aa_lead contains ' in '
    assign aa_win = aa_lead | split: ' in ' | last | downcase | remove: 'weeks' | remove: 'week' | remove: '.' | strip | replace: '–', '-' | replace: '—', '-'
    assign aa_parts = aa_win | split: '-'
    if aa_parts.size == 2
      assign aa_hmin = aa_parts[0] | strip | times: 7
      assign aa_hmax = aa_parts[1] | strip | times: 7
    endif
  endif
  assign aa_multi = false
  if product.has_only_default_variant == false and product.variants.size > 1
    assign aa_multi = true
  endif
  assign aa_varies = ''
  for opt in product.options_with_values
    assign on = opt.name | downcase
    if on contains 'size'
      assign aa_varies = aa_varies | append: '"https://schema.org/size",'
    elsif on contains 'material' or on contains 'construction' or on contains 'leather' or on contains 'fabric'
      assign aa_varies = aa_varies | append: '"https://schema.org/material",'
    elsif on contains 'colour' or on contains 'color'
      assign aa_varies = aa_varies | append: '"https://schema.org/color",'
    endif
  endfor
  assign aa_varies = aa_varies | remove_last: ','
-%}
{%- capture aa_images -%}{%- if product.featured_media -%}[
    {%- for media in product.media limit: 6 -%}
      {{ media.preview_image | image_url: width: 1600 | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]{%- endif -%}{%- endcapture -%}
{%- capture aa_brand -%}{ "@type": "Brand", "name": {{ shop.name | json }} }{%- endcapture -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  {%- if aa_multi %}
  "@type": "ProductGroup",
  "@id": {{ canonical_url | append: '#product' | json }},
  "productGroupID": {{ product.id | append: '' | json }},
  {%- if aa_varies != blank %}
  "variesBy": [{{ aa_varies }}],
  {%- endif %}
  {%- else %}
  "@type": "Product",
  "@id": {{ canonical_url | append: '#product' | json }},
  {%- endif %}
  "name": {{ product.title | json }},
  "url": {{ canonical_url | json }},
  {%- if aa_images != blank %}
  "image": {{ aa_images }},
  {%- endif %}
  "description": {{ seo_desc | json }},
  "brand": {{ aa_brand }},
  {%- if product.type != blank %}
  "category": {{ product.type | json }},
  {%- endif %}
  {%- if aa_multi %}
  "hasVariant": [
  {%- else %}
  {%- if product.selected_or_first_available_variant.sku != blank %}
  "sku": {{ product.selected_or_first_available_variant.sku | json }},
  {%- endif %}
  "offers":
  {%- endif %}
    {%- for variant in product.variants -%}
    {%- liquid
      assign aa_ready = false
      if variant.inventory_management == 'shopify' and variant.inventory_quantity > 0
        assign aa_ready = true
      endif
      assign v_url = canonical_url | append: '?variant=' | append: variant.id
    -%}
    {%- capture aa_offer -%}{
      "@type": "Offer",
      "url": {{ v_url | json }},
      "price": {{ variant.price | divided_by: 100.0 | json }},
      "priceCurrency": {{ money_fmt | json }},
      "itemCondition": "https://schema.org/NewCondition",
      "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
      "seller": { "@type": "Organization", "@id": {{ aa_org_id | json }}, "name": {{ shop.name | json }} },
      "shippingDetails": {
        "@type": "OfferShippingDetails",
        "shippingRate": { "@type": "MonetaryAmount", "value": 0, "currency": "INR" },
        "shippingDestination": { "@type": "DefinedRegion", "addressCountry": "IN" },
        "deliveryTime": {
          "@type": "ShippingDeliveryTime",
          {%- if aa_ready or aa_hmax == 0 %}
          "handlingTime": { "@type": "QuantitativeValue", "minValue": 0, "maxValue": 2, "unitCode": "DAY" },
          {%- else %}
          "handlingTime": { "@type": "QuantitativeValue", "minValue": {{ aa_hmin }}, "maxValue": {{ aa_hmax }}, "unitCode": "DAY" },
          {%- endif %}
          "transitTime": { "@type": "QuantitativeValue", "minValue": 5, "maxValue": 7, "unitCode": "DAY" }
        }
      },
      "hasMerchantReturnPolicy": {{ aa_returns }}
    }{%- endcapture -%}
    {%- if aa_multi %}
    {
      "@type": "Product",
      "@id": {{ v_url | append: '#variant' | json }},
      "name": {{ product.title | append: ' — ' | append: variant.title | json }},
      "description": {{ seo_desc | truncate: 300 | json }},
      "url": {{ v_url | json }},
      {%- if variant.sku != blank %}
      "sku": {{ variant.sku | json }},
      {%- endif %}
      {%- if variant.featured_media %}
      "image": {{ variant.featured_media.preview_image | image_url: width: 1600 | prepend: 'https:' | json }},
      {%- elsif aa_images != blank %}
      "image": {{ aa_images }},
      {%- endif %}
      "brand": {{ aa_brand }},
      {%- for opt in product.options_with_values -%}
        {%- assign on = opt.name | downcase -%}
        {%- assign ov = variant.options[forloop.index0] -%}
        {%- if on contains 'size' %}
      "size": {{ ov | json }},
        {%- elsif on contains 'material' or on contains 'construction' or on contains 'leather' or on contains 'fabric' %}
      "material": {{ ov | json }},
        {%- elsif on contains 'colour' or on contains 'color' %}
      "color": {{ ov | json }},
        {%- endif -%}
      {%- endfor %}
      "offers": {{ aa_offer }}
    }{% unless forloop.last %},{% endunless %}
    {%- else -%}
    {{ aa_offer }}
    {%- endif -%}
    {%- endfor -%}
  {%- if aa_multi %}
  ]
  {%- endif %}
}
</script>
{%- endif %}

{%- if request.page_type == 'article' %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BlogPosting",
      "@id": {{ canonical_url | append: '#article' | json }},
      "mainEntityOfPage": {{ canonical_url | json }},
      "headline": {{ article.title | truncate: 110 | json }},
      "description": {{ article.excerpt_or_content | strip_html | strip_newlines | truncate: 300 | json }},
      {%- if article.image %}
      "image": [{{ article.image | image_url: width: 1600 | prepend: 'https:' | json }}],
      {%- endif %}
      "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
      "dateModified": {{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
      "author": { "@type": "Organization", "@id": {{ aa_org_id | json }}, "name": {{ shop.name | json }}, "url": {{ aa_site | json }} },
      "publisher": { "@id": {{ aa_org_id | json }} },
      "isPartOf": { "@type": "Blog", "name": {{ blog.title | json }}, "url": {{ shop.url | append: blog.url | json }} },
      "inLanguage": "en-IN",
      "wordCount": {{ article.content | strip_html | split: ' ' | size }}
      {%- if article.tags.size > 0 %},
      "keywords": {{ article.tags | join: ', ' | json }}
      {%- endif %}
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop.url | json }} },
        { "@type": "ListItem", "position": 2, "name": {{ blog.title | json }}, "item": {{ shop.url | append: blog.url | json }} },
        { "@type": "ListItem", "position": 3, "name": {{ article.title | json }}, "item": {{ canonical_url | json }} }
      ]
    }
  ]
}
</script>
{%- endif %}

{%- if request.page_type == 'product' or request.page_type == 'collection' %}
{%- liquid
  comment
    Breadcrumb: Home › category › product. Product pages use the first matching category collection from a
    fixed priority list, so canonical /products/ URLs (no collection in the URL) still get a category level.
  endcomment
  assign aa_cat = nil
  if request.page_type == 'product'
    assign aa_pri = 'sofas,armchairs,beds,wardrobes,tv-units,sideboards,console-tables,coffee-tables,bedside-tables,chests-of-drawers,trunks,side-tables,cabinets,ottomans-benches,chairs-and-ottomans,hand-knotted-rugs,hand-tufted-rugs,rugs,furniture' | split: ','
    assign aa_tl = product.title | downcase
    assign aa_kw = 'coffee table:coffee-tables|tv unit:tv-units|sideboard:sideboards|console:console-tables|desk:console-tables|bedside:bedside-tables|chest of drawers:chests-of-drawers|wardrobe:wardrobes|sofa:sofas|chair:armchairs|ottoman:ottomans-benches|stool:ottomans-benches|bench:ottomans-benches|cabinet:cabinets|trunk:trunks|bed:beds' | split: '|'
    if collection
      assign aa_cat = collection
    else
      for kv in aa_kw
        assign kvp = kv | split: ':'
        if aa_tl contains kvp[0]
          for c in product.collections
            if c.handle == kvp[1]
              assign aa_cat = c
              break
            endif
          endfor
        endif
        if aa_cat
          break
        endif
      endfor
    endif
    if aa_cat == nil
      for h in aa_pri
        for c in product.collections
          if c.handle == h
            assign aa_cat = c
            break
          endif
        endfor
        if aa_cat
          break
        endif
      endfor
    endif
  endif
-%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop.url | json }} }
    {%- if request.page_type == 'collection' %},
    { "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ shop.url | append: collection.url | json }} }
    {%- elsif aa_cat %},
    { "@type": "ListItem", "position": 2, "name": {{ aa_cat.title | json }}, "item": {{ shop.url | append: aa_cat.url | json }} },
    { "@type": "ListItem", "position": 3, "name": {{ product.title | json }}, "item": {{ canonical_url | json }} }
    {%- else %},
    { "@type": "ListItem", "position": 2, "name": {{ product.title | json }}, "item": {{ canonical_url | json }} }
    {%- endif %}
  ]
}
</script>
{%- endif %}
