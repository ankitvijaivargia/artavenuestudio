{%- comment -%}
  Art Avenue — cross-product links. Add-on to the GRID engine (aa-chair-config);
  the engine itself is untouched. Rendered once in main-product, AFTER aa-customize-modal.
  Purpose: one design photographed in two colours (or two sizes) lives as two products;
  a choice can send the shopper to the sibling page photographed in that colour/size.
  Per-picker keys in aav.configurator.pickers[]:
    "links": {"Onyx":"/products/x"}      choosing Onyx opens /products/x
    "links_else": "/products/y",           any choice NOT listed in links_self opens /products/y
    "links_self": ["Onyx"]
    "default_item": "Hazel"                picker starts on this item (else the first item)
    "link_note": "..."                     appended to linked swatches' description in the drawer
  Size keys at the top level of aav.configurator (size buttons = [data-grid-size]):
    "size_links": {"120 cm":"/products/x"} choosing 120 cm opens /products/x
    "size_links_else": "/products/y",      any size NOT in size_links_self opens /products/y
    "size_links_self": ["120 cm"]
    "size_default": "120 cm"               size selected on page load (else the engine's first)
  Current picks travel as ?size=120%20cm&leather=Saddle&hardware=Gold and are preselected on arrival.
  Mechanism: wraps window.aaCz.register / onChoose before the engine binds (engine waits for
  DOMContentLoaded; this runs inline during parse); size clicks are caught in the capture phase.
  params: product
{%- endcomment -%}

{%- comment -%}
  Art Avenue — PICKER GATE. Restricts one picker's options by another picker's current choice.
  The grid engine cannot do this natively: branch_by_axis keys only off the second PRICED axis
  (Construction), and leather is a picker, not an axis. Historically the workaround was
  one-page-one-colour (Sojat / Mandawa / Mehrangarh / Kumbhalgarh). This gates in place instead.
  Per-picker keys in aav.configurator.pickers[], set on the picker being RESTRICTED:
    "gate_by": "leather"                   key of the picker this one is restricted by
    "gate_allow": {                        source choice -> the only options allowed here
      "Onyx":   ["Blackwood"],
      "Saddle": ["English Chestnut","Walnut"],
      "Hazel":  ["English Chestnut","Walnut"]
    }
  A source choice absent from gate_allow leaves this picker unrestricted (fail-open).
  A gate that would empty the picker is ignored — a blank picker is the engine's worst
  failure mode, so the full list is restored rather than rendering nothing.
  When the live choice is no longer allowed it is moved to the first allowed option and the
  cart property follows. Safe to re-register: the engine re-registers pickers itself
  (syncInheritors -> registerPicker) so this uses the same supported path.
  NOTE: do NOT name this leg_wood_map. That key is dead config still sitting on some products
  with stale pre-Hazel values; reviving the name would silently activate them.
{%- endcomment -%}

{%- comment -%}
  Art Avenue — single-option grid picker. Always rendered (outside the links guard).
  When a picker resolves to one item the engine hides the picker row and shows a plain
  replacement line instead. House rule is the opposite: every finish keeps the same row
  format whether it has one option or five, so the PDP reads consistently. The engine
  hides the row with the `hidden` attribute only, which theme CSS already overrides, so
  the row survives on its own — all this needs to do is drop the replacement line.
  Engine file deliberately untouched.
{%- endcomment -%}
<style>
  .aa-chair--grid [data-grid-pfixed]{ display:none !important; }
</style>

{%- assign _lcfg = product.metafields.aav.configurator.value -%}
{%- assign _lhas = false -%}
{%- if _lcfg.engine == 'grid' -%}
  {%- if _lcfg.size_links != blank or _lcfg.size_links_else != blank or _lcfg.size_default != blank -%}{%- assign _lhas = true -%}{%- endif -%}
  {%- for lp in _lcfg.pickers -%}
    {%- if lp.links != blank or lp.links_else != blank or lp.default_item != blank or lp.gate_by != blank -%}{%- assign _lhas = true -%}{%- endif -%}
  {%- endfor -%}
{%- endif -%}
{%- if _lhas -%}
<script type="application/json" id="aa-picker-links">{
{%- for lp in _lcfg.pickers -%}
  {{ lp.key | json }}: {"links": {{ lp.links | json }}, "orElse": {{ lp.links_else | json }}, "self": {{ lp.links_self | json }}, "def": {{ lp.default_item | json }}, "note": {{ lp.link_note | json }}, "gateBy": {{ lp.gate_by | json }}, "gateAllow": {{ lp.gate_allow | json }}}{%- unless forloop.last -%},{%- endunless -%}
{%- endfor -%}
}</script>
<script type="application/json" id="aa-size-links">{"links": {{ _lcfg.size_links | json }}, "orElse": {{ _lcfg.size_links_else | json }}, "self": {{ _lcfg.size_links_self | json }}, "def": {{ _lcfg.size_default | json }}}</script>
<script>
(function(){
  var cfg={}, sz={};
  try{ cfg=JSON.parse(document.getElementById('aa-picker-links').textContent)||{}; }catch(e){}
  try{ sz=JSON.parse(document.getElementById('aa-size-links').textContent)||{}; }catch(e){}
  var qp={}; try{ new URLSearchParams(window.location.search).forEach(function(v,k){ qp[k]=v; }); }catch(e){}
  var items={}, chosen={}, handler=null, done=false;
  var fullItems={}, regObj={};

  function lc(s){ return String(s==null?'':s).trim().toLowerCase(); }
  function path(s){ return lc(s).replace(/[?#].*$/,'').replace(/\/+$/,''); }
  function find(list,name){ if(!list || !name) return null; for(var i=0;i<list.length;i++){ if(lc(list[i].name)===lc(name)) return list[i]; } return null; }
  function resolve(c,name){
    if(!c) return null;
    if(c.links){ for(var k in c.links){ if(lc(k)===lc(name)){ return path(window.location.pathname)===path(c.links[k]) ? null : c.links[k]; } } }
    if(c.orElse){
      var self=c.self||[];
      for(var i=0;i<self.length;i++){ if(lc(self[i])===lc(name)) return null; }
      if(path(window.location.pathname)===path(c.orElse)) return null;
      return c.orElse;
    }
    return null;
  }
  function linkFor(pk,name){ return resolve(cfg[pk],name); }
  function activeSize(){ var b=document.querySelector('[data-grid-size].is-active'); return b ? b.getAttribute('data-grid-size') : null; }
  function go(url,key,name){
    var q={}, s=activeSize(); if(s) q.size=s;
    for(var k in chosen){ q[k]=chosen[k]; } q[key]=name;
    var parts=[]; for(var k2 in q){ parts.push(encodeURIComponent(k2)+'='+encodeURIComponent(q[k2])); }
    window.location.href=url+(url.indexOf('?')>-1?'&':'?')+parts.join('&');
  }

  /* ---- picker gate ---- */
  function gateOf(pk){ var c=cfg[pk]; return (c && c.gateBy && c.gateAllow) ? c : null; }
  function allowedFor(pk){
    var g=gateOf(pk); if(!g) return null;
    var src=chosen[g.gateBy]; if(!src) return null;
    for(var k in g.gateAllow){ if(lc(k)===lc(src)) return g.gateAllow[k]||null; }
    return null;
  }
  function gateItems(pk,list){
    if(!list || !list.length) return list;
    var allow=allowedFor(pk); if(!allow || !allow.length) return list;
    var out=[];
    for(var i=0;i<list.length;i++){
      for(var j=0;j<allow.length;j++){ if(lc(allow[j])===lc(list[i].name)){ out.push(list[i]); break; } }
    }
    return out.length ? out : list;
  }
  function regate(pk){
    var base=fullItems[pk]; if(!base) return;
    var next=gateItems(pk,base);
    var o=regObj[pk]||{}; var out={};
    for(var k in o){ out[k]=o[k]; }
    out.items=next;
    items[pk]=next;
    try{ origRegister.call(cz,'gridp-'+pk,out); }catch(e){}
    var cur=chosen[pk], ok=false;
    for(var i=0;i<next.length;i++){ if(lc(next[i].name)===lc(cur)) { ok=true; break; } }
    if(!ok && next[0]){
      chosen[pk]=next[0].name;
      if(handler){ try{ handler('gridp-'+pk,next[0]); }catch(e){} }
    }
  }
  function regateBy(srcKey){
    for(var pk in cfg){ var g=gateOf(pk); if(g && lc(g.gateBy)===lc(srcKey)) regate(pk); }
  }
  function regateAll(){ for(var pk in cfg){ if(gateOf(pk)) regate(pk); } }

  /* ---- size links ---- */
  if(sz.links || sz.orElse || sz.def){
    document.addEventListener('click',function(e){
      var b=e.target && e.target.closest ? e.target.closest('[data-grid-size]') : null; if(!b) return;
      var name=b.getAttribute('data-grid-size'), url=resolve(sz,name);
      if(!url) return;
      e.preventDefault(); e.stopImmediatePropagation(); go(url,'size',name);
    },true);
    var applySize=function(){
      var want=null;
      if(qp.size && !resolve(sz,qp.size)) want=qp.size;
      if(!want && sz.def) want=sz.def;
      if(!want) return;
      var btns=document.querySelectorAll('[data-grid-size]');
      for(var i=0;i<btns.length;i++){
        if(lc(btns[i].getAttribute('data-grid-size'))===lc(want)){ if(!btns[i].classList.contains('is-active')) btns[i].click(); break; }
      }
    };
    var later=function(){ setTimeout(applySize,0); };
    if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',later); else later();
  }

  /* ---- picker links ---- */
  var cz=window.aaCz; if(!cz || !cz.register || !cz.onChoose) return;
  var origRegister=cz.register, origOnChoose=cz.onChoose;

  cz.register=function(group,obj){
    if(group && group.indexOf('gridp-')===0 && obj && obj.items){
      var pk=group.slice(6), c=cfg[pk];
      var list=obj.items;
      if(c && c.note){
        list=list.map(function(it){
          if(!linkFor(pk,it.name)) return it;
          var x={}; for(var kk in it){ x[kk]=it[kk]; }
          x.meta=(it.meta?it.meta+' ':'')+c.note;
          return x;
        });
      }
      var o={}; for(var k in obj){ o[k]=obj[k]; }
      o.items=list;
      fullItems[pk]=list; regObj[pk]=o;
      if(gateOf(pk)){
        var g={}; for(var k2 in o){ g[k2]=o[k2]; }
        g.items=gateItems(pk,list);
        items[pk]=g.items;
        return origRegister.call(cz,group,g);
      }
      items[pk]=list;
      obj=o;
    }
    return origRegister.call(cz,group,obj);
  };

  cz.onChoose=function(fn){
    handler=fn;
    origOnChoose.call(cz,function(group,item){
      if(group && group.indexOf('gridp-')===0 && item){
        var pk=group.slice(6), url=linkFor(pk,item.name);
        if(url){ go(url,pk,item.name); return; }
        chosen[pk]=item.name;
        fn(group,item);
        regateBy(pk);
        return;
      }
      fn(group,item);
    });
    preselect();
  };

  function preselect(){
    if(done || !handler) return; done=true;
    for(var pk in items){
      var list=items[pk]||[], c=cfg[pk]||{}, it=null;
      var fromUrl=find(list,qp[pk]);
      if(fromUrl && !linkFor(pk,fromUrl.name)) it=fromUrl;
      if(!it && c.def) it=find(list,c.def);
      if(it){ try{ handler('gridp-'+pk,it); }catch(e){} chosen[pk]=it.name; }
      else if(list[0]){ chosen[pk]=list[0].name; }
    }
    regateAll();
  }
})();
</script>
{%- endif -%}

{%- comment -%}
  Art Avenue — FABRIC HERO SWAP. Add-on; the grid engine and the gallery are both untouched.
  Choosing a swatch repaints the FIRST gallery slide with a render of THIS product in that
  fabric, so the shopper sees the choice instead of reading it.
  Renders live in Content -> Files, NOT product media: as product media every fabric would
  land in the thumbnail strip and drown the real photography.
  Product metafield aav.swatch_images (JSON), either shape:
    {"Pebble":"https://cdn.shopify.com/s/files/.../hampstead-pebble.jpg", ...}
    {"picker":"fabric","images":{"Pebble":"https://...", ...}}
  Keys are swatch NAMES (the metaobject display name), not handles. Without "picker" any
  picker whose choice matches a key will swap; with it, only that picker key does.
  Omit a swatch and its choice leaves the hero alone — that is how the colourway that was
  actually photographed keeps its real photograph instead of a render.
  Fail-open throughout: no metafield, no gallery, unmapped swatch, or an image that 404s all
  leave the hero exactly as shot. The frame is preloaded and painted only once it has
  decoded, so the hero never flashes empty mid-swap, and a stale slow load cannot overwrite
  a newer choice (token guard).
  Slide 0 is repainted IN PLACE, so data-idx numbering, the thumb strip, the arrows and the
  IntersectionObserver in main-product all keep working untouched. The gallery is snapped
  back to slide 1 on a change, but never on first paint — a page that scrolls itself on load
  is worse than one that does nothing.
  params: product
{%- endcomment -%}
{%- assign _swi = product.metafields.aav.swatch_images.value -%}
{%- if _swi != blank and product.images.size > 0 -%}
<script type="application/json" id="aa-swatch-images">{{ _swi | json }}</script>
<script>
(function(){
  var raw={};
  try{ raw=JSON.parse(document.getElementById('aa-swatch-images').textContent)||{}; }catch(e){ return; }
  var map=(raw.images && typeof raw.images==='object') ? raw.images : raw;
  var only=raw.picker ? String(raw.picker) : null;
  var title={{ product.title | json }};

  var main=document.getElementById('aaGalMain'); if(!main) return;
  var slide=main.querySelector('.aa-gallery__slide[data-idx="0"]'); if(!slide) return;
  var hero=slide.querySelector('img'); if(!hero) return;
  var thumbBtn=document.querySelector('#aaGalThumbs .aa-gallery__thumb[data-idx="0"]');
  var thumb=thumbBtn ? thumbBtn.querySelector('img') : null;

  var origSrc=hero.getAttribute('src'), origAlt=hero.getAttribute('alt')||'';
  var origThumb=thumb ? thumb.getAttribute('src') : null;
  var booted=false, token=0, current=null;

  function lc(s){ return String(s==null?'':s).trim().toLowerCase(); }
  function lookup(name){ for(var k in map){ if(lc(k)===lc(name)) return map[k]; } return null; }
  function sized(u,px){ if(!u) return u; return u+(u.indexOf('?')>-1?'&':'?')+'width='+px; }
  function snap(){
    if(!booted) return;
    if(thumbBtn){ thumbBtn.click(); return; }
    try{ slide.scrollIntoView({behavior:'smooth',inline:'center',block:'nearest'}); }catch(e){}
  }
  function restore(){
    if(current===null) return;
    current=null;
    hero.setAttribute('src',origSrc);
    hero.setAttribute('alt',origAlt);
    if(thumb && origThumb) thumb.setAttribute('src',origThumb);
    snap();
  }
  function swap(name){
    var url=lookup(name);
    if(!url){ restore(); return; }
    if(current!==null && lc(current)===lc(name)) return;
    var id=++token, full=sized(url,1400);
    var pre=new Image();
    pre.onload=function(){
      if(id!==token) return;
      current=name;
      hero.setAttribute('src',full);
      hero.setAttribute('alt',title+' upholstered in '+name);
      if(thumb) thumb.setAttribute('src',sized(url,160));
      snap();
    };
    pre.onerror=function(){ if(id===token) restore(); };
    pre.src=full;
  }

  var cz=window.aaCz; if(!cz || !cz.onChoose) return;
  var origOnChoose=cz.onChoose;
  cz.onChoose=function(fn){
    origOnChoose.call(cz,function(group,item){
      fn(group,item);
      if(group && group.indexOf('gridp-')===0 && item && item.name){
        var pk=group.slice(6);
        if(!only || lc(only)===lc(pk)) swap(item.name);
      }
    });
  };

  var boot=function(){ setTimeout(function(){ booted=true; },0); };
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',boot); else boot();
})();
</script>
{%- endif -%}
