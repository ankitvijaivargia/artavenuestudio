{%- comment -%} params: mode, product {%- endcomment -%}
{%- capture custom_href -%}{% render 'aa-lead-url', type:'custom', product: product, message:'Custom size or finish' %}{%- endcapture -%}
{%- assign t = product.type | downcase -%}
{%- if mode == 'mto' or mode == 'custom' -%}
  <div style="margin-top:24px;padding:18px 20px;border-radius:var(--radius-sm);background:var(--surface-accent-tint);border:1px solid var(--accent-soft)">
    <div class="serif" style="font-size:18px">Custom dimensions available</div>
    <p style="font-size:13px;line-height:1.55;color:var(--text-secondary);margin:6px 0 0">This piece is made to your measurements — share your space and we'll build it to fit.</p>
  </div>
{%- elsif mode == 'multi' -%}
  {%- if t contains 'rug' -%}{%- assign sizes = "3×5 ft,4×6 ft,5×8 ft,6×9 ft,8×10 ft,9×12 ft" | split: "," -%}{%- assign default = "8×10 ft" -%}
  {%- else -%}{%- assign sizes = "Standard,Grand" | split: "," -%}{%- assign default = "Standard" -%}{%- endif -%}
  <div class="aa-opt">
    <div class="aa-opt__label"><span>Size</span><span data-aa-optval style="color:var(--text-secondary)">{{ default }}</span></div>
    <div class="aa-opt__row">
      {%- for s in sizes -%}<button type="button" class="aa-opt__chip{% if s == default %} is-active{% endif %}" data-aa-opt data-aa-label="{{ s }}">{{ s }}</button>{%- endfor -%}
    </div>
  </div>
  <a href="{{ custom_href | strip }}" target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:8px;margin-top:16px;color:var(--text-accent);font-size:12px;letter-spacing:var(--tracking-caps);text-transform:uppercase">Need a custom size or finish? <i class="ph ph-arrow-right"></i></a>
{%- elsif mode == 'single' or mode == 'fixed' -%}
  <div class="aa-opt"><div class="aa-opt__label"><span>Size</span></div><div class="aa-opt__row"><span class="aa-opt__chip is-active"><i class="ph ph-check" style="font-size:11px"></i> One size</span></div></div>
{%- endif -%}
