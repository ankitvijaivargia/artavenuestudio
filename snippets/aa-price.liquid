{%- comment -%}
  Display price.
  Multi-variant products open on a From price computed across real variants;
  once the customer picks a size the exact price replaces it.
  Any variant whose title contains "Custom" is excluded from the From figure —
  rug custom sizes are priced per 0.1 sq ft and would otherwise dominate.
  Tracking is done by watching the cart form's variant input, so this works with
  the grid engine and the rug engine alike without knowing either one's markup.

  GST (29 Oct 2026): Shopify prices are stored INCLUDING 18% GST (Razorpay Magic
  Checkout charges the stored price as-is). With the theme setting
  "Show prices before GST" on, the headline shows stored price / 1.18 with "+ GST",
  and the line below shows the stored GST-inclusive price.
{%- endcomment -%}
{%- assign disp_price = product.price -%}
{%- assign price_prefix = '' -%}
{%- assign lowest = 0 -%}{%- assign std_count = 0 -%}
{%- for v in product.variants -%}
  {%- unless v.title contains 'Custom' -%}
    {%- assign std_count = std_count | plus: 1 -%}
    {%- if lowest == 0 or v.price < lowest -%}{%- assign lowest = v.price -%}{%- endif -%}
  {%- endunless -%}
{%- endfor -%}
{%- if lowest > 0 -%}
  {%- assign disp_price = lowest -%}
  {%- if std_count > 1 -%}{%- assign price_prefix = 'From ' -%}{%- endif -%}
{%- endif -%}
{%- assign exg = settings.aa_price_before_gst -%}
{%- if show_price -%}
  <div style="display:flex;align-items:baseline;gap:14px;flex-wrap:wrap;margin-top:16px">
    <span class="aa-price" style="margin-top:0" data-aa-price-display>{{ price_prefix }}{% render 'aa-money', cents: disp_price, exgst: true %}{% if exg %}<span class="aa-price-gst" style="font-size:.6em;letter-spacing:.04em;margin-left:6px">+ GST</span>{% endif %}</span>
    {%- if caption != blank -%}<span class="aa-price-cap" style="margin-top:0">{{ caption }}</span>{%- endif -%}
  </div>
  {%- if exg -%}
    <div class="aa-price-note" style="font-size:12.5px;letter-spacing:.02em;color:var(--text-muted);margin-top:6px"><span data-aa-price-incl>{{ price_prefix }}{% render 'aa-money', cents: disp_price %}</span> incl. 18% GST &middot; Complimentary delivery across India</div>
  {%- else -%}
    <div class="aa-price-note" style="font-size:12.5px;letter-spacing:.02em;color:var(--text-muted);margin-top:6px">Inclusive of GST &middot; Complimentary delivery across India</div>
  {%- endif -%}
{%- elsif visibility == 'project-only' -%}
  <div class="aa-price aa-price--enquire">Project pricing <span>Quoted per project</span></div>
{%- else -%}
  <div class="aa-price aa-price--enquire">Price on request <span>Shared on enquiry</span></div>
{%- endif -%}

{% render 'aa-onesize' %}

<script>
(function(){
  if(window.aaPriceSyncInit) return;
  window.aaPriceSyncInit = true;

  var EXG = {{ settings.aa_price_before_gst | json }};
  var PRICES = {
    {%- for v in product.variants -%}"{{ v.id }}": {{ v.price }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}
  };

  function money(rupees){
    try{ return new Intl.NumberFormat('en-IN',{style:'currency',currency:'INR',maximumFractionDigits:0}).format(rupees); }
    catch(e){ return '\\u20b9' + Math.round(rupees).toLocaleString('en-IN'); }
  }
  function paint(txt){
    document.querySelectorAll('[data-aa-price-display]').forEach(function(el){ el.textContent = txt; });
  }

  function start(){
    var form = document.querySelector('form[action*="/cart/add"]');
    if(!form) return;
    var idEl = form.querySelector('input[name="id"], select[name="id"]');
    if(!idEl) return;

    var last = String(idEl.value || '');

    function apply(id){
      var p = PRICES[id];
      if(typeof p === 'number') paint(money(p/100));
    }

    var rug = document.querySelector('[data-aa-rug]');
    if(rug){
      rug.addEventListener('click', function(e){
        var b = e.target.closest('[data-rug-size]');
        if(!b) return;
        if(b.dataset.custom){ paint('Priced on enquiry'); }
        else if(b.dataset.vid){ last = String(b.dataset.vid); apply(last); }
      });
    }

    setInterval(function(){
      var now = String(idEl.value || '');
      if(now === last) return;
      last = now;
      apply(now);
    }, 250);
  }

  if(document.readyState === 'loading'){ document.addEventListener('DOMContentLoaded', start); } else { start(); }

  /* GST watcher. Every script (this one, sofa/chair/rug configurators, add-on) writes
     the STORED GST-inclusive price as plain text. Convert any such price to the
     before-GST figure (÷ 1.18) and add "+ GST"; a price already carrying "GST" was
     written by the theme and is left alone. The incl.-GST note shows the stored price. */
  if(!EXG) return;
  var SEL = '.aa-price:not(.aa-price--enquire), [data-sticky-price], form[action*="/cart/add"] [type="submit"]';
  var RX = /₹[\s ]?([\d,]+)/;
  function decorate(){
    var inclText = null;
    document.querySelectorAll(SEL).forEach(function(el){
      var t = el.textContent || '';
      var m = t.match(RX);
      if(!m || /GST/.test(t)) return;
      var incl = +m[1].replace(/,/g,'');
      if(el.hasAttribute('data-aa-price-display') && inclText === null) inclText = (/From/.test(t) ? 'From ' : '') + money(incl);
      var ex = money(Math.round(incl * 100 / 118));
      var out = t.replace(RX, ex);
      if(el.classList.contains('aa-price')){
        el.textContent = out;
        var g = document.createElement('span');
        g.className = 'aa-price-gst';
        g.style.cssText = 'font-size:.6em;letter-spacing:.04em;margin-left:6px';
        g.textContent = '+ GST';
        el.appendChild(g);
      } else {
        el.textContent = out + ' + GST';
      }
    });
    if(inclText !== null){
      document.querySelectorAll('[data-aa-price-incl]').forEach(function(el){ if(el.textContent !== inclText) el.textContent = inclText; });
    }
    var head = document.querySelector('[data-aa-price-display]');
    var priced = head && RX.test(head.textContent || '');
    document.querySelectorAll('[data-aa-price-incl]').forEach(function(el){ var n = el.closest('.aa-price-note'); if(n) n.style.visibility = priced ? '' : 'hidden'; });
  }
  var queued = false;
  function queue(){ if(queued) return; queued = true; requestAnimationFrame(function(){ queued = false; decorate(); }); }
  function watch(){ decorate(); new MutationObserver(queue).observe(document.body, {subtree:true, childList:true, characterData:true}); }
  if(document.readyState === 'loading'){ document.addEventListener('DOMContentLoaded', watch); } else { watch(); }
})();
</script>
