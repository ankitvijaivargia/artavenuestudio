{%- if show_price -%}
  <div style="display:flex;align-items:baseline;gap:14px;flex-wrap:wrap;margin-top:16px">
    <span class="aa-price" style="margin-top:0">{% render 'aa-money', cents: product.price %}</span>
    {%- if caption != blank -%}<span class="aa-price-cap" style="margin-top:0">{{ caption }}</span>{%- endif -%}
  </div>
{%- elsif visibility == 'project-only' -%}
  <div class="aa-price aa-price--enquire">Project pricing <span>Quoted per project</span></div>
{%- else -%}
  <div class="aa-price aa-price--enquire">Price on request <span>Shared on enquiry</span></div>
{%- endif -%}
