{%- comment -%}
  Display price.
  Multi-variant products open on a From price computed across real variants;
  once the customer picks a size the exact price replaces it.
  Any variant whose title contains "Custom" is excluded from the From figure —
  rug custom sizes are priced per 0.1 sq ft and would otherwise dominate.
  Tracking is done by watching the cart form's variant input, so this works with
  the grid engine and the rug engine alike without knowing either one's markup.
{%- endcomment -%}
{%- assign disp_price = product.price -%}
{%- assign price_prefix = '' -%}
{%- assign lowest = 0 -%}{%- assign std_count = 0 -%}
{%- for v in product.variants -%}
  {%- unless v.title contains 'Custom' -%}
    {%- assign std_count = std_count | plus: 1 -%}
    {%- if lowest == 0 or v.price < lowest -%}{%- assign lowest = v.price -%}{%- endif -%}
  {%- endunless -%}
{%- endfor -%}
{%- if lowest > 0 -%}
  {%- assign disp_price = lowest -%}
  {%- if std_count > 1 -%}{%- assign price_prefix = 'From ' -%}{%- endif -%}
{%- endif -%}
{%- if show_price -%}
  <div style="display:flex;align-items:baseline;gap:14px;flex-wrap:wrap;margin-top:16px">
    <span class="aa-price" style="margin-top:0" data-aa-price-display>{{ price_prefix }}{% render 'aa-money', cents: disp_price %}</span>
    {%- if caption != blank -%}<span class="aa-price-cap" style="margin-top:0">{{ caption }}</span>{%- endif -%}
  </div>
{%- elsif visibility == 'project-only' -%}
  <div class="aa-price aa-price--enquire">Project pricing <span>Quoted per project</span></div>
{%- else -%}
  <div class="aa-price aa-price--enquire">Price on request <span>Shared on enquiry</span></div>
{%- endif -%}

{% render 'aa-onesize' %}

<script>
(function(){
  if(window.aaPriceSyncInit) return;
  window.aaPriceSyncInit = true;

  var PRICES = {
    {%- for v in product.variants -%}"{{ v.id }}": {{ v.price }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}
  };

  function money(rupees){
    try{ return new Intl.NumberFormat('en-IN',{style:'currency',currency:'INR',maximumFractionDigits:0}).format(rupees); }
    catch(e){ return '\\u20b9' + Math.round(rupees).toLocaleString('en-IN'); }
  }
  function paint(txt){
    document.querySelectorAll('[data-aa-price-display]').forEach(function(el){ el.textContent = txt; });
  }

  function start(){
    var form = document.querySelector('form[action*="/cart/add"]');
    if(!form) return;
    var idEl = form.querySelector('input[name="id"], select[name="id"]');
    if(!idEl) return;

    var last = String(idEl.value || '');

    function apply(id){
      var p = PRICES[id];
      if(typeof p === 'number') paint(money(p/100));
    }

    var rug = document.querySelector('[data-aa-rug]');
    if(rug){
      rug.addEventListener('click', function(e){
        var b = e.target.closest('[data-rug-size]');
        if(!b) return;
        if(b.dataset.custom){ paint('Priced on enquiry'); }
        else if(b.dataset.vid){ last = String(b.dataset.vid); apply(last); }
      });
    }

    setInterval(function(){
      var now = String(idEl.value || '');
      if(now === last) return;
      last = now;
      apply(now);
    }, 250);
  }

  if(document.readyState === 'loading'){ document.addEventListener('DOMContentLoaded', start); } else { start(); }
})();
</script>