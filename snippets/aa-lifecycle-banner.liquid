{%- case state -%}
{%- when 'coming-soon' -%}<div class="aa-lifecycle"><span class="aa-lifecycle__label">Coming Soon</span><p>Arriving soon — register your interest and we'll tell you the moment it's available.</p></div>
{%- when 'seasonal' -%}<div class="aa-lifecycle"><span class="aa-lifecycle__label">Seasonal</span><p>A seasonal piece, available for a limited time.</p></div>
{%- when 'discontinued' -%}<div class="aa-lifecycle" style="background:var(--surface-alt);border-color:var(--border-strong)"><span class="aa-lifecycle__label" style="color:var(--text-muted)">Discontinued</span><p>This piece has been discontinued. Speak with a consultant about current alternatives.</p></div>
{%- endcase -%}
