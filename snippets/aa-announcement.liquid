{%- comment -%}
  Homepage: a single static line pointing customers to The Archive (artavenue.in) —
  block-printed rugs & runners, cushions, textiles and décor.
  Until 15 Nov 2026 it runs Diwali copy, then switches back to the evergreen line automatically.
  All other pages: the usual brand messages.
{%- endcomment -%}
{%- if request.page_type == 'index' -%}
  {%- assign aa_today = 'now' | date: '%Y%m%d' | plus: 0 -%}
  {%- if aa_today <= 20261115 -%}
    {%- assign aa_archive_url = 'https://www.artavenue.in/?utm_source=artavenue.com&utm_medium=referral&utm_campaign=archive_announcement_diwali' -%}
    {%- assign aa_lead = 'Dress your home for Diwali' -%}
    {%- assign aa_ask = 'Block-printed rugs, runners, cushions &amp; d&eacute;cor for gifting and hosting' -%}
    {%- assign aa_cta = 'Shop The Archive' -%}
  {%- else -%}
    {%- assign aa_archive_url = 'https://www.artavenue.in/?utm_source=artavenue.com&utm_medium=referral&utm_campaign=archive_announcement' -%}
    {%- assign aa_lead = 'Art Avenue is now a design house for handcrafted furniture &amp; hand-tufted rugs' -%}
    {%- assign aa_ask = 'Looking for our block-printed rugs, runners, cushions &amp; d&eacute;cor?' -%}
    {%- assign aa_cta = 'Visit The Archive' -%}
  {%- endif -%}
  <div class="aa-announce aa-announce--archive">
    <p class="aa-announce-archive">
      <span class="aa-announce-archive__lead">{{ aa_lead }}</span>
      <span class="aa-announce-archive__sep" aria-hidden="true">&middot;</span>
      <span class="aa-announce-archive__ask">{{ aa_ask }}</span>
      <a href="{{ aa_archive_url }}" target="_blank" rel="noopener" class="aa-announce-archive__link">{{ aa_cta }}&nbsp;&rarr;</a>
    </p>
  </div>
  <style>
    .aa-announce--archive{display:flex;align-items:center;justify-content:center;min-height:35px;padding:8px 16px;box-sizing:border-box}
    .aa-announce-archive{margin:0;text-align:center;font-family:Jost,ui-sans-serif,system-ui,sans-serif;font-size:11px;font-weight:400;letter-spacing:.14em;text-transform:uppercase;line-height:1.6;color:inherit}
    .aa-announce-archive__sep{opacity:.4;margin:0 14px}
    .aa-announce-archive__ask{opacity:.75}
    .aa-announce-archive__link{color:inherit;margin-left:6px;text-decoration:underline;text-underline-offset:3px;text-decoration-thickness:1px;white-space:nowrap}
    .aa-announce-archive__link:hover{opacity:.75}
    @media (max-width:899px){
      .aa-announce-archive__lead,.aa-announce-archive__sep{display:none}
      .aa-announce-archive{font-size:10px;letter-spacing:.1em}
    }
  </style>
{%- else -%}
{%- capture aa_msgs -%}
  <span>Complimentary design consultation</span>
  <span><span style="opacity:.4">&middot;</span> Handcrafted in India, made to order</span>
  <span><span style="opacity:.4">&middot;</span> Custom sizes on request</span>
{%- endcapture -%}
<div class="aa-announce">
  <div class="aa-announce__track">
    <div class="aa-announce__set">{{ aa_msgs }}</div>
    <div class="aa-announce__set aa-announce__set--dup" aria-hidden="true">{{ aa_msgs }}</div>
  </div>
</div>
{%- endif -%}
