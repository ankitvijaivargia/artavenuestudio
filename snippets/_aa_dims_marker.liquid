.aa-sofa__dims{display:flex;justify-content:center;align-items:baseline;flex-wrap:wrap;gap:6px 10px;margin:0 0 14px;padding:11px 14px;border:1px solid var(--border-hairline);border-radius:var(--radius-xs);background:var(--surface-raised);text-align:center;}
.aa-sofa__dims[hidden]{display:none;}
.aa-sofa__dims .ph-ruler{color:var(--accent-deep);font-size:15px;align-self:center;}
.aa-sofa__dims-cm{font-family:var(--font-sans);font-size:13.5px;font-weight:500;color:var(--text-primary);font-feature-settings:"lnum" 1,"tnum" 1;white-space:nowrap;}
.aa-sofa__dims-in{font-size:12px;color:var(--text-muted);font-feature-settings:"lnum" 1,"tnum" 1;white-space:nowrap;}