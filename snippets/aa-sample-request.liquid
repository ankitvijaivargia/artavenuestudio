{%- comment -%} Sample request tiles. params: product {%- endcomment -%}
{%- assign t = product.type | downcase -%}
{%- if t contains 'rug' -%}{%- assign tiles = "Material|ph-swatches,Colour|ph-palette" | split: "," -%}
{%- elsif t contains 'cushion' -%}{%- assign tiles = "Fabric|ph-scissors,Material|ph-swatches" | split: "," -%}
{%- elsif t contains 'furniture' or t contains 'seating' -%}{%- assign tiles = "Fabric|ph-scissors,Finish|ph-paint-roller,Material|ph-swatches" | split: "," -%}
{%- else -%}{%- assign tiles = "Material|ph-swatches" | split: "," -%}{%- endif -%}
<div class="aa-samples">
  <div class="aa-samples__h">Request a sample</div>
  <div class="aa-samples__sub">From <strong style="color:var(--text-primary);font-weight:600">&#8377;999</strong> per sample &middot; &#8377;999&ndash;&#8377;2,999 depending on fabric, finish or material.</div>
  <div class="aa-samples__grid" style="grid-template-columns:repeat({{ tiles.size }},1fr)">
    {%- for tile in tiles -%}{%- assign tp = tile | split: "|" -%}
      {%- capture h -%}{% render 'aa-lead-url', type:'samples', product: product, message: tp[0] %}{%- endcapture -%}
      <a class="aa-samples__tile" href="{{ h | strip }}" target="_blank" rel="noopener"><i class="ph-light {{ tp[1] }}"></i><span>{{ tp[0] }}</span></a>
    {%- endfor -%}
  </div>
</div>
