{%- comment -%} Art Avenue — Related / You may also like {%- endcomment -%}
{%- assign coll = product.collections.first -%}
{%- if coll -%}
<section class="module module--related">
  <p class="aa-eyebrow module__eyebrow">Explore</p>
  <h2 class="aa-h2">You may also like</h2>
  <div class="aa-tiles aa-tiles--4" style="margin-top:var(--space-lg)">
    {%- assign shown = 0 -%}
    {%- for pr in coll.products -%}
      {%- if pr.id != product.id and shown < 4 -%}
        {%- render 'aa-product-card', product: pr -%}
        {%- assign shown = shown | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>
{%- endif -%}
