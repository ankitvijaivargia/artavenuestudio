<footer class="aa-footer">
  <div class="aa-footer__news"><div class="aa-wrap">
    <div>
      <span class="aa-eyebrow aa-eyebrow--on-dark">The Art Avenue Letter</span>
      <h3 class="serif" style="font-size:34px;margin-top:14px;line-height:1.1;font-weight:500">New pieces from the atelier, <em class="accent">first.</em></h3>
    </div>
    {% form 'customer' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div style="display:flex;gap:12px;align-items:stretch">
        <input class="aa-input" type="email" name="contact[email]" placeholder="Your email address" aria-label="Email address" required>
        <button class="btn btn--secondary btn--on-dark" type="submit">Subscribe</button>
      </div>
      {%- if form.posted_successfully? -%}<p style="margin-top:10px;font-size:13px;color:var(--text-on-dark-muted)">Thank you — you're on the list.</p>{%- endif -%}
    {% endform %}
  </div></div>
  <div class="aa-footer__cols">
    <div class="aa-footer__brand">
      <b>Art Avenue</b>
      <p>A design house making handcrafted furniture in leather, vintage kilim, cane and solid wood — made to order in India, and made to be handed down.</p>
      <p style="margin-top:14px"><a href="https://wa.me/{{ settings.wa_number | default: '919828080095' }}" target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:8px"><i class="ph-light ph-whatsapp-logo" style="font-size:18px"></i> WhatsApp us</a></p>
    </div>
    <div><h4>Shop</h4><ul><li><a href="/collections/furniture">All Furniture</a></li><li><a href="/collections/sofas">Sofas</a></li><li><a href="/collections/beds">Beds</a></li><li><a href="/collections/coffee-tables">Coffee Tables</a></li><li><a href="/collections/sideboards">Sideboards</a></li><li><a href="/collections/kilim-leather">Kilim &amp; Leather</a></li><li><a href="/collections/new-arrivals">New Arrivals</a></li></ul></div>
    <div><h4>Discover</h4><ul><li><a href="/pages/atelier">Inside the Atelier</a></li><li><a href="/pages/materials">Materials Library</a></li><li><a href="/pages/custom">Bespoke &amp; Made to Measure</a></li><li><a href="/products/swatch">Order Swatches</a></li></ul></div>
    <div><h4>Trade</h4><ul><li><a href="/pages/trade">Trade &amp; Projects</a></li><li><a href="/pages/enquiry">Project Enquiry</a></li></ul></div>
    <div><h4>Service</h4><ul><li><a href="/pages/contact">Contact &amp; Showroom</a></li><li><a href="/policies/shipping-policy">Delivery</a></li><li><a href="/policies/refund-policy">Returns &amp; Cancellations</a></li><li><a href="/policies/terms-of-service">Terms of Service</a></li></ul></div>
  </div>
  <div class="aa-footer__trust"><div class="aa-wrap">
    <span>&copy; {{ 'now' | date: '%Y' }} Art Avenue Design House &middot; Handcrafted in India</span>
    <span style="display:flex;gap:24px"><a href="/policies/privacy-policy">Privacy</a><a href="/policies/terms-of-service">Terms</a></span>
  </div></div>
</footer>
