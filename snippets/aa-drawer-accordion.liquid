{%- comment -%} Mobile drawer accordion — shows only groups listed in `show`. {%- endcomment -%}
<details class="aa-dacc">
  <summary class="aa-dacc__sum">
    <span class="aa-dacc__label">{{ label }}</span>
    <a class="aa-dacc__go" href="{{ url }}" aria-label="Go to {{ label }}" onclick="event.stopPropagation();"><i class="ph ph-arrow-right"></i></a>
    <i class="ph ph-caret-down aa-dacc__chev"></i>
  </summary>
  <div class="aa-dacc__body">
    {%- assign allow = show | split: ',' -%}
    {%- if rail != blank -%}{%- assign groups = rail | split: '~' -%}{%- else -%}{%- assign groups = cols | split: '~' -%}{%- endif -%}
    {%- for g in groups -%}{%- assign gp = g | split: '^' -%}
      {%- assign gname = gp[0] -%}
      {%- if allow contains gname -%}
        {%- if rail != blank -%}{%- assign items = gp[2] -%}{%- else -%}{%- assign items = gp[1] -%}{%- endif -%}
        <span class="aa-dacc__group">{{ gname }}</span>
        <div class="aa-dacc__links">{%- assign pairs = items | split: ';' -%}{%- for p in pairs -%}{%- assign pp = p | split: '|' -%}<a href="{{ pp[1] }}">{{ pp[0] }}</a>{%- endfor -%}</div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</details>