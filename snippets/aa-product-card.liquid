{%- comment -%} params: product (object) OR ph_* placeholder fields (ph_name, ph_price, ph_cat, ph_tone) {%- endcomment -%}
{%- if product -%}
  {%- assign badge = product.metafields.aav.commerce_badge -%}
  {%- assign v = product.selected_or_first_available_variant -%}
  {%- comment -%} resolve fulfillment: explicit metafield, else by type (mirrors PDP) {%- endcomment -%}
  {%- assign ful = product.metafields.aav.fulfillment -%}
  {%- unless ful -%}
    {%- case product.type -%}
      {%- when 'Lighting' -%}{%- assign ful = 'in-stock' -%}
      {%- when 'Decor' -%}{%- assign ful = 'in-stock' -%}
      {%- else -%}{%- assign ful = 'made-to-order' -%}
    {%- endcase -%}
  {%- endunless -%}
  {%- assign ful_label = '' -%}
  {%- case ful -%}
    {%- when 'made-to-order' -%}{%- assign ful_label = 'Made to Order' -%}
    {%- when 'custom' -%}{%- assign ful_label = 'Custom Order' -%}
    {%- when 'project' -%}{%- assign ful_label = 'Project Enquiry' -%}
  {%- endcase -%}
  {%- comment -%} From price across real variants; custom-size variants never lead {%- endcomment -%}
  {%- assign card_price = product.price -%}{%- assign card_prefix = '' -%}
  {%- assign card_low = 0 -%}{%- assign card_n = 0 -%}
  {%- for cv in product.variants -%}
    {%- unless cv.title contains 'Custom' -%}
      {%- assign card_n = card_n | plus: 1 -%}
      {%- if card_low == 0 or cv.price < card_low -%}{%- assign card_low = cv.price -%}{%- endif -%}
    {%- endunless -%}
  {%- endfor -%}
  {%- if card_low > 0 -%}
    {%- assign card_price = card_low -%}
    {%- if card_n > 1 -%}{%- assign card_prefix = 'From ' -%}{%- endif -%}
  {%- endif -%}
  <div class="aa-pcard-wrap">
    <a class="aa-pcard" href="{{ product.url }}">
      <div class="aa-pcard__media">
        {%- if product.featured_image -%}
          <div class="aa-fig aa-full-bg"><img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy"></div>
        {%- else -%}{% render 'aa-figure', tone: 'clay', class: 'aa-full-bg' %}{%- endif -%}
        {%- if badge -%}<span class="aa-pcard__badge"><span class="aa-badge aa-badge--on-image">{{ badge }}</span></span>{%- endif -%}
        <button type="button" class="aa-pcard__fav" aria-label="Save to wishlist" onclick="event.preventDefault();event.stopPropagation();this.classList.toggle('is-saved');"><i class="ph ph-heart"></i></button>
      </div>
      <div class="aa-pcard__body">
        {%- if product.type != blank -%}<div class="aa-pcard__cat">{{ product.type }}</div>{%- endif -%}
        <div class="aa-pcard__name">{{ product.title }}</div>
        <div class="aa-pcard__price">{% if card_price > 0 %}{{ card_prefix }}{% render 'aa-money', cents: card_price %}{% else %}Price on request{% endif %}</div>
        {%- if ful_label != blank -%}<div class="aa-pcard__ful">{{ ful_label }}</div>{%- endif -%}
      </div>
    </a>
    {%- if product.has_only_default_variant and v.available and product.price > 0 -%}
      <button type="button" class="aa-pcard__add" data-vid="{{ v.id }}" aria-label="Add {{ product.title | escape }} to cart" onclick="window.aaQuickAdd&&window.aaQuickAdd(this)">Add to cart</button>
    {%- else -%}
      <a class="aa-pcard__add aa-pcard__add--opts" href="{{ product.url }}">Choose options</a>
    {%- endif -%}
  </div>
{%- else -%}
  <div class="aa-pcard">
    <div class="aa-pcard__media">{% render 'aa-figure', tone: ph_tone, class: 'aa-full-bg' %}{% if ph_badge != blank %}<span class="aa-pcard__badge"><span class="aa-badge aa-badge--on-image">{{ ph_badge }}</span></span>{% endif %}</div>
    <div class="aa-pcard__body"><div class="aa-pcard__cat">{{ ph_cat }}</div><div class="aa-pcard__name">{{ ph_name }}</div><div class="aa-pcard__price">{{ ph_price }}{% if ph_note != blank %} <span style="color:var(--text-muted);margin-left:6px">{{ ph_note }}</span>{% endif %}</div></div>
  </div>
{%- endif -%}