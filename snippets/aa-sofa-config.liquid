{%- comment -%}
  Art Avenue — Sofa configurator.
  Renders Size (variant option 1) + Material (variant option 2) as buttons,
  keeps the real variant id synced, shows live price, and a branching
  Colour / Fabric picker that opens the customize modal with the right set.
  params: product
  Requires options named "Size" and "Material" with Material values Fabric / Leather.
{%- endcomment -%}

{%- comment -%} ----- EDITABLE PLACEHOLDER SWATCH DATA (swap for metaobjects later) ----- {%- endcomment -%}
{%- comment -%} format: Name|Category|hex|swatchPrice|surcharge {%- endcomment -%}
{%- assign sofa_leathers = "Espresso|Leather|#3d2417|2000|0,Cognac|Leather|#7a4424|2000|0,Tan|Leather|#a0673b|2000|0,Black|Leather|#211c19|2000|0,Forest Green|Leather|#2f4034|2000|0,Oxblood|Leather|#5e2330|2000|0" | split: "," -%}
{%- assign sofa_fabrics = "Belgian Linen Oat|Linen|#d8cdb6|2000|0,Belgian Linen Stone|Linen|#b7b09c|2000|0,Cotton Ivory|Solid|#ece4d4|2000|0,Cotton Charcoal|Solid|#3a3a3a|2000|0,Performance Pebble|Performance|#9a9384|2000|0,Boucle Cream|Boucle|#e3dccb|2000|0,Velvet Emerald|Velvet|#1f4d3f|2000|0,Velvet Wine|Velvet|#5e2330|2000|0" | split: "," -%}

{%- assign opt_size = '' -%}{%- assign opt_mat = '' -%}
{%- assign size_pos = 0 -%}{%- assign mat_pos = 0 -%}
{%- for o in product.options_with_values -%}
  {%- if o.name == 'Size' -%}{%- assign opt_size = o -%}{%- assign size_pos = o.position -%}{%- endif -%}
  {%- if o.name == 'Material' -%}{%- assign opt_mat = o -%}{%- assign mat_pos = o.position -%}{%- endif -%}
{%- endfor -%}

{%- if opt_size != '' and opt_mat != '' -%}
<div class="aa-sofa" id="aaSofa">

  {%- comment -%} SIZE {%- endcomment -%}
  <div class="aa-sofa__group">
    <div class="aa-sofa__label"><span>Size</span><span class="aa-sofa__hint" data-sofa-sizehint>{{ opt_size.selected_value }}</span></div>
    <div class="aa-sofa__btns">
      {%- for v in opt_size.values -%}
        <button type="button" class="aa-sofa__btn{% if v == opt_size.selected_value %} is-active{% endif %}" data-sofa-size="{{ v | escape }}">{{ v }}</button>
      {%- endfor -%}
    </div>
    <button type="button" class="aa-sofa__custom" data-cz-consult>
      <i class="ph ph-ruler"></i> Need an L-shape or a custom size? <span>Speak with a design consultant ›</span>
    </button>
  </div>

  {%- comment -%} MATERIAL {%- endcomment -%}
  <div class="aa-sofa__group">
    <div class="aa-sofa__label"><span>Material</span><span class="aa-sofa__hint" data-sofa-mathint>{{ opt_mat.selected_value }}</span></div>
    <div class="aa-sofa__btns">
      {%- for v in opt_mat.values -%}
        <button type="button" class="aa-sofa__btn{% if v == opt_mat.selected_value %} is-active{% endif %}" data-sofa-mat="{{ v | escape }}">{{ v }}</button>
      {%- endfor -%}
    </div>
  </div>

  {%- comment -%} COLOUR / FABRIC — opens modal; group switches with material {%- endcomment -%}
  <div class="aa-sofa__group">
    <button type="button" class="aa-cz-row" id="aaSofaSwatchRow" data-cz-open="sofaopt">
      <span class="aa-cz-row__k" data-sofa-swlabel>Colour</span>
      <span class="aa-cz-row__v"><span class="aa-cz-row__sw" data-sofa-swcolor style="background:#3d2417"></span><span data-cz-selname="sofaopt">Choose</span><i class="ph ph-caret-right"></i></span>
    </button>
    <div class="aa-sofa__swsub" data-sofa-swsub>Choose your leather colour, or order a swatch from &#8377;2,000 to feel it first.</div>
  </div>

  {%- comment -%} variant price map written directly as JS (no JSON.parse, no escaping risk) {%- endcomment -%}
  <script>
  window.AA_SOFA_VARIANTS = window.AA_SOFA_VARIANTS || {};
  window.AA_SOFA_VARIANTS["{{ product.id }}"] = {
    {%- for v in product.variants -%}
      {%- if size_pos == 1 -%}{%- assign sz = v.option1 -%}{%- elsif size_pos == 2 -%}{%- assign sz = v.option2 -%}{%- else -%}{%- assign sz = v.option3 -%}{%- endif -%}
      {%- if mat_pos == 1 -%}{%- assign mt = v.option1 -%}{%- elsif mat_pos == 2 -%}{%- assign mt = v.option2 -%}{%- else -%}{%- assign mt = v.option3 -%}{%- endif -%}
      {{ sz | append: '|||' | append: mt | json }}: { id: {{ v.id }}, price: {{ v.price | times: 1 }}, available: {{ v.available }} }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  };
  </script>

  {%- comment -%} swatch sets for the modal, keyed by material {%- endcomment -%}
  <script type="application/json" id="aa-sofa-swatches">
  {
    "Leather": { "label":"Leather colour", "items":[
      {%- for it in sofa_leathers -%}{%- assign p = it | split:'|' -%}{"name":{{ p[0]|json }},"cat":{{ p[1]|json }},"hex":{{ p[2]|json }},"swatch":{{ p[3]|json }},"surcharge":{{ p[4]|json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}
    ]},
    "Fabric": { "label":"Fabric", "items":[
      {%- for it in sofa_fabrics -%}{%- assign p = it | split:'|' -%}{"name":{{ p[0]|json }},"cat":{{ p[1]|json }},"hex":{{ p[2]|json }},"swatch":{{ p[3]|json }},"surcharge":{{ p[4]|json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}
    ]}
  }
  </script>
</div>

<script>
(function(){
  var root = document.getElementById('aaSofa');
  if(!root) return;
  var vmap = (window.AA_SOFA_VARIANTS && window.AA_SOFA_VARIANTS["{{ product.id }}"]) || {};
  var sw={};
  try{ sw = JSON.parse(document.getElementById('aa-sofa-swatches').textContent); }catch(e){}

  var state = { size:null, mat:null, swatch:{} };
  var aSize=root.querySelector('[data-sofa-size].is-active'); if(aSize) state.size=aSize.getAttribute('data-sofa-size');
  var aMat=root.querySelector('[data-sofa-mat].is-active'); if(aMat) state.mat=aMat.getAttribute('data-sofa-mat');
  // Fallback: if nothing seeded as active, use the first buttons
  if(!state.size){ var fs=root.querySelector('[data-sofa-size]'); if(fs){ state.size=fs.getAttribute('data-sofa-size'); fs.classList.add('is-active'); } }
  if(!state.mat){ var fm=root.querySelector('[data-sofa-mat]'); if(fm){ state.mat=fm.getAttribute('data-sofa-mat'); fm.classList.add('is-active'); } }

  function norm(s){ return (s==null?'':String(s)).trim(); }
  function money(v){
    // theme prices are in cents/paise (see aa-money.liquid). Always /100.
    var n=(Number(v)||0)/100;
    return '\u20B9 ' + Math.round(n).toLocaleString('en-IN');
  }
  function currentVariant(){
    var key = norm(state.size)+'|||'+norm(state.mat);
    if(vmap[key]) return vmap[key];
    // fallback: scan keys ignoring case/space
    for(var k in vmap){ if(norm(k).toLowerCase()===key.toLowerCase()) return vmap[k]; }
    return null;
  }
  function form(){ return document.querySelector('.aa-buyrow form') || document.querySelector('form[action*="/cart/add"]'); }

  function setHiddenId(id){
    var f=form(); if(!f) return;
    var inp=f.querySelector('input[name="id"], select[name="id"]');
    if(inp && inp.tagName==='SELECT'){ inp.value=id; }
    else { if(!inp){ inp=document.createElement('input'); inp.type='hidden'; inp.name='id'; f.appendChild(inp); } inp.value=id; }
  }
  function updatePrice(){
    var v=currentVariant(); if(!v) return;
    setHiddenId(v.id);
    var f=form(); var btn=f && f.querySelector('button[type="submit"]');
    if(btn){ btn.innerHTML = 'Add to Cart &middot; ' + money(v.price); }
    document.querySelectorAll('.aa-price').forEach(function(el){
      if(el.classList.contains('aa-price--enquire')) return;
      el.textContent = money(v.price);
    });
  }
  function refreshSwatchRow(){
    var isLeather = state.mat==='Leather';
    var set = sw[state.mat] || sw['Fabric'];
    var lbl=root.querySelector('[data-sofa-swlabel]');
    var sub=root.querySelector('[data-sofa-swsub]');
    if(lbl) lbl.textContent = isLeather ? 'Colour' : 'Fabric';
    if(sub) sub.textContent = (isLeather?'Choose your leather colour':'Choose your fabric')+', or order a swatch from \u20B92,000 to feel it first.';
    if(window.aaCz && set){ window.aaCz.register('sofaopt', { label: set.label, items: set.items }); }
    var chosen = state.swatch[state.mat];
    var first = set && set.items && set.items[0];
    var nm=root.querySelector('[data-cz-selname="sofaopt"]');
    var dot=root.querySelector('[data-sofa-swcolor]');
    var show = chosen || first;
    if(nm) nm.textContent = chosen ? chosen.name : 'Choose';
    if(dot && show) dot.style.background = show.hex;
  }

  root.addEventListener('click', function(e){
    var s=e.target.closest('[data-sofa-size]');
    var m=e.target.closest('[data-sofa-mat]');
    if(s){
      state.size=s.getAttribute('data-sofa-size');
      root.querySelectorAll('[data-sofa-size]').forEach(function(b){ b.classList.toggle('is-active', b===s); });
      var h=root.querySelector('[data-sofa-sizehint]'); if(h) h.textContent=state.size;
      updatePrice();
    }
    if(m){
      state.mat=m.getAttribute('data-sofa-mat');
      root.querySelectorAll('[data-sofa-mat]').forEach(function(b){ b.classList.toggle('is-active', b===m); });
      var h2=root.querySelector('[data-sofa-mathint]'); if(h2) h2.textContent=state.mat;
      updatePrice();
      refreshSwatchRow();
    }
  });

  if(window.aaCz){
    window.aaCz.onChoose(function(group, item){
      if(group!=='sofaopt') return;
      state.swatch[state.mat]=item;
      var nm=root.querySelector('[data-cz-selname="sofaopt"]'); if(nm) nm.textContent=item.name;
      var dot=root.querySelector('[data-sofa-swcolor]'); if(dot) dot.style.background=item.hex;
      var f=form(); if(f){
        var id='aa-prop-sofaopt'; var inp=f.querySelector('#'+id);
        if(!inp){ inp=document.createElement('input'); inp.type='hidden'; inp.id=id; f.appendChild(inp); }
        inp.name='properties['+(state.mat==='Leather'?'Leather colour':'Fabric')+']';
        inp.value=item.name;
      }
    });
  }

  var customBtn=root.querySelector('[data-cz-consult]');
  if(customBtn){ customBtn.addEventListener('click', function(){
    var consult=document.querySelector('.aa-cta-secondary a, a[href*="/pages/enquiry"], a[href*="wa.me"]');
    if(consult){ consult.scrollIntoView({behavior:'smooth',block:'center'}); }
  }); }

  updatePrice(); refreshSwatchRow();
})();
</script>
{%- endif -%}
