{%- comment -%}
  Art Avenue — PDP add-on ("Add matching side tables").
  Renders ONLY when the product carries aav.addon (json):
    { "handle": "<add-on product handle>", "heading": "...", "teaser": "₹20,000 each",
      "name": "display name", "size": "55 W × 45 D × 62 H cm each", "note": "...",
      "default": "<option1 pre-selected>", "labels": { "<option1>": "display label" },
      "crop": { "size": "537.6%", "pos": "1.5% 64.7%", "ratio": "226 / 434" },
      "properties": { "Paint Finish": "Ivory" },
      "inherit": [ "Wood Finish" ] }
  The add-on product is a cart vehicle only: keep it UNLISTED (hidden from search and
  collections, still resolvable here by handle). The customer never visits its page — there
  are no links to it. "crop" shows a region of the add-on's featured image (used while the
  only photo of the piece is a room shot); omit it to show the whole image.

  Collapsed to one line until ticked; ticking reveals image, size and the Single/Pair choice.
  Adds to cart via a capture-phase submit listener on every /cart/add form (main buy form AND
  sticky bar): posts the add-on to /cart/add.js first, then re-submits the original form so the
  parent product's own flow runs untouched. Every key named in "properties" or "inherit" is
  copied from the parent's matching properties[...] input when present, so the add-on carries
  the finish the customer actually picked ("properties" values are the fallback). Fails open:
  if the add-on request errors, the parent product is still added.

  Order summary: while ticked, a summary at the foot of the panel (directly above the CTA)
  shows the parent's selected variant, the add-on choice and the combined total. The parent
  variant is read from the buy form's [name="id"] against a variant price map rendered here;
  it re-reads on any click/change and on a light poll, because the configurator can set the
  variant id without firing an event. Fails safe: if the variant cannot be resolved the
  summary stays hidden. The product's own price display is never touched.
{%- endcomment -%}
{%- assign ad = product.metafields.aav.addon.value -%}
{%- if ad and ad.handle != blank -%}
{%- assign ap = all_products[ad.handle] -%}
{%- if ap and ap.id and ap.available -%}
{%- assign def = ad.default | default: ap.variants.first.option1 -%}
{%- capture aa_vmap -%}{ {%- for v in product.variants -%}{%- assign parts = '' -%}{%- for o in product.options_with_values -%}{%- if o.values.size > 1 -%}{%- assign val = v.options[forloop.index0] -%}{%- if parts == '' -%}{%- assign parts = val -%}{%- else -%}{%- assign parts = parts | append: ', ' | append: val -%}{%- endif -%}{%- endif -%}{%- endfor -%}"{{ v.id }}":{"p":{{ v.price }},"l":{{ parts | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%} }{%- endcapture -%}
<div class="aa-addon" data-aa-addon data-parent="{{ product.title | escape }}" data-ptype="{{ product.type | default: 'Main piece' | escape }}" data-props="{{ ad.properties | json | escape }}" data-inherit="{{ ad.inherit | json | escape }}">
  <label class="aa-addon__head">
    <input type="checkbox" class="aa-addon__check" data-aa-addon-on aria-controls="aaAddonPanel">
    <span class="aa-addon__title">{{ ad.heading | default: 'Add the matching piece' }}</span>
    {%- if ad.teaser != blank -%}<span class="aa-addon__teaser">{{ ad.teaser }}</span>{%- endif -%}
  </label>
  <div class="aa-addon__panel" id="aaAddonPanel">
    <div class="aa-addon__card">
      {%- if ap.featured_image -%}
        {%- if ad.crop -%}
          <div class="aa-addon__img" role="img" aria-label="{{ ad.name | default: ap.title | escape }}" style="aspect-ratio:{{ ad.crop.ratio }};background-image:url('{{ ap.featured_image | image_url: width: 1400 }}');background-size:{{ ad.crop.size }} auto;background-position:{{ ad.crop.pos }}"></div>
        {%- else -%}
          <div class="aa-addon__img"><img src="{{ ap.featured_image | image_url: width: 400 }}" alt="{{ ad.name | default: ap.title | escape }}" loading="lazy"></div>
        {%- endif -%}
      {%- endif -%}
      <div class="aa-addon__body">
        <div class="aa-addon__name">{{ ad.name | default: ap.title }}</div>
        {%- if ad.size != blank -%}<div class="aa-addon__size"><i class="ph ph-ruler" aria-hidden="true"></i>{{ ad.size }}</div>{%- endif -%}
        <div class="aa-addon__opts" role="radiogroup" aria-label="{{ ad.name | default: ap.title | escape }}">
          {%- for v in ap.variants -%}
          {%- assign lbl = v.option1 -%}{%- if ad.labels and ad.labels[v.option1] -%}{%- assign lbl = ad.labels[v.option1] -%}{%- endif -%}
          <label class="aa-addon__opt">
            <input type="radio" name="aa-addon-v" value="{{ v.id }}" data-price="{{ v.price }}" data-label="{{ lbl | escape }}"{% if v.option1 == def %} checked{% endif %}>
            <span class="aa-addon__optname">{{ lbl }}</span>
            <span class="aa-addon__optprice">+ {% render 'aa-money', cents: v.price %}</span>
          </label>
          {%- endfor -%}
        </div>
        {%- if ad.note != blank -%}<p class="aa-addon__note">{{ ad.note }}</p>{%- endif -%}
      </div>
    </div>
    <div class="aa-addon__sum" data-aa-sum aria-live="polite">
      <div class="aa-addon__row"><span data-sum-pl></span><span data-sum-pp></span></div>
      <div class="aa-addon__row"><span data-sum-al></span><span data-sum-ap></span></div>
      <div class="aa-addon__row aa-addon__row--tot"><span>Total</span><span data-sum-tot></span></div>
    </div>
  </div>
  <script type="application/json" data-aa-addon-vmap>{{ aa_vmap }}</script>
</div>
<style>
  .aa-addon{margin:14px 0 0;border:1px solid var(--border-subtle,rgba(0,0,0,.12));border-radius:10px;background:var(--surface-raised);padding:14px 16px}
  .aa-addon__head{display:flex;align-items:center;gap:10px;cursor:pointer;font-size:14px;font-weight:500}
  .aa-addon__check{width:18px;height:18px;accent-color:var(--text-accent);flex:none;margin:0}
  .aa-addon__title{flex:1}
  .aa-addon__teaser{font-weight:400;font-size:13px;color:var(--text-secondary);white-space:nowrap}
  .aa-addon__panel{display:none}
  .aa-addon.is-on .aa-addon__panel{display:block}
  .aa-addon__card{display:flex;gap:16px;margin-top:14px;align-items:flex-start}
  .aa-addon__img{flex:none;width:112px;aspect-ratio:3/4;border-radius:6px;overflow:hidden;background-color:var(--surface-alt,#f3eee6);background-repeat:no-repeat}
  .aa-addon__img img{width:100%;height:100%;object-fit:cover;display:block}
  .aa-addon__body{flex:1;min-width:0}
  .aa-addon__name{font-size:14px;font-weight:500}
  .aa-addon__size{display:flex;align-items:center;gap:6px;margin-top:4px;font-size:13px;color:var(--text-secondary)}
  .aa-addon__size i{color:var(--text-accent)}
  .aa-addon__opts{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}
  .aa-addon__opt{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--border-subtle,rgba(0,0,0,.14));border-radius:999px;padding:6px 12px;font-size:13px;cursor:pointer}
  .aa-addon__opt input{accent-color:var(--text-accent);margin:0}
  .aa-addon__optprice{color:var(--text-secondary)}
  .aa-addon__note{margin:10px 0 0;font-size:12.5px;line-height:1.55;color:var(--text-secondary)}
  .aa-addon__sum{display:none;margin-top:14px;padding-top:12px;border-top:1px solid var(--border-subtle,rgba(0,0,0,.12));font-size:13px}
  .aa-addon__sum.is-shown{display:block}
  .aa-addon__row{display:flex;justify-content:space-between;align-items:baseline;gap:12px;padding:3px 0;color:var(--text-secondary)}
  .aa-addon__row span:last-child{white-space:nowrap;font-variant-numeric:tabular-nums}
  .aa-addon__row--tot{color:var(--text-primary,inherit);font-weight:500;font-size:14px;margin-top:4px}
</style>
<script>
(function(){
  if(window.aaAddonInit) return; window.aaAddonInit=true;
  var box=document.querySelector('[data-aa-addon]');
  if(!box) return;
  var on=box.querySelector('[data-aa-addon-on]');
  var sum=box.querySelector('[data-aa-sum]');
  var vmap={};
  try{ var vm=box.querySelector('[data-aa-addon-vmap]'); vmap=JSON.parse(vm ? vm.textContent : '{}')||{}; }catch(x){ vmap={}; }
  var ptype=box.getAttribute('data-ptype')||'';
  var last='';
  function fmt(c){ return '\u20b9\u00a0'+Math.round((+c||0)/100).toLocaleString('en-IN'); }
  function curId(){
    var el=document.querySelector('.aa-buybox form[action*="/cart/add"] [name="id"]')||document.querySelector('form[action*="/cart/add"] [name="id"]');
    return el ? String(el.value||'') : '';
  }
  function txt(sel,v){ var n=sum.querySelector(sel); if(n && n.textContent!==v) n.textContent=v; }
  function render(){
    if(!sum) return;
    var r=box.querySelector('input[name="aa-addon-v"]:checked');
    var id=curId(), pv=vmap[id];
    if(!on || !on.checked || !r || !pv){ sum.classList.remove('is-shown'); last=''; return; }
    var key=id+'|'+r.value;
    if(key===last) return;
    last=key;
    var addP=+r.getAttribute('data-price')||0;
    txt('[data-sum-pl]', ptype + (pv.l ? ' \u00b7 '+pv.l : ''));
    txt('[data-sum-pp]', fmt(pv.p));
    txt('[data-sum-al]', r.getAttribute('data-label')||'');
    txt('[data-sum-ap]', fmt(addP));
    txt('[data-sum-tot]', fmt(pv.p + addP));
    sum.classList.add('is-shown');
  }
  var tmr=null;
  function later(){ if(tmr) clearTimeout(tmr); tmr=setTimeout(render, 60); }
  function sync(){ var v=!!(on && on.checked); box.classList.toggle('is-on', v); if(on) on.setAttribute('aria-expanded', v ? 'true' : 'false'); last=''; render(); }
  if(on) on.addEventListener('change', sync);
  document.addEventListener('change', later, true);
  document.addEventListener('click', later, true);
  setInterval(function(){ if(on && on.checked) render(); }, 700);
  sync();
  document.addEventListener('submit', function(e){
    var f=e.target;
    if(!f || !f.matches || !f.matches('form[action*="/cart/add"]')) return;
    if(!on || !on.checked) return;
    if(f.dataset.aaAddonDone==='1'){ delete f.dataset.aaAddonDone; return; }
    var r=box.querySelector('input[name="aa-addon-v"]:checked');
    if(!r) return;
    e.preventDefault(); e.stopImmediatePropagation();
    var props={}, keys=[];
    try{ props=JSON.parse(box.getAttribute('data-props')||'{}')||{}; }catch(x){ props={}; }
    keys=Object.keys(props);
    try{ keys=keys.concat(JSON.parse(box.getAttribute('data-inherit')||'[]')||[]); }catch(x){}
    keys.forEach(function(k){
      var sel='[name="properties['+k+']"]';
      var el=f.querySelector(sel)||document.querySelector(sel);
      if(el && el.value) props[k]=el.value;
    });
    props['_Added with']=box.getAttribute('data-parent')||'';
    var root=(window.Shopify && Shopify.routes && Shopify.routes.root) || '/';
    fetch(root+'cart/add.js',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({items:[{id:+r.value,quantity:1,properties:props}]})})
      .catch(function(){})
      .then(function(){
        f.dataset.aaAddonDone='1';
        if(f.requestSubmit){ f.requestSubmit(); } else { f.submit(); }
      });
  }, true);
})();
</script>
{%- endif -%}
{%- endif -%}
