{%- comment -%}
  Art Avenue — snippets/aa-gallery.liquid
  Product media gallery. Real product photography via Shopify media; warm
  placeholder figure if a product has no images yet.
{%- endcomment -%}
{%- assign media = product.media -%}
<div class="aa-gallery" data-aa-gallery>
  <div class="aa-gallery__main aa-fig aa-fig--sand" data-aa-gallery-main>
    {%- if media.size > 0 -%}
      {%- assign first = media.first -%}
      <img
        src="{{ first | image_url: width: 1200 }}"
        srcset="{{ first | image_url: width: 600 }} 600w, {{ first | image_url: width: 1200 }} 1200w, {{ first | image_url: width: 1600 }} 1600w"
        sizes="(min-width: 990px) 55vw, 100vw"
        alt="{{ first.alt | escape | default: product.title }}"
        width="{{ first.width }}" height="{{ first.height }}"
        loading="eager">
    {%- else -%}
      <span class="aa-fig__label">{{ product.title }}</span>
    {%- endif -%}
  </div>
  {%- if media.size > 1 -%}
    <div class="aa-gallery__thumbs">
      {%- for m in media limit: 8 -%}
        <button type="button" class="aa-gallery__thumb aa-fig aa-fig--stone" data-src="{{ m | image_url: width: 1200 }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}" aria-label="View image {{ forloop.index }}">
          <img src="{{ m | image_url: width: 240 }}" alt="{{ m.alt | escape }}" width="240" height="240" loading="lazy">
        </button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>
<script>
  (function () {
    var g = document.querySelector('[data-aa-gallery]');
    if (!g) return;
    var main = g.querySelector('[data-aa-gallery-main] img');
    g.querySelectorAll('.aa-gallery__thumb').forEach(function (t) {
      t.addEventListener('click', function () {
        if (main && t.dataset.src) main.src = t.dataset.src;
        g.querySelectorAll('.aa-gallery__thumb').forEach(function (x) { x.setAttribute('aria-current', 'false'); });
        t.setAttribute('aria-current', 'true');
      });
    });
  })();
</script>
