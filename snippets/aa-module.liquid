{%- comment -%} Module dispatcher. params: key, product, fulfillment. Add a module = add a when-branch. {%- endcomment -%}
{%- assign p = product -%}
{%- capture consult_href -%}{% render 'aa-lead-url', type:'consultation', product: p %}{%- endcapture -%}
{%- capture custom_href -%}{% render 'aa-lead-url', type:'custom', product: p %}{%- endcapture -%}

{%- case key -%}

{%- when 'whyLove' -%}
<section class="aa-section" style="border-top:1px solid var(--border-hairline)"><div class="aa-wrap aa-modwrap" style="display:grid;grid-template-columns:.82fr 1.18fr;gap:clamp(40px,6vw,90px);align-items:center">
  {% render 'aa-figure', tone:'clay', ratio:'4/5', label:'Made by hand' %}
  <div>
    <span class="aa-eyebrow aa-eyebrow--rule">Why You'll Love It</span>
    <h2 class="aa-h1" style="margin-top:16px">A piece made to be lived with.</h2>
    <p style="font-size:var(--text-body);line-height:1.72;color:var(--text-secondary);margin-top:16px;max-width:58ch">Every Art Avenue piece begins as raw material and the hands of the people who shape it — made slowly, to be kept.</p>
    <ul style="list-style:none;margin:28px 0 0;padding:0">
      {%- assign pts = "Handcrafted by skilled artisans|Carved, joined and finished by hand — never mass-produced.~Built from carefully selected materials|Natural hardwoods and textiles, chosen to last decades.~Designed to age beautifully|Oil-rubbed finishes gain character with the years.~Naturally one of a kind|Grain, tone and hand-finish vary gently from piece to piece." | split: "~" -%}
      {%- for pt in pts -%}{%- assign parts = pt | split: "|" -%}
        <li style="display:grid;grid-template-columns:auto 1fr;gap:0 18px;align-items:baseline;padding:16px 0;border-top:1px solid var(--border-hairline)"><span class="serif" style="font-style:italic;font-size:16px;color:var(--text-accent);width:26px">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span><div><div class="serif" style="font-size:20px;font-weight:500">{{ parts[0] }}</div><div style="font-size:14.5px;line-height:1.6;color:var(--text-secondary);margin-top:4px">{{ parts[1] }}</div></div></li>
      {%- endfor -%}
    </ul>
  </div>
</div></section>

{%- when 'customization' -%}
<section class="aa-section aa-dark"><div class="aa-wrap aa-modwrap" style="display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(40px,6vw,96px);align-items:center">
  <div>
    <span class="aa-eyebrow aa-eyebrow--on-dark">Made For Your Space</span>
    <h2 class="aa-display-2" style="color:var(--text-on-dark);margin-top:18px">Most pieces can be <em class="accent">made to suit.</em></h2>
    <p class="aa-lead" style="color:var(--text-on-dark-muted);margin-top:18px;max-width:46ch">Available in additional sizes, finishes and materials depending on the piece. Tell us about your room and a design consultant will shape it with you — well before you order.</p>
    <div style="margin-top:28px"><a class="btn btn--primary" href="{{ custom_href | strip }}" target="_blank" rel="noopener"><i class="ph ph-chat-teardrop-dots"></i> Speak with a Design Consultant</a></div>
  </div>
  <ul style="list-style:none;margin:0;padding:0;border-top:1px solid var(--border-on-dark)">
    {%- assign opts = "Custom dimensions to suit your room~Bespoke finishes &amp; material tones~Your own upholstery (COM) welcomed~Configurations for living, dining &amp; bedroom" | split: "~" -%}
    {%- for o in opts -%}<li style="display:flex;gap:14px;align-items:center;padding:16px 0;border-bottom:1px solid var(--border-on-dark);font-size:15.5px;color:var(--text-on-dark)"><i class="ph ph-plus" style="color:var(--accent-soft)"></i>{{ o }}</li>{%- endfor -%}
  </ul>
</div></section>

{%- when 'completeRoom' -%}
{%- assign rail = p.collections.first.products | default: collections.all.products -%}
<section class="aa-section aa-alt"><div class="aa-wrap">
  <span class="aa-eyebrow aa-eyebrow--rule">Complete the Room</span>
  <h2 class="aa-h1" style="margin:16px 0 0">Pieces our stylists pair with this</h2>
  <div class="grid-4 aa-modrail" style="margin-top:40px">
    {%- assign n = 0 -%}{%- for rp in rail -%}{%- if rp.id != p.id and n < 4 -%}{% render 'aa-product-card', product: rp %}{%- assign n = n | plus: 1 -%}{%- endif -%}{%- endfor -%}
    {%- if n == 0 -%}{% render 'aa-product-card', ph_cat:'Lighting', ph_name:'Brass Meridian Pendant', ph_price:'₹ 64,000', ph_tone:'bronze' %}{% render 'aa-product-card', ph_cat:'Rugs', ph_name:'Aravalli Rug', ph_price:'₹ 2,20,000', ph_tone:'olive' %}{% render 'aa-product-card', ph_cat:'Tables', ph_name:'Udai Side Table', ph_price:'₹ 48,000', ph_tone:'stone' %}{% render 'aa-product-card', ph_cat:'Decor', ph_name:'Stone Vessel', ph_price:'₹ 12,000', ph_tone:'clay' %}{%- endif -%}
  </div>
</div></section>

{%- when 'pairs' -%}
{%- assign rail = p.collections.first.products | default: collections.all.products -%}
<section class="aa-section aa-alt"><div class="aa-wrap">
  <span class="aa-eyebrow aa-eyebrow--rule">Frequently Styled Together</span>
  <h2 class="aa-h1" style="margin:16px 0 0">Complete the room</h2>
  <div class="grid-4 aa-modrail" style="margin-top:40px">
    {%- assign n = 0 -%}{%- for rp in rail -%}{%- if rp.id != p.id and n < 4 -%}{% render 'aa-product-card', product: rp %}{%- assign n = n | plus: 1 -%}{%- endif -%}{%- endfor -%}
    {%- if n == 0 -%}{% render 'aa-product-card', ph_cat:'Textiles', ph_name:'Handwoven Wool Throw', ph_price:'₹ 8,400', ph_tone:'stone' %}{% render 'aa-product-card', ph_cat:'Seating', ph_name:'Kashi Linen Sofa', ph_price:'₹ 3,20,000', ph_tone:'clay' %}{% render 'aa-product-card', ph_cat:'Decor', ph_name:'Stone Vessel', ph_price:'₹ 12,000', ph_tone:'bronze' %}{% render 'aa-product-card', ph_cat:'Rugs', ph_name:'Aravalli Rug', ph_price:'₹ 2,20,000', ph_tone:'olive' %}{%- endif -%}
  </div>
</div></section>

{%- when 'related' -%}
{%- assign rail = p.collections.first.products | default: collections.all.products -%}
<section class="aa-section aa-alt"><div class="aa-wrap">
  <span class="aa-eyebrow aa-eyebrow--rule">Continue Exploring</span>
  <h2 class="aa-h1" style="margin:16px 0 0">You may also like</h2>
  <div class="grid-4 aa-modrail" style="margin-top:40px">
    {%- assign n = 0 -%}{%- for rp in rail -%}{%- if rp.id != p.id and n < 4 -%}{% render 'aa-product-card', product: rp %}{%- assign n = n | plus: 1 -%}{%- endif -%}{%- endfor -%}
    {%- if n == 0 -%}{% render 'aa-product-card', ph_cat:'Seating', ph_name:'Kashi Linen Sofa', ph_price:'₹ 3,20,000', ph_tone:'stone' %}{% render 'aa-product-card', ph_cat:'Tables', ph_name:'Amer Marble Table', ph_price:'₹ 4,10,000', ph_tone:'clay' %}{% render 'aa-product-card', ph_cat:'Storage', ph_name:'Jodha Sideboard', ph_price:'₹ 2,60,000', ph_tone:'espresso' %}{% render 'aa-product-card', ph_cat:'Lighting', ph_name:'Brass Meridian Pendant', ph_price:'₹ 64,000', ph_tone:'bronze' %}{%- endif -%}
  </div>
</div></section>

{%- when 'faq' -%}
<section class="aa-section"><div class="aa-wrap aa-modwrap" style="display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(40px,6vw,96px);align-items:start">
  <div><span class="aa-eyebrow aa-eyebrow--rule">Good to Know</span><h2 class="aa-h2" style="margin-top:16px">Questions, answered.</h2><p style="font-size:15px;line-height:1.7;color:var(--text-secondary);margin-top:16px">Still unsure? A design consultant is a tap away.</p><a class="btn btn--ghost" href="{{ consult_href | strip }}" target="_blank" rel="noopener" style="margin-top:8px">Speak with a Consultant <i class="ph ph-arrow-right"></i></a></div>
  <div class="aa-accordion" style="margin-top:0;border-top:1px solid var(--border-hairline)">
    <details><summary>How long does a made-to-order piece take?</summary><p>Most pieces are crafted and delivered within 3–4 weeks domestically. Your consultant confirms a precise timeline at order.</p></details>
    <details><summary>Can I customise the size, finish or fabric?</summary><p>Yes — bespoke dimensions, finishes and customer-own-material (COM) upholstery are available. Speak with a consultant to begin.</p></details>
    <details><summary>Do you ship internationally?</summary><p>We ship worldwide with insured freight; a quote is provided at checkout or by your consultant.</p></details>
    <details><summary>What is your returns policy?</summary><p>Stocked pieces may be returned within 14 days. Made-to-order and customised pieces are final sale — which is why we encourage a material sample first.</p></details>
  </div>
</div></section>

{%- when 'guides' -%}
<section class="aa-section aa-alt"><div class="aa-wrap">
  <span class="aa-eyebrow aa-eyebrow--rule">Rug Buying Guides</span>
  <h2 class="aa-h2" style="margin:16px 0 32px">Everything you need to choose well.</h2>
  <div class="grid-5 aa-modrail">
    {%- assign gs = "Size Guide|Find the right size for your room|ph-ruler~Material Guide|Wool, cotton &amp; chenille compared|ph-leaf~Construction Guide|Knotted, tufted, flat &amp; loomed|ph-spiral~Placement Guide|Room-by-room sizing &amp; layout|ph-squares-four~Care Guide|Keep it beautiful for decades|ph-sparkle" | split: "~" -%}
    {%- for g in gs -%}{%- assign gp = g | split: "|" -%}<div style="background:var(--surface-raised);border:1px solid var(--border-hairline);border-radius:var(--radius-sm);padding:22px 20px;min-height:172px;display:flex;flex-direction:column;gap:12px"><i class="ph-light {{ gp[2] }}" style="font-size:26px;color:var(--accent-deep)"></i><span style="margin-top:auto"><span class="serif" style="display:block;font-size:19px">{{ gp[0] }}</span><span style="display:block;font-size:12.5px;color:var(--text-secondary);margin-top:4px">{{ gp[1] }}</span></span></div>{%- endfor -%}
  </div>
</div></section>

{%- when 'specs' -%}
{% render 'aa-module-rug', key: 'specs', product: p %}

{%- when 'construction' -%}
{% render 'aa-module-rug', key: 'construction', product: p %}

{%- when 'material' -%}
<section class="aa-section"><div class="aa-wrap">
  <span class="aa-eyebrow aa-eyebrow--rule">Material &amp; Texture</span>
  <h2 class="aa-h1" style="margin:16px 0 0">Know the feel before you choose.</h2>
  <div class="grid-3 aa-modrail" style="margin-top:40px">
    {%- assign mats = p.metafields.aav.materials.value -%}
    {%- if mats and mats.size > 0 -%}
      {%- for m in mats -%}<div style="background:var(--surface-raised);border:1px solid var(--border-hairline);border-radius:var(--radius-sm);overflow:hidden">{% if m.image %}<div class="aa-fig"><img src="{{ m.image | image_url: width:800 }}" alt="{{ m.name }}"></div>{% else %}{% render 'aa-figure', tone:'olive', ratio:'16/9' %}{% endif %}<div style="padding:20px 22px 24px"><h3 class="serif" style="font-size:21px">{{ m.name }}</h3><p style="font-size:13.5px;line-height:1.5;color:var(--text-secondary);margin-top:8px">{{ m.description }}</p></div></div>{%- endfor -%}
    {%- else -%}
      {%- assign ms = "Hand-Knotted Wool|Dense, resilient pile|Decades with care|Living &amp; dining|olive~Cotton (Printed)|Crisp, breathable, flat|Easy-care, low-traffic|Layering &amp; bedrooms|stone~Super-Soft Cotton Chenille|Plush, dense underfoot|Durable, family-friendly|Living rooms &amp; bedrooms|clay" | split: "~" -%}
      {%- for m in ms -%}{%- assign mp = m | split:"|" -%}<div style="background:var(--surface-raised);border:1px solid var(--border-hairline);border-radius:var(--radius-sm);overflow:hidden">{% render 'aa-figure', tone: mp[4], ratio:'16/9' %}<div style="padding:20px 22px 24px"><h3 class="serif" style="font-size:21px">{{ mp[0] }}</h3><div style="display:grid;grid-template-columns:auto 1fr;gap:7px 16px;font-size:13px;margin-top:14px"><span style="font-size:10px;letter-spacing:.06em;text-transform:uppercase;color:var(--text-muted);align-self:center">Feel</span><span>{{ mp[1] }}</span><span style="font-size:10px;letter-spacing:.06em;text-transform:uppercase;color:var(--text-muted);align-self:center">Durability</span><span>{{ mp[2] }}</span><span style="font-size:10px;letter-spacing:.06em;text-transform:uppercase;color:var(--text-muted);align-self:center">Best for</span><span>{{ mp[3] }}</span></div></div></div>{%- endfor -%}
    {%- endif -%}
  </div>
</div></section>

{%- when 'craft' -%}
{% render 'aa-module-rug', key: 'craft', product: p %}

{%- when 'rooms' -%}
<section class="aa-section"><div class="aa-wrap">
  <span class="aa-eyebrow aa-eyebrow--rule">Will It Fit?</span>
  <h2 class="aa-h1" style="margin:16px 0 0">Room-by-room sizing.</h2>
  <div class="grid-4 aa-modrail" style="margin-top:40px">
    {%- assign rms = "Living Room|8×10 / 9×12 ft,Dining Room|8×10 (6-seat) · 9×12 (8-seat),Bedroom|8×10 (queen) · 9×12 (king),Runner / Hallway|2.5×8 / 2.5×10 ft" | split: "," -%}
    {%- for r in rms -%}{%- assign rp = r | split:"|" -%}<div>{% render 'aa-figure', tone:'stone', ratio:'1/1' %}<h3 class="serif" style="font-size:20px;margin:18px 0 0">{{ rp[0] }}</h3><div style="font-size:12px;font-weight:600;color:var(--text-accent);margin-top:6px">Recommended · {{ rp[1] }}</div></div>{%- endfor -%}
  </div>
</div></section>

{%- when 'consult' -%}
<section class="aa-section aa-dark"><div class="aa-wrap aa-modwrap" style="display:grid;grid-template-columns:1.1fr .9fr;gap:clamp(40px,6vw,96px);align-items:center">
  <div><span class="aa-eyebrow aa-eyebrow--on-dark">Personal Service</span><h2 class="aa-display-2" style="color:var(--text-on-dark);margin-top:18px">Need help choosing the <em class="accent">right piece?</em></h2><p class="aa-lead" style="color:var(--text-on-dark-muted);margin-top:20px;max-width:48ch">A design consultant can guide you through size, material, placement, custom sizing, care and styling — before you spend a rupee. Complimentary, and unhurried.</p><div style="margin-top:24px"><a class="btn btn--primary" href="{{ consult_href | strip }}" target="_blank" rel="noopener"><i class="ph ph-chat-teardrop-dots"></i> Speak with a Design Consultant</a></div></div>
  <ul style="list-style:none;margin:0;padding:0;border-top:1px solid var(--border-on-dark)">
    {%- assign cf = "Handcrafted by skilled artisans~Made using premium, natural materials~Secure, insured delivery across India~International shipping available~Custom sizes available on select designs~Design consultation available before you buy" | split: "~" -%}
    {%- for c in cf -%}<li style="display:flex;gap:14px;align-items:center;padding:16px 0;border-bottom:1px solid var(--border-on-dark);font-size:15.5px;color:var(--text-on-dark)"><i class="ph ph-check" style="color:var(--accent-soft)"></i>{{ c }}</li>{%- endfor -%}
  </ul>
</div></section>

{%- when 'assembly' -%}
<section class="aa-section--tight aa-alt" style="padding-top:var(--section-y-tight);padding-bottom:var(--section-y-tight)"><div class="aa-wrap aa-modwrap" style="display:grid;grid-template-columns:1.3fr auto;gap:clamp(28px,4vw,64px);align-items:center">
  <div style="max-width:60ch"><span class="aa-eyebrow aa-eyebrow--rule">Delivery &amp; Assembly</span><h3 class="aa-h3" style="margin-top:14px">Need assembly assistance?</h3><p style="font-size:15px;line-height:1.7;color:var(--text-secondary);margin-top:12px">Most pieces arrive securely packed and ready to use. Some larger items may need simple assembly — speak with us before you order so we can confirm what your piece needs.</p></div>
  <a class="btn btn--secondary" href="{{ consult_href | strip }}" target="_blank" rel="noopener" style="white-space:nowrap"><i class="ph ph-chat-teardrop-dots" style="color:var(--accent-deep)"></i> Speak with a Consultant</a>
</div></section>

{%- endcase -%}