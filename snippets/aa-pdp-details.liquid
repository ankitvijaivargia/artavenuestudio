{%- comment -%} Rich PDP detail accordion. params: product {%- endcomment -%}
{%- comment -%} detect which materials this product offers, to show the right care sections {%- endcomment -%}
{%- assign has_leather = false -%}{%- assign has_fabric = false -%}
{%- assign sw_list = product.metafields.aav.swatches.value -%}
{%- if sw_list -%}{%- for s in sw_list -%}{%- if s.category.value == 'Leather' -%}{%- assign has_leather = true -%}{%- else -%}{%- assign has_fabric = true -%}{%- endif -%}{%- endfor -%}{%- endif -%}
{%- comment -%} rugs get their own care + no assembly section {%- endcomment -%}
{%- assign is_rug = false -%}
{%- if product.type == 'Rug' or product.metafields.aav.rug_custom.value != blank -%}{%- assign is_rug = true -%}{%- endif -%}
{%- comment -%} construction drives materials, craft and care copy. metafield wins, else tag. {%- endcomment -%}
{%- assign rc = product.metafields.aav.rug_construction | downcase -%}
{%- unless rc != blank -%}
  {%- if product.tags contains 'hand-knotted-rugs' -%}{%- assign rc = 'knotted' -%}
  {%- elsif product.tags contains 'hand-tufted-rugs' -%}{%- assign rc = 'tufted' -%}
  {%- elsif product.tags contains 'flat-weave-rugs' -%}{%- assign rc = 'flatweave' -%}
  {%- elsif product.tags contains 'hand-loomed-rugs' -%}{%- assign rc = 'loomed' -%}
  {%- endif -%}
{%- endunless -%}
{%- case rc -%}
  {%- when 'knotted' -%}{%- assign rc_label = 'Hand-Knotted' -%}
  {%- when 'tufted' -%}{%- assign rc_label = 'Hand-Tufted' -%}
  {%- when 'flatweave' -%}{%- assign rc_label = 'Handwoven Flat-Weave' -%}
  {%- when 'loomed' -%}{%- assign rc_label = 'Hand-Loomed' -%}
  {%- else -%}{%- assign rc_label = '' -%}
{%- endcase -%}
{%- assign dims = product.metafields.aav.size_dimensions.value -%}
{%- if dims != blank -%}
<style>
  .aa-dims__bar{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin:0 0 12px}
  .aa-dims__cap{font-size:11px;letter-spacing:var(--tracking-caps);text-transform:uppercase;color:var(--text-accent)}
  .aa-dims__units{display:inline-flex;border:1px solid var(--accent-soft);border-radius:999px;overflow:hidden}
  .aa-dims__unit{appearance:none;background:transparent;border:0;cursor:pointer;padding:5px 14px;font:inherit;font-size:12px;letter-spacing:.04em;color:var(--text-secondary)}
  .aa-dims__unit.is-active{background:var(--surface-accent-tint);color:var(--text-accent)}
  .aa-dims__table{width:100%;border-collapse:collapse;font-size:15px;line-height:1.6;margin:0}
  .aa-dims__table th,.aa-dims__table td{text-align:left;padding:10px 0;border-bottom:1px solid var(--accent-soft);vertical-align:top}
  .aa-dims__table th{font-weight:500;color:var(--text-primary);padding-right:18px}
  .aa-dims__table td{color:var(--text-secondary)}
  .aa-dims__table tr:last-child th,.aa-dims__table tr:last-child td{border-bottom:0}
  .aa-dims__note{margin:16px 0 0;font-size:14px;line-height:1.72;color:var(--text-secondary);max-width:60ch}
  .aa-dims__check{margin:16px 0 0;padding:14px 16px;border-radius:var(--radius-sm);background:var(--surface-accent-tint);border:1px solid var(--accent-soft)}
  .aa-dims__check ul{margin:8px 0 0;padding:0 0 0 18px;font-size:14px;line-height:1.72;color:var(--text-secondary)}
  .aa-dims__wrap{padding-bottom:20px}
</style>
{%- endif -%}
<div class="aa-accordion" id="aaPdpDetails">
  {%- if product.description != blank -%}
  <details open><summary>Description <i class="ph ph-plus aa-acc-pm"></i></summary><div class="rte" style="padding-bottom:20px;font-size:15px;line-height:1.72;color:var(--text-secondary)">{{ product.description }}</div></details>
  {%- endif -%}

  {%- if dims != blank -%}
  <details><summary>Dimensions &amp; Fit <i class="ph ph-plus aa-acc-pm"></i></summary>
    <div class="aa-dims__wrap" data-aa-dims>
      <div class="aa-dims__bar">
        <span class="aa-dims__cap">Finished measurements</span>
        <div class="aa-dims__units" role="group" aria-label="Switch measurement units">
          <button type="button" class="aa-dims__unit is-active" data-aa-unit="cm" aria-pressed="true">cm</button>
          <button type="button" class="aa-dims__unit" data-aa-unit="in" aria-pressed="false">inches</button>
        </div>
      </div>
      <table class="aa-dims__table">
        <tbody>
          {%- for row in dims -%}
          <tr>
            <th scope="row">{{ row[0] }}</th>
            <td><span data-aa-dim="cm">{{ row[1]["cm"] }}</span><span data-aa-dim="in" style="display:none">{{ row[1]["in"] }}</span></td>
          </tr>
          {%- endfor -%}
        </tbody>
      </table>
      <div class="aa-dims__check">
        <strong style="font-size:14px;color:var(--text-primary)">Worth measuring before you order</strong>
        <ul>
          <li>The space the piece will stand in, leaving room to walk around it</li>
          <li>Doorways, corridors and any corner the piece has to turn</li>
          <li>The stairwell or lift, if it isn&rsquo;t a ground-floor delivery</li>
        </ul>
      </div>
      <p class="aa-dims__note">Your piece is built after you order it rather than taken off a shelf, so we&rsquo;d rather you check these measurements against your room first &mdash; made-to-order pieces can&rsquo;t be returned or exchanged. Being handmade, finished dimensions may vary by a centimetre or two.</p>
      <p class="aa-dims__note">If these proportions aren&rsquo;t quite right for your space, we can change them. Speak to a design consultant before you order and we&rsquo;ll build the piece to your measurements.</p>
    </div>
  </details>
  {%- endif -%}

  {%- if is_rug -%}
  <details><summary>Materials &amp; Construction{% if rc_label != blank %} &mdash; {{ rc_label }}{% endif %} <i class="ph ph-plus aa-acc-pm"></i></summary>
    {%- case rc -%}
      {%- when 'knotted' -%}
      <p>Every knot is tied individually by hand onto the warp &mdash; the most time-honoured and labour-intensive of all rug constructions, and a single piece can occupy several artisans for months. There is no adhesive and no backing: the structure is the knots themselves. That is why a hand-knotted rug can be washed, repaired and passed down across generations.</p>
      {%- when 'tufted' -%}
      <p>Wool is punched through a stretched canvas backing with a hand-held tufting tool, secured with a latex adhesive and finished with a cotton scrim. The result is a dense, deeply plush pile with the pattern carved in relief &mdash; the softest underfoot of our constructions.</p>
      {%- when 'flatweave' -%}
      <p>Woven by hand on a traditional loom with no knotted pile &mdash; the pattern is created by the weave itself, so it reads on both faces. Flat, light and fully reversible, it suits layering, high-traffic rooms and warmer months.</p>
      {%- when 'loomed' -%}
      <p>Woven on a hand-operated loom, drawing the yarn across the warp row by row and shearing the pile level. This gives an even, consistent surface with a softer and more uniform texture than tufting.</p>
      {%- else -%}
      <p>Knotted, tufted or flat-woven by hand from natural fibres &mdash; wool, cotton, jute and silk blends &mdash; on traditional looms. Because each rug is made by hand from natural yarn, slight variation in colour, pile height and finished dimensions is intrinsic to the piece, not a defect.</p>
    {%- endcase -%}
    <p style="padding-bottom:20px">Made by hand from natural yarn, so slight variation in colour, pile height and finished dimensions is intrinsic to the piece, not a defect.</p>
  </details>

  <details><summary>Rug Care <i class="ph ph-plus aa-acc-pm"></i></summary>
    <ul style="padding:0 0 20px 18px;margin:0;font-size:15px;line-height:1.72;color:var(--text-secondary);max-width:62ch">
      <li>Vacuum periodically with the beater bar or brush roll switched off &mdash; suction only. Never brush or scrub the pile.</li>
      <li>Blot spills immediately with a clean, dry cloth. Press, don&rsquo;t rub &mdash; rubbing drives the stain deeper and distorts the weave.</li>
      <li>Rotate the rug every few months so it wears and fades evenly.</li>
      <li>Use protectors under the legs of heavy furniture to prevent flattening and permanent indentation.</li>
      <li>If a thread lifts, never pull it &mdash; trim it level with the pile using sharp scissors.</li>
      <li>Keep out of prolonged direct sunlight to preserve the depth of the dyes.</li>
      {%- case rc -%}
        {%- when 'knotted' -%}
        <li>Light shedding may appear at first and settles quickly. With no adhesive backing, this rug can be professionally wet-cleaned and, in time, repaired or restored.</li>
        <li>An underlay is recommended &mdash; it stops slipping, cushions the pile and extends the life of the rug.</li>
        {%- when 'tufted' -%}
        <li><strong>Expect noticeable shedding for the first few months.</strong> This is normal for a tufted pile and reduces steadily with gentle, regular vacuuming.</li>
        <li>Because the pile is set into an adhesive backing, never soak or steam clean this rug &mdash; excess moisture breaks down the backing. Have it dry-cleaned by a rug specialist.</li>
        <li>An underlay is recommended &mdash; it stops slipping, cushions the pile and extends the life of the rug.</li>
        {%- when 'flatweave' -%}
        <li>Fully reversible &mdash; turn the rug over occasionally to distribute wear evenly across both faces.</li>
        <li>An anti-slip underlay is strongly recommended: flat-weaves are light and will otherwise shift and ruck underfoot.</li>
        {%- when 'loomed' -%}
        <li>Light shedding is normal at first and settles with regular gentle vacuuming.</li>
        <li>An underlay is recommended &mdash; it stops slipping, cushions the pile and extends the life of the rug.</li>
        {%- else -%}
        <li>Some shedding is normal in the first months on any hand-made pile. It settles with regular gentle vacuuming.</li>
        <li>An underlay is recommended &mdash; it stops slipping, cushions the pile and extends the life of the rug.</li>
      {%- endcase -%}
      <li>Have the rug professionally cleaned periodically. Avoid machine washing, bleach and harsh solvents.</li>
    </ul>
  </details>

  <details><summary>Sizing &amp; Placement <i class="ph ph-plus aa-acc-pm"></i></summary><p>As a guide: in a living room, the front legs of all seating should rest on the rug. In a dining room, allow at least 60 cm beyond the table edge so chairs stay on the rug when pulled out. In a bedroom, allow 45&ndash;60 cm of rug either side of the bed. Custom dimensions are available on most pieces &mdash; enter your measurements on this page, or speak with a design consultant.</p></details>

  <details><summary>Craftsmanship <i class="ph ph-plus aa-acc-pm"></i></summary>
    {%- case rc -%}
      {%- when 'knotted' -%}
      <p>Wool is carded, hand-spun and dyed in small batches, then knotted row by row on an upright loom. Once cut from the loom the rug is washed, clipped and finished entirely by hand &mdash; the clipping alone defines the final texture and the crispness of the pattern.</p>
      {%- when 'tufted' -%}
      <p>The design is traced onto the backing and worked tuft by tuft with a hand tool, then sheared and carved so the pattern stands in relief. Finishing, binding and the final shear are all done by hand.</p>
      {%- when 'flatweave' -%}
      <p>The warp is dressed onto the loom and the weft beaten in by hand, row upon row, until the pattern emerges from the weave itself. Nothing is glued or backed &mdash; the rug is exactly what you see on both sides.</p>
      {%- when 'loomed' -%}
      <p>The weaver works a hand loom, drawing loops of yarn across the warp before the pile is sheared level and the rug washed and finished by hand.</p>
      {%- else -%}
      <p>Woven by hand over weeks or months, passing through the hands of several artisans &mdash; dyeing, weaving, washing, clipping and finishing.</p>
    {%- endcase -%}
  </details>

  <details><summary>Delivery &amp; Shipping <i class="ph ph-plus aa-acc-pm"></i></summary><p>Made-to-order rugs ship in 3&ndash;4 weeks via safe, insured delivery, rolled and wrapped for transit. A rug may arrive with fold marks or a slight curl at the edges &mdash; lay it flat and allow a few days for it to settle. International freight is quoted at checkout.</p></details>
  {%- else -%}
  <details><summary>Materials <i class="ph ph-plus aa-acc-pm"></i></summary><p>Built from carefully selected, natural materials — kiln-dried hardwoods, hand-spun textiles, cast metal and quarried stone, chosen to last for decades. Naturally occurring grain and tone variation is intrinsic to each handmade piece.</p></details>
  {%- if has_leather -%}
  <details data-mat-section="Leather"><summary>About our leather <i class="ph ph-plus aa-acc-pm"></i></summary><p>Our leathers are genuine and natural. Because every hide is unique, colour, depth of tone, grain and surface character vary from piece to piece — and small marks, scars, wrinkles and uneven tones are part of the material, not defects. Your piece won&rsquo;t look exactly like the photograph, and that individuality is the mark of real leather. To feel a colour and texture in person before you commit, order a swatch from the colour picker above.</p></details>
  <details data-mat-section="Leather"><summary>Leather care <i class="ph ph-plus aa-acc-pm"></i></summary><p>Dust regularly with a soft, dry cloth and wipe spills at once with a clean, slightly damp cloth — never soak. Keep leather out of prolonged direct sunlight and away from direct heat to prevent fading and drying. Condition with a quality leather balm once or twice a year to keep the hide supple. Avoid solvents, polishes and abrasive cleaners.</p></details>
  {%- endif -%}
  {%- if has_fabric -%}
  <details data-mat-section="Fabric"><summary>Fabric care <i class="ph ph-plus aa-acc-pm"></i></summary><p>Vacuum gently and regularly with an upholstery attachment to lift dust before it settles. Blot spills immediately with a clean, dry cloth — press, don&rsquo;t rub — and avoid soaking the fabric. Plump and rotate loose cushions so they wear evenly. Keep out of prolonged direct sunlight to preserve colour, and have delicate weaves cleaned professionally rather than machine-washed.</p></details>
  {%- endif -%}
  <details><summary>Craftsmanship <i class="ph ph-plus aa-acc-pm"></i></summary><p>Carved, joined and finished by hand in our workshops, passing through the hands of several craftspeople. Joinery is mortise-and-tenon — never glued shortcuts — so the piece is made to be kept and passed down.</p></details>
  {%- if dims == blank -%}
  <details><summary>Dimensions &amp; Fit <i class="ph ph-plus aa-acc-pm"></i></summary><p>Generous, considered proportions drawn for real homes. Every piece is made to order, so if these aren&rsquo;t quite right for your space we can build to your measurements &mdash; speak to a design consultant before ordering and we&rsquo;ll confirm everything with you first.</p></details>
  {%- endif -%}
  <details><summary>Assembly &amp; Installation <i class="ph ph-plus aa-acc-pm"></i></summary><p>Most pieces arrive securely packed and ready to use. Some larger items may require simple assembly; installation assistance may be available depending on the product and your location — speak with a consultant to confirm before ordering.</p></details>
  <details><summary>Care <i class="ph ph-plus aa-acc-pm"></i></summary><p>Dust timber with a soft dry cloth and treat with wax balm twice yearly. Vacuum upholstery gently and treat marks promptly. Keep out of prolonged direct sun to preserve the finish.</p></details>
  <details><summary>Delivery &amp; Shipping <i class="ph ph-plus aa-acc-pm"></i></summary><p>Made-to-order pieces ship in 3&ndash;4 weeks via safe, insured delivery, securely packed for transit. Assembly assistance is available on selected pieces. International freight is quoted at checkout.</p></details>
  {%- endif -%}

  <details><summary>Designer Notes <i class="ph ph-plus aa-acc-pm"></i></summary><p>&ldquo;We design for the way you actually live &mdash; pieces generous enough to sink into, detailed enough to reward a second look, and made to age beautifully.&rdquo; &mdash; Art Avenue Design Studio</p></details>
</div>

{%- if dims != blank -%}
<script>
(function(){
  var boxes = document.querySelectorAll('[data-aa-dims]');
  Array.prototype.forEach.call(boxes, function(box){
    box.addEventListener('click', function(e){
      var b = e.target.closest('.aa-dims__unit');
      if(!b) return;
      var u = b.getAttribute('data-aa-unit');
      Array.prototype.forEach.call(box.querySelectorAll('.aa-dims__unit'), function(x){
        var on = (x === b);
        x.classList.toggle('is-active', on);
        x.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      Array.prototype.forEach.call(box.querySelectorAll('[data-aa-dim]'), function(s){
        s.style.display = (s.getAttribute('data-aa-dim') === u) ? '' : 'none';
      });
    });
  });
})();
</script>
{%- endif -%}

{%- if has_leather or has_fabric -%}
<script>
(function(){
  var box = document.getElementById('aaPdpDetails');
  if(!box) return;
  var secs = box.querySelectorAll('[data-mat-section]');
  if(!secs.length) return;
  // Show only the care sections that match the current material. Defaults to
  // whatever the configurator broadcasts; before any event we show all present
  // so the content is never hidden from crawlers or no-JS users.
  function apply(mat){
    secs.forEach(function(d){
      var match = d.getAttribute('data-mat-section') === mat;
      d.style.display = match ? '' : 'none';
      if(!match){ d.open = false; }
    });
  }
  document.addEventListener('aa:material', function(e){
    var mat = e && e.detail && e.detail.mat;
    if(mat) apply(mat);
  });
})();
</script>
{%- endif -%}