{%- comment -%}
  Header — menu-driven. Reads Admin → Navigation → "Main menu" (3 levels):
    level 1 = top nav item · level 2 = rail group · level 3 = links in that group
  A top item WITH children opens a left-rail mega menu; a top item WITHOUT children is a plain link.
  To launch Rugs / Lighting / Decor later: add them to the Main menu in Admin — no code change needed.
  Keep the Main menu to 3–4 top-level items: the left column shares the bar with the centred wordmark.
  Mega feature card: first mega shows the product set in `aa_feat_handle` below; others show the category name.
{%- endcomment -%}
{%- assign aa_menu = linklists['main-menu'] -%}
{%- assign aa_feat_handle = 'landour-tufted-upholstered-bed' -%}
{%- assign aa_feat = all_products[aa_feat_handle] -%}
<style>
  .aa-nav__item{position:static;}
  .aa-nav{align-self:stretch;}
  .aa-nav>.aa-nav__item{display:inline-flex;align-items:center;align-self:stretch;}
  .aa-mega::before{content:"";position:absolute;left:0;right:0;bottom:100%;height:14px;}
  .aa-nav__top{display:inline-flex;align-items:center;gap:6px;padding:6px 0;font-size:12px;font-weight:500;letter-spacing:var(--tracking-caps);text-transform:uppercase;color:var(--text-primary);opacity:.86;white-space:nowrap;border-bottom:1px solid transparent;cursor:pointer;}
  .aa-nav__item:hover .aa-nav__top{opacity:1;border-bottom-color:currentColor;}
  .aa-mega{position:absolute;left:0;right:0;top:100%;background:var(--surface-page);border-top:1px solid var(--border-hairline);border-bottom:1px solid var(--border-hairline);box-shadow:var(--shadow-soft);opacity:0;visibility:hidden;transform:translateY(-6px);transition:opacity var(--dur-base) var(--ease-luxe),transform var(--dur-base) var(--ease-luxe),visibility var(--dur-base);pointer-events:none;z-index:60;}
  .aa-nav__item:hover .aa-mega,.aa-nav__item:focus-within .aa-mega{opacity:1;visibility:visible;transform:translateY(0);pointer-events:auto;}

  /* left-rail layout */
  .aa-mega__inner{position:relative;min-height:380px;padding:36px var(--gutter) 44px;}
  .aa-mega__rail{list-style:none;margin:0;padding:0;width:264px;display:grid;gap:2px;}
  .aa-mrail__item{position:static;}
  .aa-mrail__link{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:9px 0;font-family:var(--font-serif);font-size:18px;color:var(--text-primary);border-bottom:1px solid transparent;}
  .aa-mrail__link i{font-size:12px;color:var(--text-muted);transition:transform var(--dur-base),color var(--dur-base);}
  .aa-mrail__item:hover > .aa-mrail__link{color:var(--text-accent);}
  .aa-mrail__item:hover > .aa-mrail__link i{color:var(--text-accent);transform:translateX(3px);}
  .aa-mega__panel{position:absolute;top:36px;bottom:44px;left:calc(var(--gutter) + 264px);right:calc(var(--gutter) + 300px + 56px);padding-left:56px;opacity:0;visibility:hidden;background:var(--surface-page);transition:opacity var(--dur-base) var(--ease-luxe);}
  .aa-mega__panel.is-default{opacity:1;visibility:visible;}
  .aa-mega__inner:has(.aa-mrail__item:hover) .aa-mega__panel.is-default{opacity:0;visibility:hidden;}
  .aa-mrail__item:hover > .aa-mega__panel{opacity:1 !important;visibility:visible !important;z-index:3;}
  .aa-mega__h{display:block;font-size:11px;letter-spacing:var(--tracking-eyebrow);text-transform:uppercase;color:var(--text-accent);margin-bottom:20px;}
  .aa-mega__panel ul{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:1fr 1fr;gap:14px 40px;}
  .aa-mega__panel ul a{font-family:var(--font-serif);font-size:17px;color:var(--text-primary);}
  .aa-mega__panel ul a:hover{color:var(--text-accent);}
  .aa-mega__viewall{display:inline-flex;align-items:center;gap:8px;margin-top:26px;font-size:11px;letter-spacing:var(--tracking-caps);text-transform:uppercase;color:var(--text-accent);}
  .aa-mega__feature{position:absolute;top:36px;right:var(--gutter);width:300px;height:300px;border-radius:var(--radius-sm);overflow:hidden;display:flex;flex-direction:column;justify-content:flex-end;padding:26px;background:linear-gradient(160deg,#b69b78,#8a6f4f);color:#fff;}
  .aa-mega__feature img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform 1.2s var(--ease-luxe);}
  .aa-mega__feature:hover img{transform:scale(1.04);}
  .aa-mega__feature.has-img::before{content:"";position:absolute;inset:0;z-index:1;background:linear-gradient(to top,rgba(34,31,27,.72),rgba(34,31,27,.05) 62%);}
  .aa-mega__feature span,.aa-mega__feature h4,.aa-mega__feature em{position:relative;z-index:2;}
  .aa-mega__feature span{font-size:10px;letter-spacing:var(--tracking-eyebrow);text-transform:uppercase;opacity:.85;}
  .aa-mega__feature h4{font-family:var(--font-serif);font-size:23px;line-height:1.15;font-weight:500;margin:8px 0 0;color:#fff;white-space:normal;}
  .aa-mega__feature em{display:inline-flex;align-items:center;gap:7px;margin-top:14px;font-style:normal;font-size:11px;letter-spacing:var(--tracking-caps);text-transform:uppercase;}

  .aa-burger{display:none;background:none;border:none;cursor:pointer;font-size:24px;color:var(--text-primary);padding:0;}
  .aa-drawer{position:fixed;inset:0;z-index:100;background:var(--surface-page);transform:translateX(-100%);transition:transform var(--dur-base) var(--ease-luxe);overflow-y:auto;padding:20px var(--gutter) 60px;}
  .aa-drawer.is-open{transform:translateX(0);}
  .aa-drawer__top{display:flex;justify-content:space-between;align-items:center;height:56px;margin-bottom:12px;}
  .aa-drawer a.aa-drawer__top-link{display:block;padding:16px 0;border-bottom:1px solid var(--border-hairline);font-family:var(--font-serif);font-size:22px;color:var(--text-primary);}
  .aa-drawer a.aa-drawer__top-link--sm{font-family:inherit;font-size:13px;letter-spacing:var(--tracking-caps);text-transform:uppercase;color:var(--text-secondary);padding:14px 0;}
  .aa-dacc{border-bottom:1px solid var(--border-hairline);}
  .aa-dacc__sum{list-style:none;display:flex;align-items:center;gap:12px;padding:16px 0;cursor:pointer;}
  .aa-dacc__sum::-webkit-details-marker{display:none;}
  .aa-dacc__label{flex:1;font-family:var(--font-serif);font-size:22px;color:var(--text-primary);}
  .aa-dacc__go{color:var(--text-muted);font-size:16px;padding:4px 10px;}
  .aa-dacc__chev{font-size:14px;color:var(--text-muted);transition:transform var(--dur-base) var(--ease-luxe);}
  .aa-dacc[open] .aa-dacc__chev{transform:rotate(180deg);}
  .aa-dacc__body{padding:4px 0 18px;display:grid;gap:14px;}
  .aa-dacc__group{font-size:11px;letter-spacing:var(--tracking-eyebrow);text-transform:uppercase;color:var(--text-accent);}
  .aa-dacc__links{display:grid;gap:11px;padding-left:2px;}
  .aa-dacc__links a{font-family:var(--font-serif);font-size:17px;color:var(--text-secondary);}
  .aa-drawer__wa{display:flex;align-items:center;justify-content:center;gap:10px;margin-top:28px;padding:15px;border:1px solid var(--border-strong);font-size:13px;letter-spacing:var(--tracking-caps);text-transform:uppercase;color:var(--text-primary);}
  /* Sister store (artavenue.in — The Archive): external cue + distinct indigo treatment */
  .aa-ext{font-size:.85em;opacity:.7;margin-left:1px;}
  .aa-mega__panel ul a[href*="artavenue.in"]::after,.aa-dacc__links a[href*="artavenue.in"]::after{content:" \2197";font-size:.72em;opacity:.55;}
  .aa-mega__feature[href*="artavenue.in"]{background:linear-gradient(160deg,#4a5568,#262c36);}
  .aa-drawer__archive{display:block;margin-top:26px;padding:20px 20px 18px;background:#2c3440;color:#fff;border-radius:var(--radius-sm);}
  .aa-drawer__archive small{display:block;font-size:10px;letter-spacing:var(--tracking-eyebrow);text-transform:uppercase;opacity:.75;}
  .aa-drawer__archive b{display:block;font-family:var(--font-serif);font-weight:500;font-size:20px;line-height:1.25;margin:8px 0 12px;color:#fff;}
  .aa-drawer__archive span{font-size:11px;letter-spacing:var(--tracking-caps);text-transform:uppercase;border-bottom:1px solid rgba(255,255,255,.5);padding-bottom:2px;}
  @media (max-width:1180px){ .aa-mega__feature{display:none;} .aa-mega__panel{right:var(--gutter);} }
  @media (max-width:1000px){
    .aa-header__bar{grid-template-columns:auto 1fr auto;}
    .aa-nav{display:none;}
    .aa-nav__icons .aa-nav__item,.aa-nav__icons > span{display:none;}
    .aa-burger{display:inline-flex;}
  }

  /* Desktop bar fit — side columns can shrink, so nav never runs into the centred wordmark;
     right-side text links share one baseline with the left nav. */
  @media (min-width:1001px){
    .aa-header__bar{grid-template-columns:minmax(0,1fr) auto minmax(0,1fr);column-gap:clamp(24px,3vw,48px);}
    .aa-nav{gap:clamp(20px,2.4vw,34px);min-width:0;}
    .aa-wordmark{white-space:nowrap;}
    .aa-nav__icons{gap:clamp(14px,1.6vw,22px);min-width:0;align-self:stretch;}
    .aa-nav__icons .aa-nav__item{display:inline-flex;align-items:center;align-self:stretch;font-size:12px;line-height:1;}
    .aa-nav__icons > a{display:inline-flex;align-items:center;line-height:1;}
  }
  @media (min-width:1001px) and (max-width:1180px){
    .aa-nav__top{letter-spacing:.1em;}
    .aa-nav__icons .aa-nav__item:nth-child(2){display:none;}
  }
</style>

<header class="aa-header">
  <div class="aa-header__bar">
    <button class="aa-burger" aria-label="Open menu" onclick="document.getElementById('aaDrawer').classList.add('is-open');document.body.style.overflow='hidden';"><i class="ph ph-list"></i></button>
    <nav class="aa-nav" aria-label="Main">
      {%- for link in aa_menu.links -%}
        {%- if link.links.size > 0 -%}
          {%- capture aa_rail -%}{%- for child in link.links -%}{{ child.title }}^{{ child.url }}^{%- if child.links.size > 0 -%}{%- for g in child.links -%}{{ g.title }}|{{ g.url }}{%- unless forloop.last -%};{%- endunless -%}{%- endfor -%}{%- else -%}link{%- endif -%}{%- unless forloop.last -%}~{%- endunless -%}{%- endfor -%}{%- endcapture -%}
          <div class="aa-nav__item">
            <a class="aa-nav__top" href="{{ link.url }}"{% if link.url contains 'artavenue.in' %} target="_blank" rel="noopener"{% endif %}>{{ link.title }} <i class="ph ph-caret-down" style="font-size:9px"></i></a>
            <div class="aa-mega">
              {%- if forloop.first and aa_feat != blank and aa_feat.featured_image -%}
                {% render 'aa-mega-rail', rail: aa_rail, feat_eyebrow: 'New In', feat_title: aa_feat.title, feat_url: aa_feat.url, feat_img: aa_feat.featured_image %}
              {%- elsif link.url contains 'artavenue.in' -%}
                {% render 'aa-mega-rail', rail: aa_rail, feat_eyebrow: 'Our sister store · artavenue.in', feat_title: 'Block-printed rugs, runners, cushions &amp; décor', feat_url: link.url %}
              {%- else -%}
                {%- assign aa_lt = link.title | downcase -%}
                {%- if aa_lt contains 'rug' -%}
                  {% render 'aa-mega-rail', rail: aa_rail, feat_eyebrow: 'Block-printed rugs &amp; runners', feat_title: 'Our block-printed rugs &amp; runners live in The Archive', feat_url: 'https://www.artavenue.in/collections/rugs?utm_source=artavenue.com&utm_medium=referral&utm_campaign=archive_nav' %}
                {%- else -%}
                  {% render 'aa-mega-rail', rail: aa_rail, feat_eyebrow: 'Explore', feat_title: link.title, feat_url: link.url %}
                {%- endif -%}
              {%- endif -%}
            </div>
          </div>
        {%- else -%}
          <div class="aa-nav__item"><a class="aa-nav__top" href="{{ link.url }}">{{ link.title }}</a></div>
        {%- endif -%}
      {%- endfor -%}
    </nav>

    <a class="aa-wordmark" href="{{ routes.root_url }}"><b>Art Avenue</b><small>Design House</small></a>

    <div class="aa-nav__icons">
      <div class="aa-nav__item"><a class="aa-nav__top" href="/pages/custom">Bespoke</a></div>
      <div class="aa-nav__item"><a class="aa-nav__top" href="/pages/trade">Trade</a></div>
      <div class="aa-nav__item"><a class="aa-nav__top" href="/pages/contact">Visit Us</a></div>
      <span style="width:1px;height:18px;background:currentColor;opacity:.22"></span>
      <a href="{{ routes.search_url }}" aria-label="Search"><i class="ph-light ph-magnifying-glass"></i></a>
      <a href="{{ routes.account_url }}" aria-label="Account"><i class="ph-light ph-user"></i></a>
      <a href="{{ routes.cart_url }}" aria-label="Cart" style="position:relative"><i class="ph-light ph-handbag-simple"></i>{%- if cart.item_count > 0 -%}<span style="position:absolute;top:-6px;right:-9px;min-width:16px;height:16px;padding:0 4px;border-radius:8px;background:var(--accent);color:#fff;font-size:10px;line-height:16px;text-align:center">{{ cart.item_count }}</span>{%- endif -%}</a>
    </div>
  </div>
</header>

{%- comment -%} Mobile drawer — built from the same Main menu {%- endcomment -%}
<div class="aa-drawer" id="aaDrawer" aria-label="Menu">
  <div class="aa-drawer__top">
    <span class="serif" style="font-size:22px;letter-spacing:.16em;text-transform:uppercase">Art Avenue</span>
    <button aria-label="Close menu" style="background:none;border:none;font-size:24px;cursor:pointer" onclick="document.getElementById('aaDrawer').classList.remove('is-open');document.body.style.overflow='';"><i class="ph ph-x"></i></button>
  </div>
  {%- for link in aa_menu.links -%}
    {%- if link.links.size > 0 -%}
      {%- capture aa_rail -%}{%- for child in link.links -%}{{ child.title }}^{{ child.url }}^{%- if child.links.size > 0 -%}{%- for g in child.links -%}{{ g.title }}|{{ g.url }}{%- unless forloop.last -%};{%- endunless -%}{%- endfor -%}{%- else -%}link{%- endif -%}{%- unless forloop.last -%}~{%- endunless -%}{%- endfor -%}{%- endcapture -%}
      {%- capture aa_show -%}{%- for child in link.links -%}{%- if child.links.size > 0 -%}{{ child.title }},{%- endif -%}{%- endfor -%}{%- endcapture -%}
      {% render 'aa-drawer-accordion', label: link.title, url: link.url, rail: aa_rail, show: aa_show %}
    {%- else -%}
      <a class="aa-drawer__top-link" href="{{ link.url }}">{{ link.title }}</a>
    {%- endif -%}
  {%- endfor -%}
  <a class="aa-drawer__archive" href="https://www.artavenue.in/?utm_source=artavenue.com&utm_medium=referral&utm_campaign=archive_nav" target="_blank" rel="noopener">
    <small>The Archive · artavenue.in</small>
    <b>Shopping for block-printed rugs, runners, cushions or décor?</b>
    <span>Visit The Archive &#8599;</span>
  </a>
  <a class="aa-drawer__top-link aa-drawer__top-link--sm" href="/pages/custom">Bespoke &amp; Made to Measure</a>
  <a class="aa-drawer__top-link aa-drawer__top-link--sm" href="/pages/trade">Trade &amp; Projects</a>
  <a class="aa-drawer__top-link aa-drawer__top-link--sm" href="/pages/contact">Visit the Showroom</a>
  <a class="aa-drawer__wa" href="https://wa.me/{{ settings.wa_number | default: '919828080095' }}" target="_blank" rel="noopener"><i class="ph ph-whatsapp-logo" style="font-size:18px"></i> Chat with us on WhatsApp</a>
  <div style="margin-top:24px;display:flex;gap:20px;font-size:13px;letter-spacing:var(--tracking-caps);text-transform:uppercase">
    <a href="{{ routes.search_url }}">Search</a><a href="{{ routes.account_url }}">Account</a><a href="{{ routes.cart_url }}">Cart{% if cart.item_count > 0 %} ({{ cart.item_count }}){% endif %}</a>
  </div>
</div>
<script>
  document.querySelectorAll('.aa-header a[href*="artavenue.in"], #aaDrawer a[href*="artavenue.in"]').forEach(function(a){ a.target = '_blank'; a.rel = 'noopener'; });
</script>
