{%- assign light_cols = "Shop by Type^Pendants|/collections/lighting/pendants;Chandeliers|/collections/lighting/chandeliers;Floor Lamps|/collections/lighting/floor-lamps;Table Lamps|/collections/lighting/table-lamps;Flush Mounts|/collections/lighting/flush-mounts~Shop by Room^Living Room|/collections/lighting/living-room;Dining|/collections/lighting/dining;Bedroom|/collections/lighting/bedroom;Entryway|/collections/lighting/entryway~Shop by Material^Brass|/collections/lighting/brass;Stone & Marble|/collections/lighting/stone;Glass|/collections/lighting/glass;Rattan|/collections/lighting/rattan" -%}

{%- assign decor_cols = "Shop by Type^Vases|/collections/decor/vases;Vessels|/collections/decor/vessels;Trays|/collections/decor/trays;Bowls|/collections/decor/bowls;Objects|/collections/decor/objects~Shop by Room^Living Room|/collections/decor/living-room;Dining|/collections/decor/dining;Bedroom|/collections/decor/bedroom;Entryway|/collections/decor/entryway~Shop by Material^Ceramic|/collections/decor/ceramic;Stone|/collections/decor/stone;Brass|/collections/decor/brass;Glass|/collections/decor/glass" -%}

{%- assign wall_cols = "Medium^Original Works|/collections/wall-art/original;Limited Prints|/collections/wall-art/prints;Textile Art|/collections/wall-art/textile;Photography|/collections/wall-art/photography~Format^Framed|/collections/wall-art/framed;Canvas|/collections/wall-art/canvas;Diptych & Triptych|/collections/wall-art/diptych~Shop by Room^Living Room|/collections/wall-art/living-room;Bedroom|/collections/wall-art/bedroom;Study|/collections/wall-art/study" -%}

<header class="aa-header">
  <div class="aa-header__bar">
    <button class="aa-burger" aria-label="Open menu" onclick="document.getElementById('aaDrawer').classList.add('is-open');document.body.style.overflow='hidden';"><i class="ph ph-list"></i></button>
    <nav class="aa-nav">
      <div class="aa-nav__item">
        <a class="aa-nav__top" href="/collections/furniture">Furniture <i class="ph ph-caret-down" style="font-size:9px"></i></a>
        <div class="aa-mega">{% render 'aa-mega-rail', rail: furn_rail, feat_eyebrow: 'Featured Collection', feat_title: 'The Marwar Collection', feat_url: '/collections/the-marwar-collection' %}</div>
      </div>
      <div class="aa-nav__item">
        <a class="aa-nav__top" href="/collections/rugs">Rugs <i class="ph ph-caret-down" style="font-size:9px"></i></a>
        <div class="aa-mega">{% render 'aa-mega-rail', rail: rug_rail, feat_eyebrow: 'Bespoke', feat_title: 'Custom Rugs', feat_url: '/pages/custom' %}</div>
      </div>
      <div class="aa-nav__item">
        <a class="aa-nav__top" href="/collections/lighting">Lighting <i class="ph ph-caret-down" style="font-size:9px"></i></a>
        <div class="aa-mega">{% render 'aa-mega-cols', cols: light_cols, feat_eyebrow: 'Featured', feat_title: 'Brass Meridian', feat_url: '/collections/lighting', discover: 'New Arrivals|/collections/new-arrivals;Best Sellers|/collections/lighting?sort_by=best-selling' %}</div>
      </div>
      <div class="aa-nav__item">
        <a class="aa-nav__top" href="/collections/decor">Decor <i class="ph ph-caret-down" style="font-size:9px"></i></a>
        <div class="aa-mega">{% render 'aa-mega-cols', cols: decor_cols, feat_eyebrow: 'Gallery', feat_title: 'The Object Library', feat_url: '/collections/decor', discover: 'New Arrivals|/collections/new-arrivals;Best Sellers|/collections/decor?sort_by=best-selling' %}</div>
      </div>
      <div class="aa-nav__item">
        <a class="aa-nav__top" href="/collections/wall-art">Wall Art <i class="ph ph-caret-down" style="font-size:9px"></i></a>
        <div class="aa-mega">{% render 'aa-mega-cols', cols: wall_cols, feat_eyebrow: 'Gallery', feat_title: 'Commissioned Works', feat_url: '/pages/custom', discover: 'Commissioned Works|/pages/custom;New Arrivals|/collections/new-arrivals' %}</div>
      </div>
    </nav>

    <a class="aa-wordmark" href="{{ routes.root_url }}"><b>Art Avenue</b><small>Design House</small></a>

    <div class="aa-nav__icons">
      <div class="aa-nav__item"><a class="aa-nav__top" href="/pages/atelier">Discover</a></div>
      <div class="aa-nav__item"><a class="aa-nav__top" href="/pages/custom">Custom &amp; Bespoke</a></div>
      <div class="aa-nav__item"><a class="aa-nav__top" href="/pages/trade">Trade</a></div>
      <span style="width:1px;height:18px;background:currentColor;opacity:.22"></span>
      <a href="{{ routes.search_url }}" aria-label="Search"><i class="ph-light ph-magnifying-glass"></i></a>
      <a href="{{ routes.account_url }}" aria-label="Account"><i class="ph-light ph-user"></i></a>
      <a href="{{ routes.cart_url }}" aria-label="Cart"><i class="ph-light ph-handbag-simple"></i></a>
    </div>
  </div>
</header>

{%- comment -%} Mobile drawer — top categories + discover {%- endcomment -%}
<div class="aa-drawer" id="aaDrawer">
  <div class="aa-drawer__top">
    <span class="serif" style="font-size:22px;letter-spacing:.16em;text-transform:uppercase">Art Avenue</span>
    <button aria-label="Close menu" style="background:none;border:none;font-size:24px;cursor:pointer" onclick="document.getElementById('aaDrawer').classList.remove('is-open');document.body.style.overflow='';"><i class="ph ph-x"></i></button>
  </div>
  {% render 'aa-drawer-accordion', label: 'Furniture', url: '/collections/furniture', rail: furn_rail, show: 'Shop by Category,Shop by Room' %}
  {% render 'aa-drawer-accordion', label: 'Rugs', url: '/collections/rugs', rail: rug_rail, show: 'Shop by Construction,Shop by Material' %}
  {% render 'aa-drawer-accordion', label: 'Lighting', url: '/collections/lighting', cols: light_cols, show: 'Shop by Type,Shop by Room' %}
  {% render 'aa-drawer-accordion', label: 'Decor', url: '/collections/decor', cols: decor_cols, show: 'Shop by Type' %}
  {% render 'aa-drawer-accordion', label: 'Wall Art', url: '/collections/wall-art', cols: wall_cols, show: 'Medium' %}
  <a class="aa-drawer__top-link" href="/pages/atelier">Discover</a>
  <a class="aa-drawer__top-link" href="/pages/custom">Custom &amp; Bespoke</a>
  <a class="aa-drawer__top-link" href="/pages/trade">Trade</a>
  <div style="margin-top:24px;display:flex;gap:20px">
    <a href="{{ routes.search_url }}">Search</a><a href="{{ routes.account_url }}">Account</a><a href="{{ routes.cart_url }}">Cart</a>
  </div>
</div>
