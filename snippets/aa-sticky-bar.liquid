{%- comment -%} Sticky buy bar — reveals on scroll. params: product, show_cart, price_text {%- endcomment -%}
{%- capture consult -%}{% render 'aa-lead-url', type:'consultation', product: product %}{%- endcapture -%}
<div class="aa-stickybar" data-aa-sticky>
  <div class="aa-stickybar__in">
    <div class="aa-stickybar__name"><b>{{ product.title }}</b><span data-sticky-price data-aa-price-display>{{ price_text }}</span></div>
    <a class="btn btn--secondary aa-stickybar__consult" href="{{ consult | strip }}" target="_blank" rel="noopener" aria-label="Consult"><i class="ph ph-chat-teardrop-dots"></i><span class="aa-stickybar__consult-tx"> Consult</span></a>
    {%- if show_cart -%}
      {%- form 'product', product -%}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-sticky-id><button class="btn btn--primary" type="submit" data-sticky-submit>Add to Cart</button>{%- endform -%}
    {%- else -%}
      <a class="btn btn--primary" href="{{ consult | strip }}" target="_blank" rel="noopener">Enquire</a>
    {%- endif -%}
  </div>
</div>

<script>
(function(){
  if(window.aaStickySyncInit) return;
  window.aaStickySyncInit = true;
  function bind(){
    var rug = document.querySelector('[data-aa-rug]');
    if(!rug) return;
    var idEl = document.querySelector('[data-sticky-id]');
    var subEl = document.querySelector('[data-sticky-submit]');
    var consultEl = document.querySelector('.aa-stickybar__consult');
    function sync(btn){
      if(!btn) return;
      if(btn.dataset.custom){
        if(subEl) subEl.style.display = 'none';
        if(consultEl) consultEl.style.flex = '1';
        return;
      }
      if(subEl) subEl.style.display = '';
      if(consultEl) consultEl.style.flex = '';
      if(idEl && btn.dataset.vid) idEl.value = btn.dataset.vid;
    }
    rug.addEventListener('click', function(e){
      var b = e.target.closest('[data-rug-size]');
      if(b) sync(b);
    });
    sync(rug.querySelector('[data-rug-size].is-active'));
  }
  if(document.readyState === 'loading'){ document.addEventListener('DOMContentLoaded', bind); } else { bind(); }
})();
</script>
<script>
/* Sticky-bar property mirror (Oct 2026). Configurators (chair/sofa/customize/picker-links) write
   properties[...] and the variant id only into the main buy form (.aa-buyrow form). The sticky
   bar is its own <form>, so adding from it dropped every chosen finish. Right before the sticky
   form submits, mirror the main form's id + non-empty properties[...] into it (stale copies
   removed first). Runs on click (fires before submit and before any capture-phase submit
   handlers such as aa-addon) and again on submit as a fallback. */
(function(){
  if(window.aaStickyPropsInit) return; window.aaStickyPropsInit = true;
  function mainForm(){ return document.querySelector('.aa-buyrow form') || document.querySelector('.aa-buybox form[action*="/cart/add"]'); }
  function mirror(sf){
    var mf = mainForm(); if(!mf || mf === sf) return;
    sf.querySelectorAll('[data-aa-mirror]').forEach(function(n){ n.remove(); });
    var mid = mf.querySelector('input[name="id"], select[name="id"]');
    var sid = sf.querySelector('input[name="id"]');
    if(mid && mid.value && sid){ sid.value = mid.value; }
    mf.querySelectorAll('[name^="properties["]').forEach(function(src){
      if(src.disabled || !src.value) return;
      if((src.type==='radio'||src.type==='checkbox') && !src.checked) return;
      var i = document.createElement('input'); i.type='hidden'; i.name=src.name; i.value=src.value;
      i.setAttribute('data-aa-mirror',''); sf.appendChild(i);
    });
  }
  function stickyForm(el){ var f = el && el.closest && el.closest('.aa-stickybar form'); return f || null; }
  document.addEventListener('click', function(e){ var b = e.target.closest && e.target.closest('.aa-stickybar [type="submit"]'); if(b){ var f=stickyForm(b); if(f) mirror(f); } }, true);
  document.addEventListener('submit', function(e){ var f = e.target; if(f && f.closest && f.closest('.aa-stickybar')) mirror(f); }, true);
})();
</script>
