{%- comment -%} Art Avenue — Customization band {%- endcomment -%}
<section class="module module--customization module--feature aa-surface-tint">
  <div class="aa-split">
    <div>
      <p class="aa-eyebrow module__eyebrow">Customization</p>
      <h2 class="aa-h2">Make it yours</h2>
      <p class="aa-lead aa-measure">Adjust dimensions, choose a finish, or specify your own upholstery. Our atelier tailors this piece to your space — speak with a consultant to begin.</p>
      <a class="aa-btn aa-btn--primary" style="margin-top:var(--space-md)" href="{%- render 'aa-lead-url', type: 'custom', product: product -%}"><i class="ph ph-pencil-ruler"></i> Customize this piece</a>
    </div>
    <div class="aa-card__media aa-fig aa-fig--clay" style="aspect-ratio:4/3"></div>
  </div>
</section>
