<section class="aa-tallblock" style="position:relative;min-height:640px;display:flex;align-items:flex-end">
  {% render 'aa-figure', tone:'espresso', class:'aa-full-bg' %}
  <div style="position:absolute;inset:0;background:linear-gradient(to top,rgba(28,25,22,.82),rgba(28,25,22,.32) 55%,rgba(28,25,22,.45))"></div>
  <div class="aa-wrap" style="position:relative;width:100%;padding-top:88px;padding-bottom:64px"><div style="max-width:760px">
    <span class="aa-eyebrow aa-eyebrow--on-dark aa-eyebrow--rule">Custom &amp; Bespoke · The Atelier</span>
    <h1 class="aa-display-1" style="color:var(--text-on-dark);margin-top:22px">Made for your space, <em class="accent">down to the last detail.</em></h1>
    <p class="aa-lead" style="color:rgba(250,246,239,.88);max-width:560px;margin-top:22px">Most of what we make begins as a conversation, not a catalogue. Tell us about your room, your project or your collection — and our ateliers will craft it to suit.</p>
    <div style="margin-top:36px"><a class="btn btn--primary" href="#cb-enquire">Start a Project</a></div>
  </div></div>
</section>
<section class="aa-section"><div class="aa-wrap">
  <h2 class="aa-h1" style="margin-bottom:44px">What we make to order</h2>
  <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--border-hairline);border:1px solid var(--border-hairline)">
    {%- assign ds = "ph-armchair|Custom Furniture|Pieces drawn to your dimensions, woods and finishes.~ph-scribble-loop|Custom Rugs|Bespoke sizes, colourways and motifs, hand-knotted to your floor plan.~ph-needle|Custom Upholstery|Your own fabric (COM) or ours, with bespoke fills and detailing.~ph-house-line|Interior Projects|Whole-room and whole-home schemes, sourced, made and installed.~ph-buildings|Hospitality Projects|Contract-grade furniture, rugs and lighting at scale.~ph-pen-nib|Designer Collaborations|Co-created collections and one-of-a-kind commissions.~ph-package|Project Procurement|Lead-time planning, logistics and delivery." | split: "~" -%}
    {%- for d in ds -%}{%- assign dp = d | split:"|" -%}<div style="background:var(--surface-page);padding:34px 30px;min-height:210px;display:flex;flex-direction:column"><i class="ph-light {{ dp[0] }}" style="font-size:30px;color:var(--accent-deep)"></i><h3 class="serif" style="font-size:23px;margin:22px 0 10px">{{ dp[1] }}</h3><p style="font-size:14px;line-height:1.62;color:var(--text-secondary)">{{ dp[2] }}</p></div>{%- endfor -%}
    <div class="aa-dark" style="padding:34px 30px;display:flex;flex-direction:column;justify-content:center"><h3 class="serif" style="font-size:22px;color:var(--text-on-dark)">Not sure where to start?</h3><p style="font-size:13.5px;color:var(--text-on-dark-muted);margin:10px 0 18px">Tell us the room and we'll guide the rest.</p></div>
  </div>
</div></section>
<section id="cb-enquire" class="aa-section"><div class="aa-wrap" style="display:grid;grid-template-columns:.85fr 1.15fr;gap:clamp(40px,6vw,96px);align-items:start">
  <div><span class="aa-eyebrow aa-eyebrow--rule">Start a Project</span><h2 class="aa-h1" style="margin-top:18px">Tell us about your space.</h2><p class="aa-lead" style="margin-top:18px;max-width:42ch">Share a few details and a dedicated design consultant will be in touch within two business days — no obligation.</p></div>
  {% form 'contact' %}
    {% if form.posted_successfully? %}<p style="grid-column:1/-1;color:var(--text-accent)">Thank you — a consultant will be in touch shortly.</p>{% endif %}
    <div class="aa-form">
      <input type="hidden" name="contact[lead_type]" value="custom">
      <div class="grid-2"><div><label>First name</label><input name="contact[first_name]" required></div><div><label>Last name</label><input name="contact[last_name]"></div></div>
      <div class="grid-2"><div><label>Email</label><input type="email" name="contact[email]" required></div><div><label>Phone</label><input type="tel" name="contact[phone]"></div></div>
      <div><label>Project type</label><select name="contact[project_type]"><option>Custom Furniture</option><option>Custom Rugs</option><option>Custom Upholstery</option><option>Interior Project</option><option>Hospitality Project</option></select></div>
      <div><label>Tell us about your project</label><textarea name="contact[body]" placeholder="The room or property, how you'll use it, references…"></textarea></div>
      <button class="btn btn--primary btn--block" type="submit">Submit Enquiry</button>
    </div>
  {% endform %}
</div></section>
{% schema %}{ "name": "Art Avenue Custom", "settings": [] }{% endschema %}
