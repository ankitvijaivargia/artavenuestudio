<section class="aa-hero" style="position:relative;height:88vh;min-height:620px;display:flex;align-items:flex-end">
  {% render 'aa-figure', tone: section.settings.tone, class: 'aa-hero__bg' %}
  <div style="position:absolute;inset:0;background:linear-gradient(to top,rgba(34,31,27,.5),rgba(34,31,27,.12) 45%,rgba(34,31,27,.28))"></div>
  <div class="aa-wrap" style="position:relative;padding-bottom:clamp(56px,8vh,110px);width:100%">
    <div style="max-width:760px">
      <span class="aa-eyebrow aa-eyebrow--on-dark">{{ section.settings.eyebrow }}</span>
      <h1 class="aa-display-1 on-dark" style="color:var(--text-on-dark);margin-top:22px">{{ section.settings.heading }}</h1>
      <p class="aa-lead" style="color:rgba(250,246,239,.86);max-width:480px;margin-top:24px">{{ section.settings.subheading }}</p>
      <div style="display:flex;gap:16px;margin-top:36px;flex-wrap:wrap">
        <a class="btn btn--primary" href="{{ section.settings.cta_link | default: '/collections/all' }}">{{ section.settings.cta_label }}</a>
        <a class="btn btn--secondary btn--on-dark" href="/pages/trade">Trade &amp; Design <i class="ph ph-arrow-right"></i></a>
      </div>
    </div>
  </div>
</section>
{% schema %}
{ "name":"AA Hero","settings":[
  {"type":"text","id":"eyebrow","label":"Eyebrow","default":"The Spring Collection · 2026"},
  {"type":"text","id":"heading","label":"Heading","default":"Crafted spaces, collected stories."},
  {"type":"textarea","id":"subheading","label":"Subheading","default":"Handcrafted furniture, rugs and objects for homes that are made to be lived in — and remembered."},
  {"type":"text","id":"cta_label","label":"Button label","default":"Explore the Collection"},
  {"type":"url","id":"cta_link","label":"Button link"},
  {"type":"image_picker","id":"image","label":"Background image"},
  {"type":"select","id":"tone","label":"Placeholder tone","default":"clay","options":[{"value":"clay","label":"Clay"},{"value":"espresso","label":"Espresso"},{"value":"olive","label":"Olive"},{"value":"sand","label":"Sand"}]}
],"presets":[{"name":"AA Hero"}]}
{% endschema %}
