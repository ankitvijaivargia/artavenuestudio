<section class="aa-section"><div class="aa-wrap">
  <span class="aa-eyebrow aa-eyebrow--rule">The Journal</span>
  <h1 class="aa-display-2" style="margin:16px 0 40px">Design notes &amp; stories</h1>
  <div class="grid-3">
    {%- for article in blog.articles -%}
      <a href="{{ article.url }}" style="color:inherit">
        {% if article.image %}<div class="aa-fig" style="aspect-ratio:3/2"><img src="{{ article.image | image_url: width:900 }}" alt="{{ article.title }}"></div>{% else %}{% render 'aa-figure', tone:'stone', ratio:'3/2' %}{% endif %}
        <h3 class="serif" style="font-size:24px;line-height:1.2;margin-top:14px">{{ article.title }}</h3>
      </a>
    {%- endfor -%}
  </div>
</div></section>
{% schema %}{ "name": "Blog", "settings": [] }{% endschema %}
