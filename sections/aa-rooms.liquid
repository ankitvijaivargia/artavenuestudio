<section class="aa-section aa-alt">
  <div class="aa-wrap" style="text-align:center;max-width:720px;margin:0 auto"><span class="aa-eyebrow aa-eyebrow--center aa-eyebrow--rule">{{ section.settings.eyebrow }}</span><h2 class="aa-display-2" style="margin-top:18px">{{ section.settings.heading }}</h2><p class="aa-lead" style="margin:18px auto 0">{{ section.settings.intro }}</p></div>
  <div style="display:flex;gap:var(--gap-tile);margin-top:48px;overflow:hidden">
    {% for block in section.blocks %}
      <a class="aa-tile" href="{{ block.settings.link | default:'#' }}" {{ block.shopify_attributes }} style="flex:1;min-height:440px;border-radius:0">
        {% render 'aa-figure', tone: block.settings.tone, class:'aa-tile__bg' %}<span class="aa-tile__scrim"></span>
        <span class="aa-tile__inner"><span class="aa-tile__title">{{ block.settings.title }}</span><span class="aa-tile__cta">Shop the room <i class="ph ph-arrow-right"></i></span></span>
      </a>
    {% endfor %}
  </div>
</section>
{% schema %}
{ "name":"AA Shop by Room","max_blocks":6,"settings":[
  {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Shop by Room"},
  {"type":"text","id":"heading","label":"Heading","default":"Begin with the space."},
  {"type":"textarea","id":"intro","label":"Intro","default":"See how our pieces live together — then make the room your own."}
],"blocks":[{"type":"room","name":"Room","settings":[{"type":"text","id":"title","label":"Title"},{"type":"url","id":"link","label":"Link"},{"type":"select","id":"tone","label":"Tone","default":"clay","options":[{"value":"clay","label":"Clay"},{"value":"espresso","label":"Espresso"},{"value":"stone","label":"Stone"},{"value":"olive","label":"Olive"},{"value":"bronze","label":"Bronze"}]}]}],
"presets":[{"name":"AA Shop by Room","blocks":[
  {"type":"room","settings":{"title":"Living Room","tone":"clay"}},{"type":"room","settings":{"title":"Dining","tone":"espresso"}},
  {"type":"room","settings":{"title":"Bedroom","tone":"stone"}},{"type":"room","settings":{"title":"Study","tone":"olive"}},{"type":"room","settings":{"title":"Outdoor","tone":"bronze"}}
]}]}
{% endschema %}
