{%- comment -%} Art Avenue — edge-to-edge image + text band. Image falls back to a product's featured image. {%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign img = s.image
  if img == blank and s.product != blank
    assign img = s.product.featured_image
  endif
-%}
<style>
  #aaf-{{ section.id }}{display:grid;grid-template-columns:1fr 1fr;align-items:stretch;{% if s.bg == 'dark' %}background:var(--surface-dark);color:var(--text-on-dark);{% elsif s.bg == 'alt' %}background:var(--surface-alt,#efe8dc);{% else %}background:var(--surface-page);{% endif %}}
  #aaf-{{ section.id }} .aaf-img{position:relative;min-height:clamp(420px,52vw,760px);overflow:hidden;display:block;{% if s.reverse %}order:2;{% endif %}}
  #aaf-{{ section.id }} .aaf-img img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform 1.4s var(--ease-luxe);}
  #aaf-{{ section.id }} .aaf-img:hover img{transform:scale(1.03);}
  #aaf-{{ section.id }} .aaf-copy{display:flex;flex-direction:column;justify-content:center;padding:clamp(48px,7vw,120px) clamp(28px,6vw,110px);}
  #aaf-{{ section.id }} .aaf-body{margin-top:20px;max-width:500px;}
  #aaf-{{ section.id }} .aaf-body p{margin:0 0 14px;}
  #aaf-{{ section.id }} .aaf-pts{list-style:none;margin:26px 0 0;padding:0;display:grid;gap:12px;max-width:500px;}
  #aaf-{{ section.id }} .aaf-pts li{display:flex;gap:12px;align-items:baseline;font-size:15px;{% if s.bg == 'dark' %}color:var(--text-on-dark-muted);{% else %}color:var(--text-secondary);{% endif %}}
  #aaf-{{ section.id }} .aaf-pts li::before{content:"";flex:0 0 5px;height:5px;border-radius:50%;background:var(--accent);transform:translateY(-3px);}
  #aaf-{{ section.id }} .aaf-ctas{display:flex;gap:14px;flex-wrap:wrap;margin-top:34px;}
  @media (max-width:899px){
    #aaf-{{ section.id }}{grid-template-columns:1fr;}
    #aaf-{{ section.id }} .aaf-img{order:0;min-height:0;aspect-ratio:4/5;}
  }
</style>
<section id="aaf-{{ section.id }}">
  <a class="aaf-img" href="{% if s.product != blank %}{{ s.product.url }}{% else %}{{ s.cta_link | default: '#' }}{% endif %}" aria-label="{{ s.heading | escape }}">
    {%- if img -%}
      {{ img | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1600', sizes: '(min-width: 900px) 50vw, 100vw', alt: img.alt }}
    {%- else -%}{% render 'aa-figure', tone: 'espresso', class: 'aa-full-bg' %}{%- endif -%}
  </a>
  <div class="aaf-copy">
    {%- if s.eyebrow != blank -%}<span class="aa-eyebrow aa-eyebrow--rule{% if s.bg == 'dark' %} aa-eyebrow--on-dark{% endif %}">{{ s.eyebrow }}</span>{%- endif -%}
    <h2 class="aa-display-2" style="margin-top:18px{% if s.bg == 'dark' %};color:var(--text-on-dark){% endif %}">{{ s.heading }}</h2>
    {%- if s.body != blank -%}<div class="aa-lead aaf-body"{% if s.bg == 'dark' %} style="color:var(--text-on-dark-muted)"{% endif %}>{{ s.body }}</div>{%- endif -%}
    {%- if s.points != blank -%}
      {%- assign pts = s.points | newline_to_br | split: '<br />' -%}
      <ul class="aaf-pts">{%- for p in pts -%}{%- assign pt = p | strip -%}{%- if pt != blank -%}<li>{{ pt }}</li>{%- endif -%}{%- endfor -%}</ul>
    {%- endif -%}
    <div class="aaf-ctas">
      {%- if s.cta_label != blank -%}<a class="btn {% if s.bg == 'dark' %}btn--secondary btn--on-dark{% else %}btn--primary{% endif %}" href="{{ s.cta_link | default: '#' }}">{{ s.cta_label }}</a>{%- endif -%}
      {%- if s.cta2_label != blank -%}<a class="btn btn--ghost"{% if s.bg == 'dark' %} style="color:var(--text-on-dark)"{% endif %} href="{{ s.cta2_link | default: '#' }}">{{ s.cta2_label }} <i class="ph ph-arrow-right"></i></a>{%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{ "name":"AA Image Band","settings":[
  {"type":"image_picker","id":"image","label":"Image (overrides product)"},
  {"type":"product","id":"product","label":"Product (image + link)"},
  {"type":"checkbox","id":"reverse","label":"Image on right","default":false},
  {"type":"select","id":"bg","label":"Background","default":"page","options":[{"value":"page","label":"Page"},{"value":"alt","label":"Alt"},{"value":"dark","label":"Dark"}]},
  {"type":"text","id":"eyebrow","label":"Eyebrow"},
  {"type":"text","id":"heading","label":"Heading"},
  {"type":"richtext","id":"body","label":"Body"},
  {"type":"textarea","id":"points","label":"Bullet points (one per line)"},
  {"type":"text","id":"cta_label","label":"Primary button"},
  {"type":"url","id":"cta_link","label":"Primary link"},
  {"type":"text","id":"cta2_label","label":"Secondary button"},
  {"type":"url","id":"cta2_link","label":"Secondary link"}
],"presets":[{"name":"AA Image Band"}]}
{% endschema %}
