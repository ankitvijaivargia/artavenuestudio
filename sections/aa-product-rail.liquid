{%- comment -%} Art Avenue — featured product rail (New Arrivals / Best Sellers) {%- endcomment -%}
{%- assign s = section.settings -%}
{%- assign coll = collections[s.collection] -%}
{%- assign rail_limit = s.limit | default: 4 -%}
<section class="aa-section {% if s.bg == 'alt' %}aa-surface-alt{% endif %}">
  <div class="aa-container">
    <div style="display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:20px">
      <div class="aa-section-head">
        {%- if s.eyebrow != blank -%}<p class="aa-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="aa-h1" style="margin-top:12px">{{ s.heading }}</h2>{%- endif -%}
      </div>
      {%- if coll -%}<a class="aa-btn aa-btn--ghost" href="{{ coll.url }}">View all <i class="ph ph-arrow-right"></i></a>{%- endif -%}
    </div>
    <div class="aa-tiles aa-tiles--4" style="margin-top:var(--space-xl)">
      {%- if coll -%}
        {%- for product in coll.products limit: rail_limit -%}
          {%- render 'aa-product-card', product: product -%}
        {%- endfor -%}
      {%- else -%}
        <p class="aa-body aa-muted">Pick a collection in the theme editor to populate this rail.</p>
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "AA Product Rail",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Just Arrived" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "New this season" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "min": 2, "max": 8, "step": 1, "label": "Products", "default": 4 },
    { "type": "select", "id": "bg", "label": "Background", "options": [ { "value": "page", "label": "Page" }, { "value": "alt", "label": "Alt" } ], "default": "page" }
  ],
  "presets": [{ "name": "AA Product Rail" }]
}
{% endschema %}
