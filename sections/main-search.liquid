<section class="aa-section"><div class="aa-wrap">
  <span class="aa-eyebrow aa-eyebrow--rule">Search</span>
  <form action="{{ routes.search_url }}" method="get" style="margin:18px 0 40px;max-width:560px;display:flex;gap:12px">
    <input class="aa-control" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search the collection">
    <button class="btn btn--primary" type="submit">Search</button>
  </form>
  {%- if search.performed -%}
    <p style="color:var(--text-muted);margin-bottom:24px">{{ search.results_count }} results for &ldquo;{{ search.terms }}&rdquo;</p>
    <div class="grid-4">{%- for item in search.results -%}{%- if item.object_type == 'product' -%}{% render 'aa-product-card', product: item %}{%- endif -%}{%- endfor -%}</div>
  {%- endif -%}
</div></section>
{% schema %}{ "name": "Search", "settings": [] }{% endschema %}
