{%- comment -%}
  Art Avenue — collection page.
  No placeholder art: every image slot (hero banner, Shop by Room, the made-to-measure
  band, Continue Exploring) uses the collection image if one is set, otherwise a real
  product photo from that collection. Tiles for collections with no live products (or
  that don't exist) are skipped, so hidden categories never appear.
  The whole section sits inside paginate so product images can be read safely.
{%- endcomment -%}
{%- assign col = collection -%}
{%- assign t = col.title | downcase -%}
{%- assign isRug = false -%}{%- if t contains 'rug' -%}{%- assign isRug = true -%}{%- endif -%}

{%- paginate col.products by 9 -%}
{%- liquid
  assign used = ','

  assign hero_img = col.image
  if hero_img == blank
    for p in col.products
      if p.featured_image and p.featured_image.aspect_ratio >= 1.2
        assign hero_img = p.featured_image
        break
      endif
    endfor
  endif
  if hero_img == blank
    for p in col.products
      if p.featured_image
        assign hero_img = p.featured_image
        break
      endif
    endfor
  endif
  if hero_img
    assign used = used | append: hero_img.id | append: ','
  endif

  assign mid_img = blank
  for p in col.products offset: 6
    if p.featured_image
      assign k = ',' | append: p.featured_image.id | append: ','
      unless used contains k
        assign mid_img = p.featured_image
        break
      endunless
    endif
  endfor

  if isRug
    assign rooms = 'living-room-rugs|Living Room,bedroom-rugs|Bedroom,dining-room-rugs|Dining' | split: ','
    assign rel = 'hand-knotted-rugs|Hand-Knotted Rugs,hand-tufted-rugs|Hand-Tufted Rugs,abstract-rugs|Abstract Rugs,flat-weave-rugs|Flat-Weave Rugs,custom-rugs|Custom Rugs,furniture|Furniture' | split: ','
  else
    assign rooms = 'living-room-furniture|Living Room,bedroom-furniture|Bedroom,dining-furniture|Dining,outdoor-furniture|Outdoor' | split: ','
    assign rel = 'sofas|Sofas,beds|Beds,coffee-tables|Coffee Tables,chairs-and-ottomans|Armchairs & Ottomans,sideboards|Sideboards,bedside-tables|Bedside Tables,trunks|Trunks,chests-of-drawers|Chests of Drawers,cabinets|Cabinets,console-tables|Console Tables,dining-furniture|Dining' | split: ','
  endif

  assign room_count = 0
  for r in rooms
    assign rp = r | split: '|'
    assign rc = collections[rp[0]]
    if rc.products_count > 0 and rp[0] != col.handle
      assign room_count = room_count | plus: 1
    endif
  endfor
-%}

{%- comment -%} Collection hero {%- endcomment -%}
<section style="position:relative;height:420px;display:flex;align-items:center;text-align:center">
  {%- if hero_img -%}
    <div class="aa-fig aa-full-bg">{{ hero_img | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '800, 1200, 1600, 2000, 2400', sizes: '100vw', alt: col.title }}</div>
  {%- else -%}
    {% render 'aa-figure', tone:'espresso', class:'aa-full-bg' %}
  {%- endif -%}
  <div style="position:absolute;inset:0;background:linear-gradient(to top,rgba(34,31,27,.62),rgba(34,31,27,.38))"></div>
  <div style="position:relative;max-width:720px;margin:0 auto;padding:0 var(--gutter)">
    <span class="aa-eyebrow aa-eyebrow--on-dark aa-eyebrow--center">{% if isRug %}The Rug Atelier{% else %}Signature Collection{% endif %}</span>
    <h1 class="aa-display-2" style="color:var(--text-on-dark);margin-top:16px">{{ col.title }}</h1>
    {%- if col.description != blank -%}<p class="aa-lead" style="color:rgba(250,246,239,.88);margin-top:16px">{{ col.description | strip_html | truncatewords: 32 }}</p>{%- endif -%}
    {%- if isRug -%}<div style="margin-top:26px"><a class="btn btn--secondary" href="#aa-edit" style="border-color:rgba(250,246,239,.4);color:#fff">Need help choosing a rug size? <i class="ph ph-arrow-right"></i></a></div>{%- endif -%}
  </div>
</section>

{%- comment -%} Merchandising — Shop the way you design {%- endcomment -%}
<section class="aa-wrap" id="aa-edit" style="padding-top:var(--section-y-tight)">
  <div style="max-width:640px"><span class="aa-eyebrow aa-eyebrow--rule">Begin Your Edit</span><h2 class="aa-h1" style="margin:14px 0 0">Shop the way you design.</h2></div>

  {%- if room_count > 0 -%}
  <style>
    .aa-col-roomrail{display:grid;grid-template-columns:repeat({{ room_count }},minmax(0,1fr));gap:var(--gap-card);}
    @media (max-width:680px){ .aa-col-roomrail{grid-template-columns:repeat({% if room_count > 1 %}2{% else %}1{% endif %},minmax(0,1fr));} }
  </style>
  <div style="margin-top:30px">
    <div class="aa-eyebrow" style="margin-bottom:16px">Shop by Room</div>
    <div class="aa-col-roomrail">
      {%- for r in rooms -%}
        {%- liquid
          assign rp = r | split: '|'
          assign rc = collections[rp[0]]
          assign live = false
          if rc.products_count > 0
            assign live = true
          endif
          if live == false or rp[0] == col.handle
            continue
          endif
          assign timg = rc.image
          if timg == blank
            for p in rc.products limit: 12
              if p.featured_image
                assign k = ',' | append: p.featured_image.id | append: ','
                unless used contains k
                  assign timg = p.featured_image
                  break
                endunless
              endif
            endfor
          endif
          if timg == blank
            assign timg = rc.products.first.featured_image
          endif
          if timg
            assign used = used | append: timg.id | append: ','
          endif
        -%}
        <a class="aa-tile" href="{{ rc.url }}" style="min-height:200px;border-radius:var(--radius-xs)">
          {%- if timg -%}<div class="aa-fig aa-tile__bg">{{ timg | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 900px) 30vw, 50vw', alt: rp[1] }}</div>{%- else -%}{% render 'aa-figure', tone: 'clay', class:'aa-tile__bg' %}{%- endif -%}
          <span class="aa-tile__scrim"></span><span class="aa-tile__inner"><span class="aa-tile__title" style="font-size:20px">{{ rp[1] }}</span></span>
        </a>
      {%- endfor -%}
    </div>
  </div>
  {%- endif -%}

  {%- if col.all_tags.size > 0 -%}
  <div style="margin-top:30px">
    <div class="aa-eyebrow" style="margin-bottom:14px">Refine by</div>
    <div style="display:flex;gap:10px;flex-wrap:wrap">
      {%- for tag in col.all_tags limit: 12 -%}
        {%- assign tl = tag | downcase -%}
        {%- unless tl contains 'room' or tl == 'aa-demo' or tl == 'aa-catalogue' or tl == 'rug' or tl == 'rugs' -%}
          {%- assign label = tag | replace: '-rugs', '' | replace: '-', ' ' | capitalize -%}
          <a href="/collections/{{ col.handle }}/{{ tag | handleize }}" style="padding:9px 18px;border-radius:var(--radius-pill);font-size:13px;color:var(--text-secondary);border:1px solid var(--border-strong);text-decoration:none">{{ label }}</a>
        {%- endunless -%}
      {%- endfor -%}
    </div>
  </div>
  {%- endif -%}
</section>

{%- comment -%} Sticky toolbar {%- endcomment -%}
<div style="border-top:1px solid var(--border-hairline);border-bottom:1px solid var(--border-hairline);position:sticky;top:76px;background:var(--surface-page);z-index:20;margin-top:var(--section-y-tight)">
  <div class="aa-wrap aa-col-toolbar" style="display:flex;justify-content:space-between;align-items:center;height:64px">
    <span class="aa-col-count" style="font-size:13px;color:var(--text-muted)">{{ col.products_count }} {% if col.products_count == 1 %}piece{% else %}pieces{% endif %}</span>
    {%- if col.filters.size > 0 -%}<button type="button" class="aa-col-filterbtn" onclick="window.aaToggleFilter&&window.aaToggleFilter()">Filter</button>{%- endif -%}
    <form method="get" class="aa-col-sortform" style="min-width:220px">
      <select name="sort_by" class="aa-control" onchange="this.form.submit()">
        {%- assign sb = col.sort_by | default: col.default_sort_by -%}
        <option value="manual"{% if sb == 'manual' %} selected{% endif %}>Sort: Featured</option>
        <option value="created-descending"{% if sb == 'created-descending' %} selected{% endif %}>Newest</option>
        <option value="price-ascending"{% if sb == 'price-ascending' %} selected{% endif %}>Price: Low to High</option>
        <option value="price-descending"{% if sb == 'price-descending' %} selected{% endif %}>Price: High to Low</option>
      </select>
    </form>
  </div>
</div>

{%- comment -%} Body — sidebar (native filters) + grid {%- endcomment -%}
<section class="aa-section" style="padding-top:48px">
<div class="aa-wrap aa-col-layout" style="display:grid;grid-template-columns:{% if col.filters.size > 0 %}248px 1fr{% else %}1fr{% endif %};gap:48px;align-items:start">
  {%- if col.filters.size > 0 -%}
  <aside class="aa-col-filter" style="position:sticky;top:150px;align-self:start">
    <details class="aa-col-filter__d" open>
    <summary class="aa-col-filter__sum"><div style="display:flex;justify-content:space-between;align-items:baseline;padding-bottom:4px"><span class="serif" style="font-size:22px;font-weight:500">Filter <i class="ph ph-caret-down aa-col-filter__chev"></i></span><a href="{{ col.url }}" style="font-size:12px;color:var(--text-accent)">Clear all</a></div></summary>
    <form method="get">
      {%- for f in col.filters -%}
        <div style="border-bottom:1px solid var(--border-hairline);padding:20px 0">
          <div class="aa-eyebrow" style="margin-bottom:16px">{{ f.label }}</div>
          {%- if f.type == 'price_range' -%}
            <div style="display:flex;gap:10px"><input type="number" name="{{ f.min_value.param_name }}" value="{{ f.min_value.value }}" placeholder="Min" class="aa-control" style="width:50%"><input type="number" name="{{ f.max_value.param_name }}" value="{{ f.max_value.value }}" placeholder="Max" class="aa-control" style="width:50%"></div>
            <button type="submit" class="btn btn--ghost" style="margin-top:12px">Apply</button>
          {%- else -%}
            <ul style="list-style:none;margin:0;padding:0;display:grid;gap:12px">
              {%- for v in f.values -%}
                <li><label style="display:flex;align-items:center;gap:11px;cursor:pointer;font-size:14px;color:var(--text-secondary)"><input type="checkbox" name="{{ v.param_name }}" value="{{ v.value }}"{% if v.active %} checked{% endif %} onchange="this.form.submit()"><span style="flex:1">{{ v.label }}</span><span style="color:var(--text-faint);font-size:12px">{{ v.count }}</span></label></li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </form>
    </details>
  </aside>
  <script>
    (function(){
      var d=document.currentScript.parentNode.querySelector('.aa-col-filter__d');
      function sync(){ if(window.innerWidth<=782){ d.open=false; } else { d.open=true; } }
      sync();
      window.aaToggleFilter=function(){ d.open=!d.open; if(d.open){ d.scrollIntoView({behavior:'smooth',block:'start'}); } };
    })();
  </script>
  {%- endif -%}

  <div>
    <div class="grid-3">
      {%- for product in col.products -%}
        {% render 'aa-product-card', product: product %}
        {%- if forloop.index == 6 and paginate.current_page == 1 and forloop.last == false -%}
          </div>
          <a class="aa-tile" href="/pages/custom" style="display:block;min-height:300px;border-radius:var(--radius-sm);margin:var(--gap-card) 0">
            {%- if mid_img -%}<div class="aa-fig aa-tile__bg">{{ mid_img | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '800, 1200, 1800', sizes: '(min-width: 900px) 70vw, 100vw', alt: '' }}</div>{%- else -%}{% render 'aa-figure', tone:'clay', class:'aa-tile__bg' %}{%- endif -%}
            <span class="aa-tile__scrim"></span><span class="aa-tile__inner"><span class="aa-tile__eyebrow">Made to Measure</span><span class="aa-tile__title">{% if isRug %}Need a rug in your own size?{% else %}Need it longer, lower or narrower?{% endif %}</span><span class="aa-tile__cta">Ask about custom sizes <i class="ph ph-arrow-right"></i></span></span>
          </a>
          <div class="grid-3">
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}<div style="text-align:center;margin-top:56px">{{ paginate | default_pagination }}</div>{%- endif -%}
  </div>
</div>
</section>

{%- comment -%} Related collections — the next three live categories after this one {%- endcomment -%}
{%- liquid
  assign n = rel.size
  assign idx = -1
  for c in rel
    assign cp = c | split: '|'
    if cp[0] == col.handle
      assign idx = forloop.index0
    endif
  endfor
-%}
<section class="aa-section aa-alt"><div class="aa-wrap">
  <span class="aa-eyebrow aa-eyebrow--rule">Continue Exploring</span>
  <div class="grid-3" style="margin-top:32px">
    {%- assign rn = 0 -%}
    {%- for i in (1..n) -%}
      {%- liquid
        if rn >= 3
          break
        endif
        assign j = idx | plus: i | modulo: n
        assign cp = rel[j] | split: '|'
        assign rc = collections[cp[0]]
        assign live = false
        if rc.products_count > 0
          assign live = true
        endif
        if live == false or cp[0] == col.handle
          continue
        endif
        assign timg = rc.image
        if timg == blank
          for p in rc.products limit: 12
            if p.featured_image
              assign k = ',' | append: p.featured_image.id | append: ','
              unless used contains k
                assign timg = p.featured_image
                break
              endunless
            endif
          endfor
        endif
        if timg == blank
          assign timg = rc.products.first.featured_image
        endif
        if timg
          assign used = used | append: timg.id | append: ','
        endif
        assign rn = rn | plus: 1
      -%}
      <a class="aa-tile" href="{{ rc.url }}" style="min-height:300px">
        {%- if timg -%}<div class="aa-fig aa-tile__bg">{{ timg | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 900px) 33vw, 50vw', alt: cp[1] }}</div>{%- else -%}{% render 'aa-figure', tone: 'clay', class:'aa-tile__bg' %}{%- endif -%}
        <span class="aa-tile__scrim"></span><span class="aa-tile__inner"><span class="aa-tile__title">{{ cp[1] }}</span><span class="aa-tile__cta">Explore <i class="ph ph-arrow-right"></i></span></span>
      </a>
    {%- endfor -%}
  </div>
</div></section>
{%- endpaginate -%}
<script>
  window.aaQuickAdd = window.aaQuickAdd || function(btn){
    var id = btn.getAttribute('data-vid'); if(!id) return;
    var original = btn.textContent;
    btn.disabled = true; btn.textContent = 'Adding…';
    fetch('/cart/add.js', {
      method:'POST',
      headers:{'Content-Type':'application/json','Accept':'application/json'},
      body: JSON.stringify({ items:[{ id: id, quantity: 1 }] })
    }).then(function(r){ return r.json(); }).then(function(){
      btn.textContent = 'Added ✓';
      setTimeout(function(){ btn.textContent = original; btn.disabled = false; }, 1600);
    }).catch(function(){
      btn.textContent = 'Try again'; btn.disabled = false;
      setTimeout(function(){ btn.textContent = original; }, 1600);
    });
  };
</script>
{% schema %}
{ "name": "Art Avenue Collection", "settings": [] }
{% endschema %}
