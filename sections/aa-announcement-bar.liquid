{%- comment -%} Art Avenue — announcement bar (parts.jsx AnnounceBar) {%- endcomment -%}
<div class="aa-announce">
  <div class="aa-announce__inner">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <span class="aa-announce__item" {{ block.shopify_attributes }}>
          {%- unless forloop.first -%}<span style="opacity:.4">·</span>{%- endunless -%}
          {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" style="color:inherit;text-decoration:none">{{ block.settings.text }}</a>{%- else -%}{{ block.settings.text }}{%- endif -%}
        </span>
      {%- endfor -%}
    {%- else -%}
      <span class="aa-announce__item">Complimentary design consultation</span>
      <span class="aa-announce__item"><span style="opacity:.4">·</span> Handcrafted in India</span>
      <span class="aa-announce__item"><span style="opacity:.4">·</span> International shipping available</span>
    {%- endif -%}
  </div>
</div>
{% schema %}
{
  "name": "AA Announcement",
  "blocks": [
    { "type": "message", "name": "Message", "settings": [
      { "type": "text", "id": "text", "label": "Text", "default": "Complimentary design consultation" },
      { "type": "url", "id": "link", "label": "Link" }
    ]}
  ],
  "presets": [{ "name": "AA Announcement", "blocks": [
    { "type": "message", "settings": { "text": "Complimentary design consultation" } },
    { "type": "message", "settings": { "text": "Handcrafted in India" } },
    { "type": "message", "settings": { "text": "International shipping available" } }
  ]}]
}
{% endschema %}
