<article class="aa-section"><div class="aa-wrap" style="max-width:760px">
  <span class="aa-eyebrow aa-eyebrow--rule">{{ article.tags.first | default: 'Journal' }}</span>
  <h1 class="aa-display-2" style="margin:16px 0 24px">{{ article.title }}</h1>
  {% if article.image %}<div class="aa-fig" style="aspect-ratio:16/9;margin-bottom:32px"><img src="{{ article.image | image_url: width:1400 }}" alt="{{ article.title }}"></div>{% endif %}
  <div class="rte" style="line-height:1.72;color:var(--text-secondary)">{{ article.content }}</div>
</div></article>
{% schema %}{ "name": "Article", "settings": [] }{% endschema %}
