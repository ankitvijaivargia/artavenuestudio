{%- comment -%}
  Art Avenue — main product section. A resolver + an ordered render of modules.
  Pipeline (last wins): preset defaults -> aa.* metafield overrides -> lifecycle composition.
  Preset defaults are inlined here (Liquid has no JSON-parse), mirroring presets.json.
{%- endcomment -%}
{%- assign p = product -%}

{%- comment -%} preset: explicit metafield, else by product type, else default {%- endcomment -%}
{%- assign preset = p.metafields.aav.preset -%}
{%- unless preset -%}
  {%- case p.type -%}
    {%- when 'Furniture' -%}{%- assign preset = 'luxury-furniture' -%}
    {%- when 'Rug' -%}{%- assign preset = 'luxury-rug' -%}
    {%- when 'Cushion' -%}{%- assign preset = 'luxury-cushion' -%}
    {%- when 'Lighting' -%}{%- assign preset = 'in-stock-product' -%}
    {%- when 'Decor' -%}{%- assign preset = 'in-stock-product' -%}
    {%- else -%}{%- assign preset = 'made-to-order-product' -%}
  {%- endcase -%}
{%- endunless -%}

{%- comment -%} preset defaults (mirrors presets.json): d_* scalars, d_order list, d_mods list of enabled keys {%- endcomment -%}
{%- assign d_fulfillment = 'made-to-order' -%}{%- assign d_visibility = 'ecommerce' -%}{%- assign d_size_mode = 'single' -%}{%- assign d_cta = '' -%}
{%- case preset -%}
  {%- when 'luxury-furniture' -%}
    {%- assign d_size_mode = 'multi' -%}
    {%- assign d_order = 'assembly,whyLove,customization,completeRoom,faq,related' | split: ',' -%}
    {%- assign d_mods = 'material,finish,upholstery,samples,customization,assembly,completeRoom,faq,related,delivery' | split: ',' -%}
  {%- when 'luxury-rug' -%}
    {%- assign d_size_mode = 'multi' -%}
    {%- assign d_order = 'whyLove,customization,guides,specs,construction,material,craft,rooms,consult,related' | split: ',' -%}
    {%- assign d_mods = 'guides,specs,construction,material,craft,rooms,related,samples' | split: ',' -%}
  {%- when 'luxury-cushion' -%}
    {%- assign d_order = 'whyLove,customization,pairs' | split: ',' -%}
    {%- assign d_mods = 'samples,whyLove,customization,pairs' | split: ',' -%}
  {%- when 'custom-product' -%}
    {%- assign d_fulfillment = 'custom' -%}{%- assign d_visibility = 'price-on-request' -%}{%- assign d_size_mode = 'custom' -%}{%- assign d_cta = 'request-pricing' -%}
    {%- assign d_order = 'whyLove,customization,faq' | split: ',' -%}
    {%- assign d_mods = 'customization,samples,faq' | split: ',' -%}
  {%- when 'project-product' -%}
    {%- assign d_fulfillment = 'project' -%}{%- assign d_visibility = 'project-only' -%}{%- assign d_size_mode = 'mto' -%}{%- assign d_cta = 'project-enquiry' -%}
    {%- assign d_order = 'whyLove,customization,faq' | split: ',' -%}
    {%- assign d_mods = 'customization,faq' | split: ',' -%}
  {%- when 'in-stock-product' -%}
    {%- assign d_fulfillment = 'in-stock' -%}{%- assign d_cta = 'add-to-cart' -%}
    {%- assign d_order = 'whyLove,completeRoom,faq,related' | split: ',' -%}
    {%- assign d_mods = 'completeRoom,faq,related,delivery' | split: ',' -%}
  {%- else -%}
    {%- assign d_cta = 'add-to-cart' -%}
    {%- assign d_order = 'whyLove,completeRoom,faq,related' | split: ',' -%}
    {%- assign d_mods = 'completeRoom,faq,related,delivery' | split: ',' -%}
{%- endcase -%}

{%- assign fulfillment = p.metafields.aav.fulfillment | default: d_fulfillment -%}
{%- assign visibility  = p.metafields.aav.visibility  | default: d_visibility -%}
{%- assign lifecycle   = p.metafields.aav.lifecycle   | default: 'active' -%}
{%- assign size_mode   = p.metafields.aav.size_mode   | default: d_size_mode -%}

{%- comment -%} visibility -> price / cart / default CTAs {%- endcomment -%}
{%- assign show_price = true -%}{%- assign show_cart = true -%}{%- assign primary = 'add-to-cart' -%}{%- assign secondary = 'consult' -%}
{%- case visibility -%}
  {%- when 'consultation' -%}{%- assign show_cart = false -%}{%- assign primary = 'consult' -%}{%- assign secondary = 'customize' -%}
  {%- when 'price-on-request' -%}{%- assign show_price = false -%}{%- assign show_cart = false -%}{%- assign primary = 'request-pricing' -%}{%- assign secondary = 'consult' -%}
  {%- when 'project-only' -%}{%- assign show_price = false -%}{%- assign show_cart = false -%}{%- assign primary = 'project-enquiry' -%}{%- assign secondary = 'consult' -%}
{%- endcase -%}

{%- comment -%} CTA overrides: explicit metafield > preset cta > visibility default {%- endcomment -%}
{%- if p.metafields.aav.cta_primary != blank -%}{%- assign primary = p.metafields.aav.cta_primary -%}{%- elsif d_cta != '' -%}{%- assign primary = d_cta -%}{%- endif -%}
{%- if p.metafields.aav.cta_secondary != blank -%}{%- assign secondary = p.metafields.aav.cta_secondary -%}{%- endif -%}

{%- comment -%} lifecycle composition: non-shopable removes cart + swaps CTA {%- endcomment -%}
{%- case lifecycle -%}
  {%- when 'coming-soon' -%}{%- assign show_cart = false -%}{%- assign primary = 'notify' -%}
  {%- when 'discontinued' -%}{%- assign show_cart = false -%}{%- assign primary = 'consult' -%}
  {%- when 'archive' -%}{%- assign show_cart = false -%}
{%- endcase -%}

{%- comment -%} resolve modules: metafield map wins, else preset enabled list {%- endcomment -%}
{%- assign mods_mf = p.metafields.aav.modules.value -%}
{%- assign order = p.metafields.aav.module_order.value | default: d_order -%}
{%- assign samples_on = false -%}{%- assign material_on = false -%}{%- assign finish_on = false -%}{%- assign uphol_on = false -%}{%- assign delivery_on = false -%}
{%- if mods_mf -%}
  {%- if mods_mf.samples -%}{%- assign samples_on = true -%}{%- endif -%}
  {%- if mods_mf.material -%}{%- assign material_on = true -%}{%- endif -%}
  {%- if mods_mf.finish -%}{%- assign finish_on = true -%}{%- endif -%}
  {%- if mods_mf.upholstery -%}{%- assign uphol_on = true -%}{%- endif -%}
  {%- if mods_mf.delivery -%}{%- assign delivery_on = true -%}{%- endif -%}
{%- else -%}
  {%- if d_mods contains 'samples' -%}{%- assign samples_on = true -%}{%- endif -%}
  {%- if d_mods contains 'material' -%}{%- assign material_on = true -%}{%- endif -%}
  {%- if d_mods contains 'finish' -%}{%- assign finish_on = true -%}{%- endif -%}
  {%- if d_mods contains 'upholstery' -%}{%- assign uphol_on = true -%}{%- endif -%}
  {%- if d_mods contains 'delivery' -%}{%- assign delivery_on = true -%}{%- endif -%}
{%- endif -%}
{%- assign ful = '' -%}{%- case fulfillment -%}{%- when 'in-stock' -%}{%- assign ful_lbl='In Stock' -%}{%- assign ful_icon='ph-package' -%}{%- assign ful_lead='Ships in 3–5 days' -%}{%- assign price_cap='In stock · ready to ship' -%}{%- when 'custom' -%}{%- assign ful_lbl='Custom Order' -%}{%- assign ful_icon='ph-pencil-ruler' -%}{%- assign ful_lead='Timeline at consultation' -%}{%- assign price_cap='Made to your specification' -%}{%- when 'project' -%}{%- assign ful_lbl='Project Enquiry' -%}{%- assign ful_icon='ph-buildings' -%}{%- assign ful_lead='To your project schedule' -%}{%- assign price_cap='Quoted per project' -%}{%- else -%}{%- assign ful_lbl='Made to Order' -%}{%- assign ful_icon='ph-hammer' -%}{%- assign ful_lead='Crafted in 3–4 weeks' -%}{%- assign price_cap='Made to order · crafted for your home' -%}{%- endcase -%}
{%- if show_price -%}{%- capture price_text -%}{% render 'aa-money', cents: p.price %}{%- endcapture -%}{%- elsif visibility == 'project-only' -%}{%- assign price_text = 'Project pricing' -%}{%- else -%}{%- assign price_text = 'Price on request' -%}{%- endif -%}

<section class="aa-product" data-preset="{{ preset }}" data-fulfillment="{{ fulfillment }}" data-visibility="{{ visibility }}" data-lifecycle="{{ lifecycle }}">

  <div class="aa-product__head">
    {%- if p.type != blank -%}<div class="aa-product__eyebrow" style="font-size:11px;letter-spacing:var(--tracking-eyebrow);text-transform:uppercase;color:var(--text-accent)">{{ p.type }}</div>{%- endif -%}
    <h1 class="serif aa-product__title" style="font-size:clamp(28px,7vw,40px);line-height:1.1;letter-spacing:var(--tracking-tight);margin:10px 0 0">{{ p.title }}</h1>
    {% render 'aa-price', product: p, show_price: show_price, visibility: visibility, caption: price_cap %}
  </div>

  <div class="aa-gallery">
    {%- if p.images.size > 0 -%}
      <div class="aa-gallery__main" id="aaGalMain">
        {%- for img in p.images -%}
          <div class="aa-fig aa-gallery__slide" data-idx="{{ forloop.index0 }}" style="aspect-ratio:3/4;position:relative"><img src="{{ img | image_url: width: 1400 }}" alt="{{ p.title | escape }}"{% unless forloop.first %} loading="lazy"{% endunless %}>{%- if forloop.first -%}<span style="position:absolute;top:18px;left:18px"><span class="aa-badge aa-badge--on-image">Handcrafted in India</span></span>{%- endif -%}</div>
        {%- endfor -%}
      </div>
      {%- if p.images.size > 1 -%}
      <div class="aa-gallery__thumbs" id="aaGalThumbs">
        {%- for img in p.images -%}
          <button type="button" class="aa-gallery__thumb{% if forloop.first %} is-active{% endif %}" data-idx="{{ forloop.index0 }}" aria-label="View image {{ forloop.index }}"><img src="{{ img | image_url: width: 160 }}" alt="" loading="lazy"></button>
        {%- endfor -%}
      </div>
      {%- endif -%}
    {%- else -%}
      <div class="aa-fig aa-fig--clay" style="aspect-ratio:4/5;position:relative"><span class="aa-fig__label">Styled in your home</span><span style="position:absolute;top:18px;left:18px"><span class="aa-badge aa-badge--on-image">Handcrafted in India</span></span></div>
      <div class="grid-2">{% render 'aa-figure', tone: 'espresso', ratio: '1/1', label: 'Joinery detail' %}{% render 'aa-figure', tone: 'bronze', ratio: '1/1', label: 'Linen &amp; grain' %}</div>
      {% render 'aa-figure', tone: 'stone', ratio: '16/10', label: 'Styled at home' %}
    {%- endif -%}
  </div>

  <div class="aa-buybox">
    {%- if p.type != blank -%}<div class="aa-buybox__eyebrow" style="font-size:11px;letter-spacing:var(--tracking-eyebrow);text-transform:uppercase;color:var(--text-accent)">{{ p.type }}</div>{%- endif -%}
    <h1 class="serif aa-buybox__title" style="font-size:clamp(34px,3.4vw,46px);line-height:1.08;letter-spacing:var(--tracking-tight);margin:12px 0 0">{{ p.title }}</h1>
    <div class="aa-buybox__price">{% render 'aa-price', product: p, show_price: show_price, visibility: visibility, caption: price_cap %}</div>
    {%- if p.description != blank -%}<div class="rte" style="font-size:var(--text-body);line-height:1.72;color:var(--text-secondary);margin-top:18px;max-width:46ch">{{ p.description }}</div>{%- endif -%}

    {% render 'aa-fulfillment-bar', type: fulfillment %}
    {% render 'aa-lifecycle-banner', state: lifecycle %}
    {% render 'aa-trust' %}
    {% render 'aa-size', mode: size_mode, product: p %}
    {% render 'aa-options', product: p, show_material: material_on, show_finish: finish_on, show_upholstery: uphol_on %}
    {%- if samples_on -%}{% render 'aa-sample-request', product: p %}{%- endif -%}
    {% render 'aa-cta', product: p, primary: primary, secondary: secondary, show_cart: show_cart %}

    {%- if delivery_on -%}
    <div class="aa-delivery">
      <div><i class="ph-light {{ ful_icon }}"></i><div style="line-height:1.3"><div style="font-size:14px;color:var(--text-primary)">{{ ful_lbl }}</div><div style="font-size:11.5px;color:var(--text-muted)">Fulfillment</div></div></div>
      <div><i class="ph-light ph-clock"></i><div style="line-height:1.3"><div style="font-size:14px;color:var(--text-primary)">{{ ful_lead }}</div><div style="font-size:11.5px;color:var(--text-muted)">Lead time</div></div></div>
      <div><i class="ph-light ph-truck"></i><div style="line-height:1.3"><div style="font-size:14px;color:var(--text-primary)">Insured delivery</div><div style="font-size:11.5px;color:var(--text-muted)">Secure &amp; tracked</div></div></div>
      <div><i class="ph-light ph-globe-hemisphere-east"></i><div style="line-height:1.3"><div style="font-size:14px;color:var(--text-primary)">Worldwide</div><div style="font-size:11.5px;color:var(--text-muted)">International shipping</div></div></div>
    </div>
    {%- endif -%}

    {% render 'aa-pdp-details', product: p %}
  </div>
</section>

{% render 'aa-sticky-bar', product: p, show_cart: show_cart, price_text: price_text %}

<script>
  (function(){
    var main=document.getElementById('aaGalMain'), thumbs=document.getElementById('aaGalThumbs');
    if(!main||!thumbs) return;
    var slides=main.querySelectorAll('.aa-gallery__slide');
    var tbs=thumbs.querySelectorAll('.aa-gallery__thumb');
    function setActive(i){ tbs.forEach(function(t,n){ t.classList.toggle('is-active', n===i); }); }
    thumbs.addEventListener('click', function(e){
      var b=e.target.closest('.aa-gallery__thumb'); if(!b) return;
      var i=+b.getAttribute('data-idx');
      if(slides[i]){ slides[i].scrollIntoView({behavior:'smooth',inline:'center',block:'nearest'}); setActive(i); }
    });
    var obs=new IntersectionObserver(function(entries){
      entries.forEach(function(en){ if(en.isIntersecting){ setActive(+en.target.getAttribute('data-idx')); } });
    },{root:main,threshold:0.6});
    slides.forEach(function(s){ obs.observe(s); });
  })();
</script>

{%- comment -%} Ordered section modules {%- endcomment -%}
{%- for key in order -%}
  {%- assign on = false -%}
  {%- if mods_mf -%}{%- if mods_mf[key] -%}{%- assign on = true -%}{%- endif -%}{%- elsif d_mods contains key -%}{%- assign on = true -%}{%- endif -%}
  {%- if on -%}{% render 'aa-module', key: key, product: p, fulfillment: fulfillment %}{%- endif -%}
{%- endfor -%}

{% schema %}
{ "name": "Art Avenue Product", "tag": "section", "class": "aa-product-section", "settings": [] }
{% endschema %}
