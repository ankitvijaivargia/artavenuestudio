{%- comment -%} Art Avenue — dark editorial CTA band (consultation / trade) {%- endcomment -%}
{%- assign s = section.settings -%}
<section class="aa-section {% if s.bg == 'dark' %}aa-surface-dark{% elsif s.bg == 'tint' %}aa-surface-tint{% else %}aa-surface-alt{% endif %}">
  <div class="aa-container aa-section-head--center">
    {%- if s.eyebrow != blank -%}<p class="aa-eyebrow {% if s.bg == 'dark' %}aa-eyebrow--on-dark{% endif %}">{{ s.eyebrow }}</p>{%- endif -%}
    <h2 class="aa-display-2" style="margin-top:14px{% if s.bg == 'dark' %};color:var(--text-on-dark){% endif %}">{{ s.heading }}</h2>
    {%- if s.body != blank -%}<p class="aa-lead" style="margin:16px auto 0{% if s.bg == 'dark' %};color:var(--text-on-dark-muted){% endif %}">{{ s.body }}</p>{%- endif -%}
    <div class="aa-hero__cta" style="justify-content:center;margin-top:var(--space-lg)">
      {%- if s.cta_label != blank -%}<a class="aa-btn aa-btn--primary aa-btn--lg" href="{{ s.cta_link }}">{{ s.cta_label }}</a>{%- endif -%}
      {%- if s.cta2_label != blank -%}<a class="aa-btn {% if s.bg == 'dark' %}aa-btn--on-dark{% else %}aa-btn--secondary{% endif %}" href="{{ s.cta2_link }}">{{ s.cta2_label }}</a>{%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "AA Editorial CTA",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Bespoke" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Made for your space." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "From a single commissioned piece to a complete interior — our atelier works to your brief." },
    { "type": "text", "id": "cta_label", "label": "Primary button", "default": "Speak with a consultant" },
    { "type": "url", "id": "cta_link", "label": "Primary link" },
    { "type": "text", "id": "cta2_label", "label": "Secondary button" },
    { "type": "url", "id": "cta2_link", "label": "Secondary link" },
    { "type": "select", "id": "bg", "label": "Background", "options": [ { "value": "dark", "label": "Dark" }, { "value": "tint", "label": "Bronze tint" }, { "value": "alt", "label": "Alt" } ], "default": "dark" }
  ],
  "presets": [{ "name": "AA Editorial CTA" }]
}
{% endschema %}
