<section class="aa-section"><div class="aa-wrap" style="max-width:480px">
  <span class="aa-eyebrow aa-eyebrow--rule">Account</span><h1 class="aa-h1" style="margin:16px 0 24px">Create account</h1>
  {% form 'create_customer' %}{{ form.errors | default_errors }}
    <div class="aa-form"><div class="grid-2"><div><label>First name</label><input name="customer[first_name]"></div><div><label>Last name</label><input name="customer[last_name]"></div></div><div><label>Email</label><input type="email" name="customer[email]" required></div><div><label>Password</label><input type="password" name="customer[password]" required></div><button class="btn btn--primary btn--block" type="submit">Create</button></div>
  {% endform %}
</div></section>
