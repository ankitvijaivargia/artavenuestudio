<section class="aa-section"><div class="aa-wrap" style="max-width:640px">
  <span class="aa-eyebrow aa-eyebrow--rule">Addresses</span><h1 class="aa-h1" style="margin:16px 0 24px">Your addresses</h1>
  {% for address in customer.addresses %}<div style="padding:14px 0;border-bottom:1px solid var(--border-hairline)">{{ address | format_address }}</div>{% endfor %}
  <p style="margin-top:24px"><a href="{{ routes.account_url }}" class="btn btn--secondary">Back to account</a></p>
</div></section>
