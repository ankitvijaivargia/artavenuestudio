<section class="aa-section" style="text-align:center;min-height:70vh;display:flex;align-items:center"><div class="aa-wrap" style="max-width:560px">
  <div class="aa-wordmark" style="margin-bottom:24px"><b style="font-size:32px">Art Avenue</b><small>Design House</small></div>
  <p class="aa-lead">{{ shop.password_message | default: 'Opening soon — a design house of handcrafted furniture, rugs and objects.' }}</p>
  {% form 'storefront_password' %}
    {{ form.errors | default_errors }}
    <div style="display:flex;gap:12px;max-width:420px;margin:24px auto 0"><input class="aa-control" type="password" name="password" placeholder="Enter password"><button class="btn btn--primary" type="submit">Enter</button></div>
  {% endform %}
</div></section>
