<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#FAF6EF">
  <link rel="canonical" href="{{ canonical_url }}">
  <title>{% if page_title %}{{ page_title }}{% else %}{{ shop.name }}{% endif %}{% if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif %}{% unless page_title contains shop.name %} &middot; {{ shop.name }}{% endunless %}</title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Jost:wght@300;400;500;600&display=swap">
  <link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/light/style.css">
  <link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/regular/style.css">
  <link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/bold/style.css">
  {{ 'aa.css' | asset_url | stylesheet_tag }}
  {{ 'aa-sofa-dims.css' | asset_url | stylesheet_tag }}
  {{ 'aa-czm-mobile.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body class="template-{{ request.page_type | handle }}">
  {% if settings.show_announcement %}{% render 'aa-announcement' %}{% endif %}
  {% render 'aa-header' %}
  <main id="MainContent" role="main">{{ content_for_layout }}</main>
  {% render 'aa-footer' %}
  <script>
    document.addEventListener('click', function (e) {
      var fav = e.target.closest('.aa-save, .aa-pcard__fav');
      if (fav) { e.preventDefault(); fav.classList.toggle('is-saved'); return; }
      var chip = e.target.closest('[data-aa-opt]');
      if (chip) {
        var row = chip.parentNode;
        row.querySelectorAll('[data-aa-opt]').forEach(function (x) { x.classList.remove('is-active'); });
        chip.classList.add('is-active');
        var lbl = row.parentNode.querySelector('[data-aa-optval]');
        if (lbl && chip.getAttribute('data-aa-label')) lbl.textContent = chip.getAttribute('data-aa-label');
        return;
      }
      var q = e.target.closest('[data-aa-qty]');
      if (q) {
        var inp = q.parentNode.querySelector('input');
        var v = parseInt(inp.value || '1', 10); v += (q.getAttribute('data-aa-qty') === '+' ? 1 : -1);
        inp.value = v < 1 ? 1 : v; return;
      }
    });
    var aaSticky = document.querySelector('[data-aa-sticky]');
    if (aaSticky) {
      window.addEventListener('scroll', function () {
        if (window.scrollY > 620) { aaSticky.classList.add('is-visible'); }
        else { aaSticky.classList.remove('is-visible'); }
      }, { passive: true });
    }
  </script>
</body>
</html>
